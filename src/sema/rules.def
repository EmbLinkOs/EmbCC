/* The coding-standard rules EmbCC checks (src/sema/rules.c): each is a
 * warning, named `misra-N.M` or `cert-XXXNN`, so --warn=, --no-warn=,
 * --error=, `#pragma GCC diagnostic` and system-header silence all apply
 * to it. `--misra` turns on every misra- one, `--cert` every cert- one.
 *
 *   RULE(NAME, STANDARD, ID, CATEGORY, TEXT)
 *     CATEGORY  mandatory, required or advisory (MISRA's), or the CERT
 *               rule's priority level
 *     TEXT      what the rule asks, as the reference prints it
 *
 * These are the rules decidable from one translation unit's code; the
 * ones that need the whole program or a proof (MISRA's directives,
 * 22.x's resources, CERT's run-time rules) are the static analyzer's
 * (item 14) or no compiler's. */

RULE("misra-2.2", "MISRA C:2023", "Rule 2.2", "required", "an expression statement with no effect (dead code)")
RULE("misra-2.6", "MISRA C:2023", "Rule 2.6", "advisory", "a label that no goto names")
RULE("misra-2.7", "MISRA C:2023", "Rule 2.7", "advisory", "a function parameter that is not used")
RULE("misra-7.1", "MISRA C:2023", "Rule 7.1", "required", "an octal constant other than 0")
RULE("misra-7.2", "MISRA C:2023", "Rule 7.2", "required", "an integer constant of unsigned type without a `u` or `U` suffix")
RULE("misra-7.3", "MISRA C:2023", "Rule 7.3", "required", "the lowercase `l` in an integer constant's suffix")
RULE("misra-7.4", "MISRA C:2023", "Rule 7.4", "required", "a string literal assigned to a pointer to non-const char")
RULE("misra-8.2", "MISRA C:2023", "Rule 8.2", "required", "a function declared or defined without a prototype with named parameters")
RULE("misra-8.10", "MISRA C:2023", "Rule 8.10", "required", "an inline function that is not static")
RULE("misra-8.11", "MISRA C:2023", "Rule 8.11", "advisory", "an extern array declared without its size")
RULE("misra-8.14", "MISRA C:2023", "Rule 8.14", "required", "the `restrict` qualifier")
RULE("misra-10.1", "MISRA C:2023", "Rule 10.1", "required", "an operand of an inappropriate essential type: Boolean in arithmetic, a signed operand of a bitwise or shift operator, unary minus of an unsigned one")
RULE("misra-10.3", "MISRA C:2023", "Rule 10.3", "required", "a value assigned to an object of a narrower essential type, or of another essential type category")
RULE("misra-10.4", "MISRA C:2023", "Rule 10.4", "required", "the operands of an arithmetic or comparison operator in different essential type categories (signed and unsigned)")
RULE("misra-10.6", "MISRA C:2023", "Rule 10.6", "required", "a composite expression assigned to an object of a wider essential type")
RULE("misra-10.8", "MISRA C:2023", "Rule 10.8", "required", "a composite expression cast to a wider essential type or another category")
RULE("misra-11.1", "MISRA C:2023", "Rule 11.1", "required", "a conversion between a pointer to a function and any other type")
RULE("misra-11.3", "MISRA C:2023", "Rule 11.3", "required", "a cast between pointers to different object types")
RULE("misra-11.4", "MISRA C:2023", "Rule 11.4", "advisory", "a conversion between a pointer and an integer")
RULE("misra-11.5", "MISRA C:2023", "Rule 11.5", "advisory", "a conversion from a pointer to void to a pointer to an object")
RULE("misra-11.6", "MISRA C:2023", "Rule 11.6", "required", "a cast between a pointer to void and an arithmetic type")
RULE("misra-11.7", "MISRA C:2023", "Rule 11.7", "required", "a cast between a pointer to an object and a non-integer arithmetic type")
RULE("misra-11.8", "MISRA C:2023", "Rule 11.8", "required", "a cast that removes const or volatile from what a pointer points to")
RULE("misra-11.9", "MISRA C:2023", "Rule 11.9", "required", "an integer 0 used as a null pointer constant (NULL is the only one)")
RULE("misra-12.1", "MISRA C:2023", "Rule 12.1", "advisory", "operators of different precedence mixed without parentheses")
RULE("misra-12.2", "MISRA C:2023", "Rule 12.2", "required", "a constant shift count outside 0 to one less than the operand's width")
RULE("misra-12.3", "MISRA C:2023", "Rule 12.3", "advisory", "the comma operator")
RULE("misra-13.3", "MISRA C:2023", "Rule 13.3", "advisory", "an increment or decrement in an expression with another side effect")
RULE("misra-13.4", "MISRA C:2023", "Rule 13.4", "advisory", "the result of an assignment used as a value")
RULE("misra-13.5", "MISRA C:2023", "Rule 13.5", "required", "a side effect in the right operand of && or ||")
RULE("misra-13.6", "MISRA C:2023", "Rule 13.6", "required", "a side effect in the operand of sizeof")
RULE("misra-14.1", "MISRA C:2023", "Rule 14.1", "required", "a loop counter of floating type")
RULE("misra-14.3", "MISRA C:2023", "Rule 14.3", "required", "a controlling expression that is invariant (other than an infinite loop's)")
RULE("misra-14.4", "MISRA C:2023", "Rule 14.4", "required", "a controlling expression that is not essentially Boolean")
RULE("misra-15.1", "MISRA C:2023", "Rule 15.1", "advisory", "the goto statement")
RULE("misra-15.2", "MISRA C:2023", "Rule 15.2", "required", "a goto that jumps backward")
RULE("misra-15.4", "MISRA C:2023", "Rule 15.4", "advisory", "more than one break or goto leaving the same loop")
RULE("misra-15.5", "MISRA C:2023", "Rule 15.5", "advisory", "a function with more than one point of exit, or one not at its end")
RULE("misra-15.6", "MISRA C:2023", "Rule 15.6", "required", "the body of an iteration or selection statement that is not a compound statement")
RULE("misra-15.7", "MISRA C:2023", "Rule 15.7", "required", "an if ... else if chain without a final else")
RULE("misra-16.3", "MISRA C:2023", "Rule 16.3", "required", "a switch clause that does not end with an unconditional break")
RULE("misra-16.4", "MISRA C:2023", "Rule 16.4", "required", "a switch statement without a default label")
RULE("misra-16.5", "MISRA C:2023", "Rule 16.5", "required", "a default label that is neither the first nor the last of its switch")
RULE("misra-16.6", "MISRA C:2023", "Rule 16.6", "required", "a switch statement with fewer than two clauses")
RULE("misra-16.7", "MISRA C:2023", "Rule 16.7", "required", "a switch on an essentially Boolean expression")
RULE("misra-17.1", "MISRA C:2023", "Rule 17.1", "required", "the features of <stdarg.h>")
RULE("misra-17.2", "MISRA C:2023", "Rule 17.2", "required", "a function that calls itself, directly or through others of this unit")
RULE("misra-17.7", "MISRA C:2023", "Rule 17.7", "required", "the value a non-void function returns, discarded without a cast to void")
RULE("misra-17.8", "MISRA C:2023", "Rule 17.8", "advisory", "a function parameter modified")
RULE("misra-18.4", "MISRA C:2023", "Rule 18.4", "advisory", "the +, -, += or -= operator applied to a pointer")
RULE("misra-18.5", "MISRA C:2023", "Rule 18.5", "advisory", "a declaration with more than two levels of pointer nesting")
RULE("misra-18.7", "MISRA C:2023", "Rule 18.7", "required", "a flexible array member")
RULE("misra-18.8", "MISRA C:2023", "Rule 18.8", "required", "a variable-length array")
RULE("misra-19.2", "MISRA C:2023", "Rule 19.2", "advisory", "the union keyword")
RULE("misra-21.3", "MISRA C:2023", "Rule 21.3", "required", "the memory allocation and deallocation functions of <stdlib.h>")
RULE("misra-21.4", "MISRA C:2023", "Rule 21.4", "required", "setjmp and longjmp")
RULE("misra-21.5", "MISRA C:2023", "Rule 21.5", "required", "the features of <signal.h>")
RULE("misra-21.6", "MISRA C:2023", "Rule 21.6", "required", "the standard input/output functions")
RULE("misra-21.7", "MISRA C:2023", "Rule 21.7", "required", "atof, atoi, atol and atoll")
RULE("misra-21.8", "MISRA C:2023", "Rule 21.8", "required", "the termination functions of <stdlib.h> (abort, exit, _Exit, quick_exit)")
RULE("misra-21.9", "MISRA C:2023", "Rule 21.9", "required", "bsearch and qsort")
RULE("misra-21.10", "MISRA C:2023", "Rule 21.10", "required", "the time and date functions of <time.h>")
RULE("misra-21.12", "MISRA C:2023", "Rule 21.12", "required", "the exception-handling features of <fenv.h>")
RULE("misra-21.21", "MISRA C:2023", "Rule 21.21", "required", "the system function")
RULE("misra-21.24", "MISRA C:2023", "Rule 21.24", "required", "the random number generator functions rand and srand")
RULE("cert-arr30", "CERT C", "ARR30-C", "high", "an array subscript a constant out of the array's bounds")
RULE("cert-dcl30", "CERT C", "DCL30-C", "high", "the address of an automatic object returned")
RULE("cert-dcl37", "CERT C", "DCL37-C", "low", "a declaration of a reserved identifier (_X..., __...)")
RULE("cert-env33", "CERT C", "ENV33-C", "high", "a call of system")
RULE("cert-err33", "CERT C", "ERR33-C", "high", "the result of a function that reports errors by it (malloc, fopen, ...) ignored")
RULE("cert-exp30", "CERT C", "EXP30-C", "medium", "an object modified twice, or modified and read, without a sequence point between")
RULE("cert-exp42", "CERT C", "EXP42-C", "medium", "memcmp of structures, which compares their padding")
RULE("cert-exp46", "CERT C", "EXP46-C", "low", "a bitwise operator with a Boolean-like operand")
RULE("cert-flp30", "CERT C", "FLP30-C", "low", "a floating-point loop counter")
RULE("cert-mem30", "CERT C", "MEM30-C", "high", "a pointer used after it was passed to free")
RULE("cert-mem34", "CERT C", "MEM34-C", "high", "free of memory that was not allocated (a local or a global)")
RULE("cert-msc24", "CERT C", "MSC24-C", "low", "a deprecated or obsolescent function (gets, atoi, setbuf, rewind, asctime, ...)")
RULE("cert-msc30", "CERT C", "MSC30-C", "medium", "rand, which is not good enough for anything that matters")
RULE("cert-str30", "CERT C", "STR30-C", "low", "a string literal assigned to a pointer through which it may be modified")
RULE("cert-str31", "CERT C", "STR31-C", "high", "gets, which cannot be told the size of its buffer")
