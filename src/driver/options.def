/* EmbCC's command line: every option, once.
 *
 * This table is the one place an option is described. `embcc --help`
 * prints it, `embcc --help=gcc` prints the GCC spellings, the option
 * reference in the documentation is generated from it (`embcc
 * --reference=options`), and tests/golden/options-table.sh fails when the
 * driver accepts a spelling this table does not name.
 *
 * EmbCC's own vocabulary leads (docs/internals/identity.md): POSIX's c99
 * letters (-c -o -E -I -D -U -L -l -g -O), EmbCC's long options, and
 * words rather than abbreviations. GCC's spelling of the same thing is
 * an alias, so a build written for GCC keeps working; it is not how
 * EmbCC names anything.
 *
 *   OPT(GROUP, SPELLING, ARG, GCC, HELP)
 *     SPELLING  EmbCC's. One ending in '=' takes a value (ARG names it);
 *               the value may also follow as the next argument.
 *     GCC       the other spelling the driver's argument loop reads --
 *               GCC's, or EmbCC's own older GCC-style one -- or NULL. A native spelling is
 *               rewritten into it before the loop runs (options.c): '%'
 *               is the value, and a space separates two arguments
 *               ("-MMD -MF %"). With no GCC spelling the loop reads
 *               SPELLING itself.
 *     HELP      one line, for --help and the reference.
 *
 *   GCCONLY(GROUP, SPELLING, HELP)
 *     A GCC spelling with no EmbCC name: a GCC flag EmbCC accepts
 *     because it changes nothing here, or one it reads in order to
 *     refuse it by name (the manual says which). SPELLING ending in '*'
 *     is a family ("-fsanitize*").
 *
 * The -m options each target answers itself (src/arch/<target>/
 * options.c) are GCC's per-target vocabulary and are listed there.
 */

/* ---- what to build -------------------------------------------------- */
OPT(BUILD, "-c",            NULL,   NULL,   "compile to an object; do not link")
OPT(BUILD, "-S",            NULL,   NULL,   "write assembly (NAME.s) instead of an object")
OPT(BUILD, "-E",            NULL,   NULL,   "preprocess only, to standard output")
OPT(BUILD, "-o",            "FILE", NULL,   "where to write the result")
OPT(BUILD, "-j",            "N",    NULL,   "compile N sources at once (-j alone: one per processor)")
OPT(BUILD, "--syntax-only", NULL,   "-fsyntax-only", "check the source; write nothing")
OPT(BUILD, "--lang=",       "LANG", "-x%",  "read the inputs as c, c++, assembler or assembler-with-cpp")
OPT(BUILD, "--keep-temps",  NULL,   "-save-temps", "keep the preprocessed source and the assembly")
OPT(BUILD, "--keep-temps=", "WHERE","-save-temps=%", "...beside the object (obj) or in the current directory (cwd)")
OPT(BUILD, "--emit-c",      NULL,   NULL,   "print the C a C++ unit lowers to")
OPT(BUILD, "--emit-interfaces", NULL, NULL, "write the unit's interface record instead of an object")
OPT(BUILD, "--emit-empty-object", "FILE", NULL, "write an empty object for this target (it must come first)")

/* ---- the language ---------------------------------------------------- */
OPT(LANG, "--std=",         "STD",  "-std=%", "the language standard's macros (EmbCC reads one dialect per language)")
OPT(LANG, "-D",             "NAME[=VALUE]", NULL, "define a macro")
OPT(LANG, "-U",             "NAME", NULL,   "undefine a macro")
OPT(LANG, "-I",             "DIR",  NULL,   "search DIR for headers")
OPT(LANG, "--system-include=", "DIR", "-isystem %", "search DIR for headers, as a system directory")
OPT(LANG, "--include=",     "FILE", "-include %", "include FILE before the source")
OPT(LANG, "--no-std-include", NULL, "-nostdinc", "do not search EmbCC's own headers")
OPT(LANG, "--freestanding", NULL,   "-ffreestanding", "accepted: EmbCC makes no hosted assumptions to turn off")
OPT(LANG, "--no-builtins",  NULL,   "-fno-builtin", "accepted: only the __builtin_ names are built-ins")
OPT(LANG, "--no-builtin=",  "NAME", "-fno-builtin-%", "accepted, for the same reason")
OPT(LANG, "--char=signed",  NULL,   "-fsigned-char", "plain char is signed")
OPT(LANG, "--char=unsigned", NULL,  "-funsigned-char", "plain char is unsigned")
OPT(LANG, "--wchar=short",  NULL,   "-fshort-wchar", "wchar_t is 16 bits")
OPT(LANG, "--wchar=int",    NULL,   "-fno-short-wchar", "wchar_t is the target's default")
OPT(LANG, "--enums=short",  NULL,   "-fshort-enums", "an enum is the smallest type its values fit")
OPT(LANG, "--enums=int",    NULL,   "-fno-short-enums", "an enum is int-sized")
OPT(LANG, "--enums=neutral", NULL,  "-fenum-size-neutral", "objects that link with either enum size (for libraries)")
OPT(LANG, "--wrap-overflow", NULL,  "-fwrapv", "signed overflow wraps (EmbCC's default; stated)")
OPT(LANG, "--common",       NULL,   "-fcommon", "tentative definitions are COMMON symbols (C, ELF)")
OPT(LANG, "--no-common",    NULL,   "-fno-common", "tentative definitions are definitions")
OPT(LANG, "--float-constants=single", NULL, "-fsingle-precision-constant", "an unsuffixed 1.0 is a float (C)")
OPT(LANG, "--float-constants=double", NULL, "-fno-single-precision-constant", "an unsuffixed 1.0 is a double")
OPT(LANG, "--exceptions",   NULL,   "-fexceptions", "C++ exceptions (the default)")
OPT(LANG, "--no-exceptions", NULL,  "-fno-exceptions", "C++ without exceptions")
OPT(LANG, "--rtti",         NULL,   "-frtti", "C++ run-time type information (the default)")
OPT(LANG, "--no-rtti",      NULL,   "-fno-rtti", "C++ without run-time type information")
OPT(LANG, "--access-control", NULL, "-faccess-control", "enforce private and protected (the default)")
OPT(LANG, "--no-access-control", NULL, "-fno-access-control", "do not enforce private and protected")
OPT(LANG, "--char8",        NULL,   "-fchar8_t", "C++: define __cpp_char8_t before C++20")
OPT(LANG, "--strict-aliasing", NULL, "-fstrict-aliasing", "accepted; EmbCC does not optimize by type-based aliasing")
OPT(LANG, "--no-strict-aliasing", NULL, "-fno-strict-aliasing", "accepted; nothing to turn off")

/* ---- the target ------------------------------------------------------ */
OPT(TARGET, "--target=",    "TARGET", NULL, "what to compile for (an unknown name lists them all)")
OPT(TARGET, "--cpu=",       "CPU",  "-mcpu=%", "the processor: cortex-m4, cortex-m0plus, ...")
OPT(TARGET, "--fpu=",       "FPU",  "-mfpu=%", "the floating-point unit: fpv4-sp-d16, fpv5-d16, ...")
OPT(TARGET, "--float-abi=", "ABI",  "-mfloat-abi=%", "soft, softfp or hard")
OPT(TARGET, "--mcu=",       "PART", "-mmcu=%", "the AVR part: atmega328p, ...")
OPT(TARGET, "--isa=thumb",  NULL,   "-mthumb", "Thumb instructions (ARM)")
OPT(TARGET, "--isa=arm",    NULL,   "-marm", "ARM (A32) instructions")
OPT(TARGET, "--isa=",       "ISA",  "-march=%", "the instruction set: rv32imac, rv64gc, armv7-a, mips32r2, isaa ...")
OPT(TARGET, "--tune=",      "CPU",  "-mtune=%", "the core to schedule for (ARM): accepted, EmbCC does not schedule")
OPT(TARGET, "--abi=",       "ABI",  "-mabi=%", "the calling convention: ilp32, ilp32f, lp64d, 32 ...")
OPT(TARGET, "--cmse",       NULL,   "-mcmse", "Armv8-M Security Extension entry points")
OPT(TARGET, "--endian=little", NULL, "-mlittle-endian", "little-endian")
OPT(TARGET, "--endian=big", NULL,   "-mbig-endian", "big-endian")
OPT(TARGET, "--unaligned-access", NULL, "-munaligned-access", "the core takes unaligned loads and stores")
OPT(TARGET, "--no-unaligned-access", NULL, "-mno-unaligned-access", "it does not")
OPT(TARGET, "--no-sse",     NULL,   "-mno-sse", "x86-64: no SSE (kernels)")
OPT(TARGET, "--no-red-zone", NULL,  "-mno-red-zone", "x86-64: no red zone (kernels)")
OPT(TARGET, "--general-regs-only", NULL, "-mgeneral-regs-only", "AArch64: no floating-point or SIMD registers")
OPT(TARGET, "--code-model=", "MODEL", "-mcmodel=%", "x86-64: small or kernel")
OPT(TARGET, "--macos-min=", "VERSION", "-mmacos-version-min=%", "the oldest macOS the program runs on")
OPT(TARGET, "--print-target", NULL, "-dumpmachine", "print the target's name and stop")

/* ---- optimization ---------------------------------------------------- */
OPT(OPT, "-O",              "LEVEL", NULL,  "0, 1, 2, 3, s, z or g: none, basic, speed, max, size, min-size or debug")
OPT(OPT, "--opt=none",      NULL,   "-O0", "no optimization: each statement as written")
OPT(OPT, "--opt=basic",     NULL,   "-O1", "the passes that only remove work: never larger code")
OPT(OPT, "--opt=debug",     NULL,   "-Og", "--opt=basic, with every variable kept where a debugger reads it")
OPT(OPT, "--opt=speed",     NULL,   "-O2", "fast code: --opt=basic and the passes that trade size for speed")
OPT(OPT, "--opt=max",       NULL,   "-O3", "the same as --opt=speed")
OPT(OPT, "--opt=size",      NULL,   "-Os", "small code: no transform that grows it")
OPT(OPT, "--opt=min-size",  NULL,   "-Oz", "the same as --opt=size")
OPT(OPT, "--pass=",         "NAME", "-f%", "turn one optimizer pass on")
OPT(OPT, "--no-pass=",      "NAME", "-fno-%", "turn one optimizer pass off")
OPT(OPT, "--sections=functions", NULL, "-ffunction-sections", "each function in its own section, for the linker to drop")
OPT(OPT, "--sections=data", NULL,   "-fdata-sections", "each object in its own section")
OPT(OPT, "--sections=functions,data", NULL, "-ffunction-sections -fdata-sections", "both")
OPT(OPT, "--sections=data,functions", NULL, "-ffunction-sections -fdata-sections", "both")
OPT(OPT, "--inline=declared", NULL, "-fno-inline-functions", "inline only what is declared inline")
OPT(OPT, "--inline=auto",   NULL,   "-finline-functions", "inline what pays (the default from -O2)")
OPT(OPT, "--unroll",        NULL,   "-funroll-loops", "unroll loops")
OPT(OPT, "--no-unroll",     NULL,   "-fno-unroll-loops", "do not")
OPT(OPT, "--jump-tables",   NULL,   "-fjump-tables", "a dense switch may be a table (the default)")
OPT(OPT, "--no-jump-tables", NULL,  "-fno-jump-tables", "no switch through a table of addresses")
OPT(OPT, "--frame-pointer", NULL,   "-fno-omit-frame-pointer", "keep a frame pointer in every function")
OPT(OPT, "--no-frame-pointer", NULL, "-fomit-frame-pointer", "only where one is needed")
OPT(OPT, "--fp-contract=",  "MODE", "-ffp-contract=%", "off, on or fast: may a*b+c become one fused operation")
OPT(OPT, "--fast-math",     NULL,   "-ffast-math", "floating point without IEEE's exceptions and signed zeros")
OPT(OPT, "--no-math-errno", NULL,   "-fno-math-errno", "the math functions need not set errno")
OPT(OPT, "--unwind-tables", NULL,   "-funwind-tables", "unwind tables for every function")
OPT(OPT, "--no-unwind-tables", NULL, "-fno-unwind-tables", "none where not needed")
OPT(OPT, "--instrument-functions", NULL, "-finstrument-functions", "call the profiling hooks at every entry and exit")
OPT(OPT, "--no-instrument-functions", NULL, "-fno-instrument-functions", "do not")
OPT(OPT, "--instrument-exclude-files=", "LIST", "-finstrument-functions-exclude-file-list=%", "...except in these files (comma-separated)")
OPT(OPT, "--instrument-exclude-functions=", "LIST", "-finstrument-functions-exclude-function-list=%", "...except these functions")

/* ---- warnings and diagnostics ---------------------------------------- */
OPT(DIAG, "--warn=all",     NULL,   "-Wall", "the warnings most code wants")
OPT(DIAG, "--warn=extra",   NULL,   "-Wextra", "...and the stricter ones")
OPT(DIAG, "--warn=",        "NAME", "-W%", "this warning (--help-warnings lists them)")
OPT(DIAG, "--no-warn=",     "NAME", "-Wno-%", "not this warning")
OPT(DIAG, "--warnings-are-errors", NULL, "-Werror", "every warning is an error")
OPT(DIAG, "--no-warnings-are-errors", NULL, "-Wno-error", "they are not")
OPT(DIAG, "--error=",       "NAME", "-Werror=%", "this warning is an error")
OPT(DIAG, "--no-error=",    "NAME", "-Wno-error=%", "this one is a warning again")
OPT(DIAG, "--no-warnings",  NULL,   "-w", "no warnings at all")
OPT(DIAG, "--pedantic",     NULL,   "-pedantic", "warn for every extension of ISO C")
OPT(DIAG, "--pedantic-errors", NULL, "-pedantic-errors", "...as errors")
OPT(DIAG, "--warn-in-system-headers", NULL, "-Wsystem-headers", "warn in system headers too")
OPT(DIAG, "--diagnostics=", "FORMAT", "-fdiagnostics-format=%", "text, or json for tools")
OPT(DIAG, "--color=",       "WHEN", "-fdiagnostics-color=%", "auto, always or never")
OPT(DIAG, "--max-errors=",  "N",    "-fmax-errors=%", "stop after N errors")
OPT(DIAG, "--explain=",     "ID",   NULL,   "what a diagnostic means, and the fix")
OPT(DIAG, "--fix",          NULL,   NULL,   "apply the fix-its EmbCC proposes")
OPT(DIAG, "--remarks",      NULL,   "-fremarks", "say what the optimizer did and did not do")
OPT(DIAG, "--remarks=json", NULL,   "-fremarks=json", "...as JSON")

/* ---- debugging and reports ------------------------------------------- */
OPT(DEBUG, "-g",            NULL,   NULL,   "debug information (DWARF)")
OPT(DEBUG, "--debug",       NULL,   "-g", "the same")
OPT(DEBUG, "--stack-usage", NULL,   "-fstack-usage", "write FILE.su: each function's frame")
OPT(DEBUG, "--call-graph",  NULL,   "-fcallgraph-info", "write FILE.ci: the call graph")
OPT(DEBUG, "--call-graph=su", NULL, "-fcallgraph-info=su", "...with each function's stack")
OPT(DEBUG, "--time-report", NULL,   "-ftime-report", "how long each phase took")
OPT(DEBUG, "--sanitize=",   "LIST", "-fsanitize=%", "checks that trap on undefined behaviour: undefined, ...")
OPT(DEBUG, "--no-sanitize=", "LIST", "-fno-sanitize=%", "not these checks")

/* ---- dependencies ---------------------------------------------------- */
OPT(DEPS, "--deps=",        "FILE", "-MMD -MF %", "write the make rule for the user headers to FILE, and compile")
OPT(DEPS, "--deps-all=",    "FILE", "-MD -MF %", "...system headers included")
OPT(DEPS, "--deps-only",    NULL,   "-MM", "write the make rule instead of compiling")
OPT(DEPS, "--deps-target=", "TARGET", "-MT %", "the rule's target")
OPT(DEPS, "--deps-phony",   NULL,   "-MP", "a phony rule for each header")

/* ---- linking --------------------------------------------------------- */
OPT(LINK, "-l",             "NAME", NULL,   "link libNAME.a")
OPT(LINK, "-L",             "DIR",  NULL,   "search DIR for libraries")
OPT(LINK, "--link-script=", "FILE", "-T %", "the linker script (a GNU ld script)")
OPT(LINK, "--entry=",       "SYMBOL", "-e %", "the entry symbol")
OPT(LINK, "--undefined=",   "SYMBOL", "-u %", "pull SYMBOL from the archives")
OPT(LINK, "--no-stdlib",    NULL,   "-nostdlib", "no start files, no C library, no runtime")
OPT(LINK, "--no-start-files", NULL, "-nostartfiles", "no start files")
OPT(LINK, "--no-default-libs", NULL, "-nodefaultlibs", "no C library, no runtime")
OPT(LINK, "--static",       NULL,   "-static", "a static program")
OPT(LINK, "--linker-arg=",  "ARG",  "-Xlinker %", "pass ARG to EmbLD")
OPT(LINK, "--assembler-arg=", "ARG", "-Wa,%", "pass ARG to the assembler")

/* ---- asking EmbCC ---------------------------------------------------- */
OPT(INFO, "--help",         NULL,   NULL,   "this list")
OPT(INFO, "--help=gcc",     NULL,   NULL,   "the other spellings EmbCC accepts: GCC's, and EmbCC's for each")
OPT(INFO, "--reference=",   "PAGE", NULL,   "a reference page: options, warnings or targets in Markdown, or the man page")
OPT(INFO, "--help=spellings", NULL, NULL,   "every spelling, one per line (for tests and tools)")
OPT(INFO, "--help-warnings", NULL,  NULL,   "every warning, and the sets")
OPT(INFO, "--version",      NULL,   NULL,   "the version and the default target")
OPT(INFO, "--dump-predef",  NULL,   NULL,   "the predefined macros for this target")
OPT(INFO, "--print-search-dirs", NULL, NULL, "where EmbCC found its own files")

/* ---- GCC's spellings with no EmbCC name ------------------------------ */
GCCONLY(BUILD, "-x",        "the language, as a separate argument (--lang=)")
GCCONLY(BUILD, "-pipe",     "accepted: EmbCC writes no temporary files")
GCCONLY(BUILD, "-dumpbase", "accepted with -save-temps")
GCCONLY(BUILD, "-specs=*",  "a GCC specs file")
GCCONLY(BUILD, "--specs=*", "a GCC specs file")
GCCONLY(BUILD, "-fdump-*",  "GCC's internal dumps")
GCCONLY(BUILD, "-fverbose-asm", "accepted")
GCCONLY(BUILD, "-h",        "--help")
GCCONLY(BUILD, "--explain", "--explain=, with the ID as the next argument")
GCCONLY(BUILD, "--save-temps", "--keep-temps")
GCCONLY(LANG, "-dM",        "with -E: print the macros")
GCCONLY(LANG, "-isysroot",  "macOS: the SDK's root")
GCCONLY(LANG, "-framework", "macOS: link a framework")
GCCONLY(LANG, "-arch",      "macOS: the architecture")
GCCONLY(LANG, "-fgnu89-inline", "GNU89's meaning of inline")
GCCONLY(LANG, "-fno-gnu89-inline", "C99's meaning of inline")
GCCONLY(LANG, "-fgnuc-version=*", "the __GNUC__ to claim")
GCCONLY(LANG, "-fno-zero-initialized-in-bss", "zero-initialized objects in .data")
GCCONLY(LANG, "-fzero-initialized-in-bss", "the default")
GCCONLY(LANG, "-fstrict-volatile-bitfields", "volatile bit-fields by their declared type's width")
GCCONLY(LANG, "-fno-strict-volatile-bitfields", "the default")
GCCONLY(TARGET, "-mthumb-interwork", "accepted: every target EmbCC has interworks")
GCCONLY(TARGET, "-mno-thumb-interwork", "accepted")
GCCONLY(TARGET, "-mslow-flash-data", "accepted")
GCCONLY(TARGET, "-mno-sse2", "x86-64")
GCCONLY(TARGET, "-mno-mmx", "x86-64")
GCCONLY(TARGET, "-mno-80387", "x86-64")
GCCONLY(TARGET, "-mmacosx-version-min=*", "--macos-min=")
GCCONLY(TARGET, "-fno-pic", "accepted: firmware is not position-independent")
GCCONLY(TARGET, "-fno-PIC", "accepted")
GCCONLY(TARGET, "-fno-pie", "accepted")
GCCONLY(TARGET, "-fno-PIE", "accepted")
GCCONLY(TARGET, "-fpic",    "position-independent code")
