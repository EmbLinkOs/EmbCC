GCCONLY(TARGET, "-fno-plt", "accepted")
GCCONLY(TARGET, "-shared",  "a shared library")
GCCONLY(TARGET, "-static-pie", "a static position-independent executable")
GCCONLY(TARGET, "-pthread", "accepted")
GCCONLY(OPT, "-fno-ident",  "accepted")
GCCONLY(OPT, "-fident",     "accepted")
GCCONLY(OPT, "-fno-reorder-functions", "accepted")
GCCONLY(OPT, "-freorder-functions", "accepted")
GCCONLY(OPT, "-funroll-all-loops", "--unroll")
GCCONLY(OPT, "-finline-small-functions", "accepted")
GCCONLY(OPT, "-fno-inline-small-functions", "accepted")
GCCONLY(OPT, "-finline-limit=*", "accepted")
GCCONLY(OPT, "-funsafe-math-optimizations", "part of --fast-math")
GCCONLY(OPT, "-fno-signed-zeros", "part of --fast-math")
GCCONLY(OPT, "-fno-trapping-math", "part of --fast-math")
GCCONLY(OPT, "-ffinite-math-only", "part of --fast-math")
GCCONLY(OPT, "-fassociative-math", "part of --fast-math")
GCCONLY(OPT, "-freciprocal-math", "part of --fast-math")
GCCONLY(OPT, "-fmerge-constants", "accepted")
GCCONLY(OPT, "-fno-strict-overflow", "accepted: overflow wraps")
GCCONLY(OPT, "-fno-delete-null-pointer-checks", "accepted")
GCCONLY(OPT, "-fno-tree-loop-distribute-patterns", "accepted")
GCCONLY(OPT, "-fno-isolate-erroneous-paths-*", "accepted")
GCCONLY(OPT, "-fno-move-loop-invariants", "accepted")
GCCONLY(OPT, "-fno-ipa-sra", "accepted")
GCCONLY(OPT, "-fno-lto",    "accepted")
GCCONLY(OPT, "-flto",       "link-time optimization")
GCCONLY(OPT, "-fstack-protector*", "stack canaries")
GCCONLY(OPT, "-fno-stack-protector", "accepted")
GCCONLY(OPT, "-fstack-clash-protection", "stack probing")
GCCONLY(OPT, "-fcf-protection*", "control-flow protection")
GCCONLY(OPT, "-fasynchronous-unwind-tables", "--unwind-tables")
GCCONLY(OPT, "-fno-asynchronous-unwind-tables", "--no-unwind-tables")
GCCONLY(OPT, "-fno-function-sections", "the default")
GCCONLY(OPT, "-fno-data-sections", "the default")
GCCONLY(OPT, "-ffp-contract=*", "--fp-contract=")
GCCONLY(DIAG, "-W",         "-Wextra")
GCCONLY(LINK, "-Wl,*",      "--linker-arg= (comma-separated)")
GCCONLY(LINK, "-Wa,*",      "--assembler-arg= (comma-separated)")
GCCONLY(DIAG, "-Werror-implicit-function-declaration", "--error=implicit-function-declaration")
GCCONLY(DIAG, "-Wformat=*", "the format warnings' level")
GCCONLY(DIAG, "-fdiagnostics-color", "--color=always")
GCCONLY(DIAG, "-fno-diagnostics-color", "--color=never")
GCCONLY(DIAG, "-fdiagnostics-parseable-fixits", "fix-its for an IDE to apply")
GCCONLY(DIAG, "-fmessage-length=*", "accepted")
GCCONLY(DIAG, "-fanalyzer", "GCC's static analyzer")
GCCONLY(DEBUG, "-ggdb",     "-g")
GCCONLY(DEBUG, "-g1",       "-g")
