GCCONLY(DEBUG, "-fcallgraph-info*", "--call-graph")
GCCONLY(DEBUG, "-fsanitize*", "the sanitizers")
GCCONLY(DEBUG, "-fno-sanitize=*", "accepted")
GCCONLY(DEBUG, "-fprofile*", "profiling")
GCCONLY(DEBUG, "-fcoverage-mapping", "coverage")
GCCONLY(DEBUG, "--coverage", "coverage")
GCCONLY(DEBUG, "-pg",       "gprof profiling")
GCCONLY(DEPS, "-M",         "the make rule, system headers included, instead of compiling")
