/* <stop_token> — C++ [thread.stoptoken].
 *
 * Cancellation, done properly. The old way is a `volatile bool stop`
 * the worker polls, and it has three holes this closes:
 *
 *   a worker BLOCKED on a condition variable never reaches the poll,
 *   so the flag is set and nothing happens until the wait times out;
 *   nothing says who may set it or how many may watch it;
 *   and the lifetimes are the caller's problem -- the flag must outlive
 *   every worker that reads it, which is exactly the thing that goes
 *   wrong when a worker outlives its owner.
 *
 * A stop_source owns the request, a stop_token observes it, and a
 * stop_callback runs when it is made -- which is what wakes a blocked
 * worker: the callback does the notify. All three share one
 * reference-counted state, so a token that outlives its source is fine
 * and simply never sees a stop.
 *
 * ---- the guarantee that makes callbacks usable ---------------------------
 *
 * When `~stop_callback` returns, the callback is NOT running and never
 * will. Without that, a callback capturing a local could fire after the
 * local is gone -- the classic use-after-free of every cancellation
 * scheme that hands out raw function pointers.
 *
 * ---- jthread -------------------------------------------------------------
 *
 * The thread that joins in its destructor and carries a stop_source.
 * std::thread terminates instead of joining, deliberately (see
 * <thread>), and jthread is the answer for the common case where the
 * owner really does want to wait. It is here; on a target with no
 * threads its constructor throws exactly as std::thread's does.
 */
#ifndef _LIBCXX_STOP_TOKEN
#define _LIBCXX_STOP_TOKEN

#include <atomic>
#include <memory>
#include <mutex>
#include <thread>
#include <type_traits>
#include <utility>

namespace std {

class stop_source;
class stop_token;
template <class C> class stop_callback;

namespace __detail {

/* The callbacks are a list rather than a vector because a callback
 * deregisters itself from its own destructor, which may run while the
 * list is being walked. A node that removes itself from a list is
 * simple; an index into a vector that shifts underneath is not. */
struct __stop_node {
    void (*__run)(__stop_node *);
    __stop_node *__next;
    __stop_node *__prev;
};

struct __stop_state {
    mutex __m;
    bool __stopped = false;
    __stop_node *__cbs = nullptr;
    /* Sources and tokens are counted SEPARATELY: stop_possible() must
     * answer no once the last source is gone, even while tokens remain,
     * because nothing can request a stop any more and a worker that
     * knows that can take the fast path. */
    atomic<long> __sources{0};

    bool __request_stop()
    {
        unique_lock<mutex> lk(__m);
        if (__stopped)
            return false;           /* only the first caller succeeds */
        __stopped = true;
        /* The callbacks run with the lock RELEASED: one that tries to
         * deregister another -- or itself -- would otherwise deadlock
         * against this very lock. */
        __stop_node *n = __cbs;
        __cbs = nullptr;
        lk.unlock();
        while (n) {
            __stop_node *next = n->__next;
            n->__next = n->__prev = nullptr;
            n->__run(n);
            n = next;
        }
        return true;
    }

    bool __stop_requested()
    {
        lock_guard<mutex> g(__m);
        return __stopped;
    }

    /* Returns true if it was registered, false if the stop had already
     * happened -- in which case the caller runs it immediately, which
     * is what the standard requires and what keeps a late registration
     * from being silently dropped. */
    bool __add(__stop_node *n)
    {
        lock_guard<mutex> g(__m);
        if (__stopped)
            return false;
        n->__next = __cbs;
        n->__prev = nullptr;
        if (__cbs)
            __cbs->__prev = n;
        __cbs = n;
        return true;
    }

    void __remove(__stop_node *n)
    {
        lock_guard<mutex> g(__m);
        if (n->__prev)
            n->__prev->__next = n->__next;
        else if (__cbs == n)
            __cbs = n->__next;
        if (n->__next)
            n->__next->__prev = n->__prev;
        n->__next = n->__prev = nullptr;
    }
};

}  // namespace __detail

struct nostopstate_t { explicit nostopstate_t() = default; };
inline constexpr nostopstate_t nostopstate{};

class stop_token {
public:
    stop_token() noexcept = default;
    stop_token(const stop_token &) = default;
    stop_token(stop_token &&) noexcept = default;
    stop_token &operator=(const stop_token &) = default;
    stop_token &operator=(stop_token &&) noexcept = default;
    ~stop_token() = default;

    bool stop_requested() const noexcept
    { return __s && __s->__stop_requested(); }

    /* False once no source remains: nothing can request a stop any
     * more, and a worker that knows it can stop checking. */
    bool stop_possible() const noexcept
    {
        if (!__s)
            return false;
        return __s->__stopped || __s->__sources.load(memory_order_relaxed) > 0;
    }

    void swap(stop_token &o) noexcept { __s.swap(o.__s); }

    friend bool operator==(const stop_token &a, const stop_token &b) noexcept
    { return a.__s == b.__s; }
    friend bool operator!=(const stop_token &a, const stop_token &b) noexcept
    { return !(a == b); }

    explicit stop_token(shared_ptr<__detail::__stop_state> s) : __s(s) {}
    const shared_ptr<__detail::__stop_state> &__state() const { return __s; }

private:
    shared_ptr<__detail::__stop_state> __s;
};

class stop_source {
public:
    stop_source() : __s(new __detail::__stop_state())
    { __s->__sources.fetch_add(1, memory_order_relaxed); }

    explicit stop_source(nostopstate_t) noexcept {}

    stop_source(const stop_source &o) noexcept : __s(o.__s)
    {
        if (__s)
            __s->__sources.fetch_add(1, memory_order_relaxed);
    }

    stop_source(stop_source &&o) noexcept : __s(static_cast<shared_ptr<__detail::__stop_state> &&>(o.__s)) {}

    stop_source &operator=(const stop_source &o) noexcept
    {
        if (this != &o) {
            if (o.__s)
                o.__s->__sources.fetch_add(1, memory_order_relaxed);
            if (__s)
                __s->__sources.fetch_sub(1, memory_order_relaxed);
            __s = o.__s;
        }
        return *this;
    }

    stop_source &operator=(stop_source &&o) noexcept
    {
        if (this != &o) {
            if (__s)
                __s->__sources.fetch_sub(1, memory_order_relaxed);
            __s = static_cast<shared_ptr<__detail::__stop_state> &&>(o.__s);
        }
        return *this;
    }

    ~stop_source()
    {
        if (__s)
            __s->__sources.fetch_sub(1, memory_order_relaxed);
    }

    /* Only the FIRST request succeeds, and the return value says which
     * caller made it -- so a shutdown path can know whether it was the
     * one that started the stop. */
    bool request_stop() noexcept { return __s && __s->__request_stop(); }

    bool stop_requested() const noexcept
    { return __s && __s->__stop_requested(); }
    bool stop_possible() const noexcept { return (bool)__s; }

    stop_token get_token() const noexcept { return stop_token(__s); }

    void swap(stop_source &o) noexcept { __s.swap(o.__s); }

    friend bool operator==(const stop_source &a, const stop_source &b) noexcept
    { return a.__s == b.__s; }
    friend bool operator!=(const stop_source &a, const stop_source &b) noexcept
    { return !(a == b); }

private:
    shared_ptr<__detail::__stop_state> __s;
};

/* When this destructor returns, the callback is not running and never
 * will be -- which is the guarantee that makes it safe to capture a
 * local. Without it, cancellation is a use-after-free waiting to
 * happen. */
template <class C>
class stop_callback {
public:
    using callback_type = C;

    template <class D>
    explicit stop_callback(const stop_token &t, D &&cb)
        : __cb(static_cast<D &&>(cb)), __s(t.__state())
    {
        __node.__run = &__invoke;
        __node.__next = __node.__prev = nullptr;
        if (!__s)
            return;
        if (!__s->__add(&__node)) {
            /* The stop had already been requested, so it runs NOW --
             * a callback registered late must not be silently dropped. */
            __ran = true;
            __cb();
        }
    }

    ~stop_callback()
    {
        if (__s && !__ran)
            __s->__remove(&__node);
    }

    stop_callback(const stop_callback &) = delete;
    stop_callback &operator=(const stop_callback &) = delete;

private:
    static void __invoke(__detail::__stop_node *n)
    {
        /* From the node back to the enclosing object: the node is the
         * first member, so the addresses coincide. */
        stop_callback *self = (stop_callback *)n;
        self->__ran = true;
        self->__cb();
    }

    __detail::__stop_node __node;
    C __cb;
    shared_ptr<__detail::__stop_state> __s;
    bool __ran = false;
};

template <class C>
stop_callback(stop_token, C) -> stop_callback<C>;

/* ---- jthread -------------------------------------------------------------
 *
 * The thread that JOINS in its destructor, and carries a stop_source so
 * the owner can ask it to finish. std::thread terminates instead of
 * joining, deliberately -- see <thread> -- and this is the answer for
 * the common case where the owner really does want to wait.
 *
 * The function may take a stop_token as its FIRST parameter, and then
 * it is passed one; otherwise it is called as it is. That is how a
 * worker learns it was asked to stop without the caller wiring anything
 * up.
 */
class jthread {
public:
    using id = thread::id;
    using native_handle_type = thread::native_handle_type;

    jthread() noexcept = default;

    template <class F, class... A,
              class = enable_if_t<!is_same_v<decay_t<F>, jthread>>>
    explicit jthread(F &&f, A &&...a)
    {
        if constexpr (is_invocable_v<decay_t<F>, stop_token, decay_t<A>...>) {
            __t = thread(static_cast<F &&>(f), __src.get_token(),
                         static_cast<A &&>(a)...);
        } else {
            __t = thread(static_cast<F &&>(f), static_cast<A &&>(a)...);
        }
    }

    jthread(const jthread &) = delete;
    jthread &operator=(const jthread &) = delete;
    jthread(jthread &&) noexcept = default;

    jthread &operator=(jthread &&o) noexcept
    {
        if (this != &o) {
            /* Assigning over a running thread asks it to stop and waits
             * -- the same as the destructor, and not a terminate. */
            if (__t.joinable()) {
                __src.request_stop();
                __t.join();
            }
            __t = static_cast<thread &&>(o.__t);
            __src = static_cast<stop_source &&>(o.__src);
        }
        return *this;
    }

    ~jthread()
    {
        if (__t.joinable()) {
            /* Ask, then wait. Asking first is what makes the wait
             * bounded: a worker that polls its token finishes, and one
             * that does not was going to finish on its own. */
            __src.request_stop();
            __t.join();
        }
    }

    bool joinable() const noexcept { return __t.joinable(); }
    void join() { __t.join(); }
    void detach() { __t.detach(); }
    id get_id() const noexcept { return __t.get_id(); }
    native_handle_type native_handle() { return __t.native_handle(); }

    stop_source get_stop_source() noexcept { return __src; }
    stop_token get_stop_token() const noexcept { return __src.get_token(); }
    bool request_stop() noexcept { return __src.request_stop(); }

    void swap(jthread &o) noexcept
    {
        __t.swap(o.__t);
        __src.swap(o.__src);
    }

    static unsigned hardware_concurrency() noexcept
    { return thread::hardware_concurrency(); }

private:
    stop_source __src;
    thread __t;
};

inline void swap(jthread &a, jthread &b) noexcept { a.swap(b); }

}  // namespace std

#endif
