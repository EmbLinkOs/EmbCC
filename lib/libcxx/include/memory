/* <memory> — C++ [memory].
 *
 * Where raw storage becomes objects, and where ownership is written down.
 */
#ifndef _LIBCXX_MEMORY
#define _LIBCXX_MEMORY

#include <cstddef>
#include <new>
#include <type_traits>
#include <utility>
#include <iterator>

namespace std {

/* addressof gets the real address even when the class has overloaded
 * unary &, which is the whole reason it exists: a container must be able
 * to find its elements whatever they think & should mean. */
template <class T>
constexpr T *addressof(T &x) noexcept { return __builtin_addressof(x); }
template <class T> const T *addressof(const T &&) = delete;

/* ---- constructing and destroying in place ------------------------------ */

template <class T, class... A>
constexpr T *construct_at(T *p, A &&...a)
{
    return ::new (static_cast<void *>(p)) T(forward<A>(a)...);
}

template <class T>
constexpr void destroy_at(T *p)
{
    if constexpr (is_array_v<T>)
        for (auto &e : *p)
            destroy_at(addressof(e));
    else
        p->~T();
}

template <class I>
constexpr void destroy(I first, I last)
{
    for (; first != last; ++first)
        destroy_at(addressof(*first));
}

template <class I>
constexpr I destroy_n(I first, size_t n)
{
    for (; n > 0; --n, ++first)
        destroy_at(addressof(*first));
    return first;
}

/* The uninitialized_* algorithms all share one shape, and it is the shape
 * that matters: if constructing element k throws, the k-1 already built
 * must be destroyed before the exception leaves. Without that a vector
 * that throws while growing leaks every element it had managed to copy.
 *
 * Each returns the OUTPUT iterator past the last element constructed --
 * S, not I. The two are different types whenever the source is const,
 * which is every braced vector, since an initializer_list iterates as
 * const. */
template <class I, class S>
S uninitialized_copy(I first, I last, S out)
{
    S start = out;
    try {
        for (; first != last; ++first, ++out)
            construct_at(addressof(*out), *first);
    } catch (...) {
        destroy(start, out);
        throw;
    }
    return out;
}

template <class I, class S>
S uninitialized_copy_n(I first, size_t n, S out)
{
    S start = out;
    try {
        for (; n > 0; --n, ++first, ++out)
            construct_at(addressof(*out), *first);
    } catch (...) {
        destroy(start, out);
        throw;
    }
    return out;
}

template <class I, class S>
S uninitialized_move(I first, I last, S out)
{
    S start = out;
    try {
        for (; first != last; ++first, ++out)
            construct_at(addressof(*out), move(*first));
    } catch (...) {
        destroy(start, out);
        throw;
    }
    return out;
}

template <class I, class T>
void uninitialized_fill(I first, I last, const T &v)
{
    I start = first;
    try {
        for (; first != last; ++first)
            construct_at(addressof(*first), v);
    } catch (...) {
        destroy(start, first);
        throw;
    }
}

template <class I>
I uninitialized_value_construct_n(I first, size_t n)
{
    I start = first;
    try {
        for (; n > 0; --n, ++first)
            construct_at(addressof(*first));
    } catch (...) {
        destroy(start, first);
        throw;
    }
    return first;
}

/* ---- allocator --------------------------------------------------------- */

template <class T>
struct allocator {
    using value_type = T;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using propagate_on_container_move_assignment = true_type;

    constexpr allocator() noexcept = default;
    constexpr allocator(const allocator &) noexcept = default;
    template <class U> constexpr allocator(const allocator<U> &) noexcept {}
    constexpr ~allocator() = default;

    [[nodiscard]] constexpr T *allocate(size_t n)
    {
        /* n * sizeof(T) can wrap, and a wrapped size asks for a small
         * block that the caller then writes n elements into. The standard
         * spells the answer: bad_array_new_length. */
        if (n > (size_t)-1 / sizeof(T))
            throw bad_array_new_length();
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
            return static_cast<T *>(
                ::operator new(n * sizeof(T), align_val_t{alignof(T)}));
        else
            return static_cast<T *>(::operator new(n * sizeof(T)));
    }

    constexpr void deallocate(T *p, size_t n) noexcept
    {
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
            ::operator delete(p, n * sizeof(T), align_val_t{alignof(T)});
        else
            ::operator delete(p, n * sizeof(T));
    }
};

template <class T, class U>
constexpr bool operator==(const allocator<T> &, const allocator<U> &) noexcept
{ return true; }
template <class T, class U>
constexpr bool operator!=(const allocator<T> &, const allocator<U> &) noexcept
{ return false; }

/* allocator_traits is the indirection containers go through, so that an
 * allocator only has to provide what it wants to change. Every member
 * below has a default expressed in terms of the few that do not. */
namespace __detail {
template <class A, class = void> struct __alloc_ptr
{ using type = typename A::value_type *; };
template <class A> struct __alloc_ptr<A, void_t<typename A::pointer>>
{ using type = typename A::pointer; };

template <class A, class = void> struct __alloc_size
{ using type = size_t; };
template <class A> struct __alloc_size<A, void_t<typename A::size_type>>
{ using type = typename A::size_type; };

template <class A, class = void> struct __alloc_diff
{ using type = ptrdiff_t; };
template <class A> struct __alloc_diff<A, void_t<typename A::difference_type>>
{ using type = typename A::difference_type; };
}

template <class A>
struct allocator_traits {
    using allocator_type = A;
    using value_type = typename A::value_type;
    using pointer = typename __detail::__alloc_ptr<A>::type;
    using const_pointer = const value_type *;
    using void_pointer = void *;
    using size_type = typename __detail::__alloc_size<A>::type;
    using difference_type = typename __detail::__alloc_diff<A>::type;

    template <class U> using rebind_alloc = allocator<U>;

    [[nodiscard]] static constexpr pointer allocate(A &a, size_type n)
    { return a.allocate(n); }
    static constexpr void deallocate(A &a, pointer p, size_type n)
    { a.deallocate(p, n); }

    template <class T, class... Args>
    static constexpr void construct(A &, T *p, Args &&...args)
    { construct_at(p, forward<Args>(args)...); }
    template <class T>
    static constexpr void destroy(A &, T *p) { destroy_at(p); }

    static constexpr size_type max_size(const A &) noexcept
    { return (size_type)-1 / sizeof(value_type); }

    static constexpr A select_on_container_copy_construction(const A &a)
    { return a; }
};

/* ---- unique_ptr --------------------------------------------------------- */

template <class T>
struct default_delete {
    constexpr default_delete() noexcept = default;
    template <class U> default_delete(const default_delete<U> &) noexcept {}
    void operator()(T *p) const
    {
        /* Deleting through a pointer to an incomplete type is undefined
         * and silently skips the destructor, so it is refused here where
         * the mistake is. */
        static_assert(sizeof(T) > 0, "cannot delete an incomplete type");
        delete p;
    }
};

template <class T>
struct default_delete<T[]> {
    constexpr default_delete() noexcept = default;
    template <class U> void operator()(U *) const = delete;
    void operator()(T *p) const
    {
        static_assert(sizeof(T) > 0, "cannot delete an incomplete type");
        delete[] p;
    }
};

template <class T, class D = default_delete<T>>
class unique_ptr {
public:
    using pointer = T *;
    using element_type = T;
    using deleter_type = D;

    constexpr unique_ptr() noexcept : __p(nullptr), __d() {}
    constexpr unique_ptr(decltype(nullptr)) noexcept : __p(nullptr), __d() {}
    explicit unique_ptr(pointer p) noexcept : __p(p), __d() {}
    unique_ptr(pointer p, const D &d) noexcept : __p(p), __d(d) {}

    unique_ptr(unique_ptr &&o) noexcept
        : __p(o.release()), __d(move(o.__d)) {}
    template <class U, class E>
    unique_ptr(unique_ptr<U, E> &&o) noexcept : __p(o.release()), __d() {}

    /* Copying is what unique_ptr exists to prevent, and deleting the
     * members says so at the call site instead of at a link error. */
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;

    ~unique_ptr() { if (__p) __d(__p); }

    unique_ptr &operator=(unique_ptr &&o) noexcept
    {
        /* Self-move must not destroy the object: reset() would delete it
         * and then store the pointer it has just freed. */
        if (this != addressof(o)) {
            reset(o.release());
            __d = move(o.__d);
        }
        return *this;
    }
    unique_ptr &operator=(decltype(nullptr)) noexcept { reset(); return *this; }

    pointer get() const noexcept { return __p; }
    D &get_deleter() noexcept { return __d; }
    const D &get_deleter() const noexcept { return __d; }
    explicit operator bool() const noexcept { return __p != nullptr; }

    typename add_lvalue_reference<T>::type operator*() const { return *__p; }
    pointer operator->() const noexcept { return __p; }

    pointer release() noexcept { pointer p = __p; __p = nullptr; return p; }

    void reset(pointer p = pointer()) noexcept
    {
        /* Old pointer taken first, deleted last: the deleter may run code
         * that reaches this unique_ptr again, and it must not see a
         * dangling one. */
        pointer old = __p;
        __p = p;
        if (old)
            __d(old);
    }

    void swap(unique_ptr &o) noexcept
    {
        using std::swap;
        swap(__p, o.__p);
        swap(__d, o.__d);
    }

private:
    pointer __p;
    D __d;
};

template <class T, class D>
class unique_ptr<T[], D> {
public:
    using pointer = T *;
    using element_type = T;
    using deleter_type = D;

    constexpr unique_ptr() noexcept : __p(nullptr), __d() {}
    constexpr unique_ptr(decltype(nullptr)) noexcept : __p(nullptr), __d() {}
    explicit unique_ptr(pointer p) noexcept : __p(p), __d() {}
    unique_ptr(unique_ptr &&o) noexcept : __p(o.release()), __d(move(o.__d)) {}
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
    ~unique_ptr() { if (__p) __d(__p); }

    unique_ptr &operator=(unique_ptr &&o) noexcept
    {
        if (this != addressof(o)) { reset(o.release()); __d = move(o.__d); }
        return *this;
    }

    pointer get() const noexcept { return __p; }
    explicit operator bool() const noexcept { return __p != nullptr; }
    T &operator[](size_t i) const { return __p[i]; }
    pointer release() noexcept { pointer p = __p; __p = nullptr; return p; }
    void reset(pointer p = pointer()) noexcept
    { pointer old = __p; __p = p; if (old) __d(old); }
    void swap(unique_ptr &o) noexcept
    { using std::swap; swap(__p, o.__p); swap(__d, o.__d); }

private:
    pointer __p;
    D __d;
};

template <class T, class D>
void swap(unique_ptr<T, D> &a, unique_ptr<T, D> &b) noexcept { a.swap(b); }

template <class T, class D, class U, class E>
bool operator==(const unique_ptr<T, D> &a, const unique_ptr<U, E> &b)
{ return a.get() == b.get(); }
template <class T, class D, class U, class E>
bool operator!=(const unique_ptr<T, D> &a, const unique_ptr<U, E> &b)
{ return a.get() != b.get(); }
template <class T, class D>
bool operator==(const unique_ptr<T, D> &a, decltype(nullptr)) noexcept
{ return !a; }
template <class T, class D>
bool operator==(decltype(nullptr), const unique_ptr<T, D> &a) noexcept
{ return !a; }
template <class T, class D>
bool operator!=(const unique_ptr<T, D> &a, decltype(nullptr)) noexcept
{ return (bool)a; }
template <class T, class D>
bool operator!=(decltype(nullptr), const unique_ptr<T, D> &a) noexcept
{ return (bool)a; }

/* make_unique is not a convenience. `f(unique_ptr<A>(new A), g())` may
 * evaluate `new A` and then g(), and if g() throws the A leaks -- the
 * unique_ptr was never constructed. make_unique has no such window. */
template <class T, class... A>
enable_if_t<!is_array_v<T>, unique_ptr<T>> make_unique(A &&...a)
{
    return unique_ptr<T>(new T(forward<A>(a)...));
}

template <class T>
enable_if_t<is_unbounded_array_v<T>, unique_ptr<T>> make_unique(size_t n)
{
    return unique_ptr<T>(new remove_extent_t<T>[n]());
}

template <class T, class... A>
enable_if_t<is_bounded_array_v<T>> make_unique(A &&...) = delete;

template <class T>
enable_if_t<!is_array_v<T>, unique_ptr<T>> make_unique_for_overwrite()
{ return unique_ptr<T>(new T); }

/* ---- shared_ptr ---------------------------------------------------------
 * Shared ownership through a separate CONTROL BLOCK holding two counts.
 *
 * Two counts and not one, and the reason is weak_ptr. The strong count
 * says how many owners there are: at zero the OBJECT is destroyed. The
 * weak count says how many observers remain: at zero the CONTROL BLOCK
 * itself is freed. They have to be separate because a weak_ptr must be
 * able to ask "is it still alive?" after the object is gone -- which
 * means the block outlives the object it describes.
 *
 * Single-threaded, like the rest of this runtime: the counts are plain
 * integers. Making them atomic is the only change threads would need,
 * and it is confined to this one class.
 */
namespace __detail {

struct __sp_counted {
    long __strong;
    long __weak;

    __sp_counted() : __strong(1), __weak(1) {}
    virtual ~__sp_counted() {}

    /* Destroying the OBJECT and freeing the BLOCK are separate virtuals
     * because they happen at different times: the first when the last
     * owner goes, the second when the last observer does. */
    virtual void __dispose() = 0;
    virtual void __destroy_self() { delete this; }

    void __add_ref() { ++__strong; }
    void __add_weak() { ++__weak; }

    void __release()
    {
        if (--__strong == 0) {
            __dispose();
            /* The last strong reference also holds one weak reference --
             * that is what the block's weak count starting at 1 means --
             * so releasing it here is what lets a block with no
             * weak_ptrs be freed immediately. */
            __release_weak();
        }
    }

    void __release_weak()
    {
        if (--__weak == 0)
            __destroy_self();
    }

    /* Used by weak_ptr::lock(): takes a strong reference only if one
     * still exists. Returning false is how "the object is gone" is
     * reported without ever touching it. */
    bool __try_add_ref()
    {
        if (__strong == 0)
            return false;
        ++__strong;
        return true;
    }
};

template <class T, class D>
struct __sp_ptr : __sp_counted {
    T *__p;
    D __d;
    __sp_ptr(T *p, D d) : __p(p), __d(std::move(d)) {}
    void __dispose() override { __d(__p); }
};

/* make_shared's block: the object lives INSIDE it, so one allocation
 * serves both. That is the whole advantage of make_shared over
 * shared_ptr<T>(new T) -- and the reason a weak_ptr keeps the object's
 * STORAGE alive (though not the object) until the last observer goes. */
template <class T>
struct __sp_inplace : __sp_counted {
    alignas(T) unsigned char __buf[sizeof(T)];
    T *__get() { return reinterpret_cast<T *>(__buf); }
    void __dispose() override { destroy_at(__get()); }
};

}  // namespace __detail

template <class T> class weak_ptr;
template <class T> class enable_shared_from_this;

template <class T>
class shared_ptr {
public:
    using element_type = T;

    constexpr shared_ptr() noexcept : __p(nullptr), __c(nullptr) {}
    constexpr shared_ptr(decltype(nullptr)) noexcept
        : __p(nullptr), __c(nullptr) {}

    template <class U>
    explicit shared_ptr(U *p)
        : __p(p), __c(new __detail::__sp_ptr<U, default_delete<U>>(
                          p, default_delete<U>()))
    { __enable_weak_this(p); }

    template <class U, class D>
    shared_ptr(U *p, D d)
        : __p(p), __c(new __detail::__sp_ptr<U, D>(p, std::move(d)))
    { __enable_weak_this(p); }

    shared_ptr(const shared_ptr &o) noexcept : __p(o.__p), __c(o.__c)
    { if (__c) __c->__add_ref(); }

    template <class U>
    shared_ptr(const shared_ptr<U> &o) noexcept
        : __p(o.__p), __c(o.__c)
    { if (__c) __c->__add_ref(); }

    shared_ptr(shared_ptr &&o) noexcept : __p(o.__p), __c(o.__c)
    { o.__p = nullptr; o.__c = nullptr; }

    /* The ALIASING constructor: shares o's ownership but points at
     * something else -- a member of the owned object, usually. It is how
     * a shared_ptr to a field keeps the whole object alive. */
    template <class U>
    shared_ptr(const shared_ptr<U> &o, T *p) noexcept : __p(p), __c(o.__c)
    { if (__c) __c->__add_ref(); }

    ~shared_ptr() { if (__c) __c->__release(); }

    shared_ptr &operator=(const shared_ptr &o) noexcept
    {
        /* The new reference is taken BEFORE the old is released, so
         * self-assignment cannot destroy what it is about to keep. */
        __detail::__sp_counted *c = o.__c;
        if (c) c->__add_ref();
        if (__c) __c->__release();
        __p = o.__p;
        __c = c;
        return *this;
    }

    shared_ptr &operator=(shared_ptr &&o) noexcept
    {
        if (this != addressof(o)) {
            if (__c) __c->__release();
            __p = o.__p; __c = o.__c;
            o.__p = nullptr; o.__c = nullptr;
        }
        return *this;
    }

    void reset() noexcept
    { if (__c) __c->__release(); __p = nullptr; __c = nullptr; }

    template <class U>
    void reset(U *p) { shared_ptr(p).swap(*this); }

    void swap(shared_ptr &o) noexcept
    {
        T *tp = __p; __p = o.__p; o.__p = tp;
        __detail::__sp_counted *tc = __c; __c = o.__c; o.__c = tc;
    }

    T *get() const noexcept { return __p; }
    T &operator*() const noexcept { return *__p; }
    T *operator->() const noexcept { return __p; }
    explicit operator bool() const noexcept { return __p != nullptr; }
    long use_count() const noexcept { return __c ? __c->__strong : 0; }
    bool unique() const noexcept { return use_count() == 1; }

    /* For make_shared and weak_ptr::lock, which build one directly.
     * It runs the enable_shared_from_this hook like every other
     * constructor -- make_shared reaches this one, and without it an
     * object made by make_shared would never learn its control block
     * and shared_from_this() would return empty. */
    shared_ptr(T *p, __detail::__sp_counted *c, int) noexcept
        : __p(p), __c(c) { __enable_weak_this(p); }

private:
    T *__p;
    __detail::__sp_counted *__c;

    template <class U> friend class shared_ptr;
    template <class U> friend class weak_ptr;

    /* enable_shared_from_this works by the shared_ptr TELLING the object
     * about its control block at construction. There is no way for an
     * object to find one otherwise, which is why shared_from_this()
     * before any shared_ptr owns it is undefined. */
    template <class U>
    void __enable_weak_this(U *p)
    {
        if constexpr (is_base_of_v<enable_shared_from_this<U>, U>)
            if (p)
                p->__weak_this = weak_ptr<U>(*this);
    }
    void __enable_weak_this(...) {}
};

template <class T>
class weak_ptr {
public:
    constexpr weak_ptr() noexcept : __p(nullptr), __c(nullptr) {}

    weak_ptr(const weak_ptr &o) noexcept : __p(o.__p), __c(o.__c)
    { if (__c) __c->__add_weak(); }

    template <class U>
    weak_ptr(const shared_ptr<U> &o) noexcept : __p(o.__p), __c(o.__c)
    { if (__c) __c->__add_weak(); }

    weak_ptr(weak_ptr &&o) noexcept : __p(o.__p), __c(o.__c)
    { o.__p = nullptr; o.__c = nullptr; }

    ~weak_ptr() { if (__c) __c->__release_weak(); }

    weak_ptr &operator=(const weak_ptr &o) noexcept
    {
        __detail::__sp_counted *c = o.__c;
        if (c) c->__add_weak();
        if (__c) __c->__release_weak();
        __p = o.__p; __c = c;
        return *this;
    }

    template <class U>
    weak_ptr &operator=(const shared_ptr<U> &o) noexcept
    {
        if (o.__c) o.__c->__add_weak();
        if (__c) __c->__release_weak();
        __p = o.__p; __c = o.__c;
        return *this;
    }

    void reset() noexcept
    { if (__c) __c->__release_weak(); __p = nullptr; __c = nullptr; }

    long use_count() const noexcept { return __c ? __c->__strong : 0; }
    bool expired() const noexcept { return use_count() == 0; }

    /* The only safe way to use a weak_ptr: ask for a strong reference and
     * be told whether one could be taken. Testing expired() and then
     * dereferencing is the race this exists to prevent -- and is a race
     * even single-threaded, if the check and the use straddle anything
     * that might release the last owner. */
    shared_ptr<T> lock() const noexcept
    {
        if (__c && __c->__try_add_ref())
            return shared_ptr<T>(__p, __c, 0);
        return shared_ptr<T>();
    }

    void swap(weak_ptr &o) noexcept
    {
        T *tp = __p; __p = o.__p; o.__p = tp;
        __detail::__sp_counted *tc = __c; __c = o.__c; o.__c = tc;
    }

private:
    T *__p;
    __detail::__sp_counted *__c;
    template <class U> friend class shared_ptr;
};

template <class T>
class enable_shared_from_this {
public:
    shared_ptr<T> shared_from_this() { return __weak_this.lock(); }
    shared_ptr<const T> shared_from_this() const
    { return __weak_this.lock(); }
    weak_ptr<T> weak_from_this() noexcept { return __weak_this; }

protected:
    constexpr enable_shared_from_this() noexcept {}
    enable_shared_from_this(const enable_shared_from_this &) noexcept {}
    enable_shared_from_this &operator=(const enable_shared_from_this &) noexcept
    { return *this; }
    ~enable_shared_from_this() {}

public:
    mutable weak_ptr<T> __weak_this;
};

/* One allocation for the block and the object together, where
 * shared_ptr<T>(new T) makes two -- and, like make_unique, no window in
 * which a raw pointer exists unowned. */
template <class T, class... A>
shared_ptr<T> make_shared(A &&...a)
{
    auto *blk = new __detail::__sp_inplace<T>();
    construct_at(blk->__get(), forward<A>(a)...);
    shared_ptr<T> sp(blk->__get(), blk, 0);
    return sp;
}

template <class T, class U>
bool operator==(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept
{ return a.get() == b.get(); }
template <class T, class U>
bool operator!=(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept
{ return a.get() != b.get(); }
template <class T>
bool operator==(const shared_ptr<T> &a, decltype(nullptr)) noexcept
{ return !a; }
template <class T>
bool operator!=(const shared_ptr<T> &a, decltype(nullptr)) noexcept
{ return (bool)a; }

template <class T>
void swap(shared_ptr<T> &a, shared_ptr<T> &b) noexcept { a.swap(b); }

template <class T, class U>
shared_ptr<T> static_pointer_cast(const shared_ptr<U> &o) noexcept
{ return shared_ptr<T>(o, static_cast<T *>(o.get())); }

template <class T, class U>
shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U> &o) noexcept
{
    T *p = dynamic_cast<T *>(o.get());
    return p ? shared_ptr<T>(o, p) : shared_ptr<T>();
}

}  // namespace std

