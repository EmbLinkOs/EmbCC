/* <latch> — C++ [thread.latch].
 *
 * A one-shot countdown. Threads `count_down()`; threads `wait()` until
 * it reaches zero; and once it is zero it stays zero forever. That
 * last part is the whole difference from a barrier, and it is what
 * makes a latch the simpler and safer of the two: there is no phase to
 * get out of step with, and a late arrival at `wait()` returns at once
 * instead of blocking for a round that already happened.
 *
 * The shape it fits: "start N workers, wait until all have finished
 * setting up". A barrier would be wrong there -- the setup happens
 * once.
 */
#ifndef _LIBCXX_LATCH
#define _LIBCXX_LATCH

#include <atomic>
#include <cstddef>
#include <limits>

extern "C" {
int __os_futex_wait(const volatile int *addr, int expected, long timeout_ns);
int __os_futex_wake(const volatile int *addr, int count);
void __os_thread_yield(void);
}

namespace std {

class latch {
public:
    static constexpr ptrdiff_t max() noexcept
    { return numeric_limits<int>::max(); }

    constexpr explicit latch(ptrdiff_t expected) : __n((int)expected) {}
    ~latch() = default;
    latch(const latch &) = delete;
    latch &operator=(const latch &) = delete;

    void count_down(ptrdiff_t n = 1)
    {
        int prev = __n.fetch_sub((int)n, memory_order_release);
        /* Wake ALL, and only on the transition to zero. Waking on every
         * count_down would be a syscall per worker for waiters that
         * still cannot proceed; waking one would leave the rest asleep,
         * because a latch releases everybody at once. */
        if (prev - (int)n <= 0)
            __os_futex_wake(__word(), -1);
    }

    bool try_wait() const noexcept
    { return __n.load(memory_order_acquire) <= 0; }

    void wait() const
    {
        for (;;) {
            int c = __n.load(memory_order_acquire);
            if (c <= 0)
                return;
            if (__os_futex_wait(__word(), c, -1) < 0)
                __os_thread_yield();
        }
    }

    /* The two together, which is what a worker that is itself one of
     * the N wants: announce, then wait for the others. Doing it as two
     * calls is identical and this says the intent. */
    void arrive_and_wait(ptrdiff_t n = 1)
    {
        count_down(n);
        wait();
    }

private:
    const volatile int *__word() const
    { return (const volatile int *)&__n; }
    atomic<int> __n;
};

}  // namespace std

#endif
