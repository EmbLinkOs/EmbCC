/* <execution> — C++ [execpol].
 *
 * Four tags that say HOW an algorithm may run. They are types, not
 * flags, so the choice is made by overload resolution at compile time
 * and an algorithm that cannot honour a policy simply does not accept
 * it.
 *
 * ---- what these mean here ---------------------------------------------
 *
 * Nothing runs in parallel. There is one thread on this target (see
 * <thread>), so `par` and `par_unseq` are honoured by running
 * sequentially -- which is a CONFORMING implementation and not a
 * shortcut: the standard permits an implementation to ignore a policy
 * and run sequentially, precisely because the policy is permission and
 * not instruction.
 *
 * What it is NOT permission for is worth stating, because it does not
 * change here: passing `par` to an algorithm whose predicate touches
 * shared state without synchronisation is undefined even if this
 * implementation happens to serialise it. Code written against `par`
 * must be correct under parallelism, or it is wrong in a way this
 * target cannot show you. `__cpp_lib_parallel_algorithm` is therefore
 * NOT defined in <version>.
 */
#ifndef _LIBCXX_EXECUTION
#define _LIBCXX_EXECUTION

#include <type_traits>

namespace std {

namespace execution {

class sequenced_policy {};
class parallel_policy {};
class parallel_unsequenced_policy {};
class unsequenced_policy {};

inline constexpr sequenced_policy seq{};
inline constexpr parallel_policy par{};
inline constexpr parallel_unsequenced_policy par_unseq{};
inline constexpr unsequenced_policy unseq{};

}  // namespace execution

template <class T> struct is_execution_policy : false_type {};
template <> struct is_execution_policy<execution::sequenced_policy>
    : true_type {};
template <> struct is_execution_policy<execution::parallel_policy>
    : true_type {};
template <> struct is_execution_policy<execution::parallel_unsequenced_policy>
    : true_type {};
template <> struct is_execution_policy<execution::unsequenced_policy>
    : true_type {};

template <class T>
inline constexpr bool is_execution_policy_v = is_execution_policy<T>::value;

}  // namespace std

#endif
