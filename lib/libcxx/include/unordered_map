/* <unordered_map> — C++ [unord.map].
 *
 * The hash table in include/__hash, keyed on a pair's first member. The
 * same relationship map has to the red-black tree.
 *
 * The difference from map that matters is not speed: it is that
 * ITERATION ORDER IS UNSPECIFIED and may change on any insertion that
 * rehashes. Code that prints an unordered_map and compares the output
 * works until the table grows.
 */
#ifndef _LIBCXX_UNORDERED_MAP
#define _LIBCXX_UNORDERED_MAP

#include <cstddef>
#include <utility>
#include <functional>
#include <initializer_list>
#include <stdexcept>
#include <__hash>

namespace std {

namespace __detail {
template <class K, class T>
struct __umap_key_of {
    const K &operator()(const pair<const K, T> &p) const { return p.first; }
};
}

template <class K, class T, class H = hash<K>, class E = equal_to<K>>
class unordered_map {
    using table = __detail::__hash_table<pair<const K, T>, K,
                                         __detail::__umap_key_of<K, T>,
                                         H, E, false>;
    table __t;

public:
    using key_type = K;
    using mapped_type = T;
    using value_type = pair<const K, T>;
    using size_type = size_t;
    using iterator = typename table::iterator;
    using const_iterator = typename table::const_iterator;

    unordered_map() = default;
    unordered_map(initializer_list<value_type> l)
    { for (auto &v : l) insert(v); }

    iterator begin() { return __t.begin(); }
    const_iterator begin() const { return __t.begin(); }
    iterator end() { return __t.end(); }
    const_iterator end() const { return __t.end(); }

    bool empty() const noexcept { return __t.empty(); }
    size_type size() const noexcept { return __t.size(); }
    void clear() { __t.clear(); }
    void reserve(size_type n) { __t.reserve(n); }
    size_type bucket_count() const noexcept { return __t.bucket_count(); }
    float load_factor() const noexcept { return __t.load_factor(); }

    pair<iterator, bool> insert(const value_type &v) { return __t.emplace(v); }
    pair<iterator, bool> insert(value_type &&v)
    { return __t.emplace(std::move(v)); }
    template <class... A>
    pair<iterator, bool> emplace(A &&...a)
    { return __t.emplace(forward<A>(a)...); }

    /* Inserts when absent, exactly as map's does. */
    T &operator[](const K &k)
    {
        iterator it = __t.find(k);
        if (it != end()) return it->second;
        return __t.emplace(value_type(k, T())).first->second;
    }

    T &at(const K &k)
    {
        iterator it = __t.find(k);
        if (it == end()) __throw_umap_out_of_range();
        return it->second;
    }
    const T &at(const K &k) const
    {
        const_iterator it = __t.find(k);
        if (it == end()) __throw_umap_out_of_range();
        return it->second;
    }

    iterator find(const K &k) { return __t.find(k); }
    const_iterator find(const K &k) const { return __t.find(k); }
    size_type count(const K &k) const { return __t.count(k); }
    bool contains(const K &k) const { return __t.find(k) != __t.end(); }

    size_type erase(const K &k) { return __t.erase(k); }
    iterator erase(iterator pos) { return __t.erase(pos); }
    void swap(unordered_map &o) noexcept { __t.swap(o.__t); }

    bool __check() const { return __t.__check(); }

private:
    [[noreturn]] static void __throw_umap_out_of_range();
};

template <class K, class T, class H, class E>
void unordered_map<K, T, H, E>::__throw_umap_out_of_range()
{ throw out_of_range("unordered_map::at: key not found"); }

template <class K, class T, class H, class E>
bool operator==(const unordered_map<K, T, H, E> &a,
                const unordered_map<K, T, H, E> &b)
{
    if (a.size() != b.size()) return false;
    for (auto it = a.begin(); it != a.end(); ++it) {
        auto f = b.find(it->first);
        if (f == b.end() || !(f->second == it->second)) return false;
    }
    return true;
}
template <class K, class T, class H, class E>
bool operator!=(const unordered_map<K, T, H, E> &a,
                const unordered_map<K, T, H, E> &b)
{ return !(a == b); }

template <class K, class T, class H = hash<K>, class E = equal_to<K>>
class unordered_multimap {
    using table = __detail::__hash_table<pair<const K, T>, K,
                                         __detail::__umap_key_of<K, T>,
                                         H, E, true>;
    table __t;

public:
    using value_type = pair<const K, T>;
    using size_type = size_t;
    using iterator = typename table::iterator;

    unordered_multimap() = default;
    iterator begin() { return __t.begin(); }
    iterator end() { return __t.end(); }
    size_type size() const noexcept { return __t.size(); }
    bool empty() const noexcept { return __t.empty(); }
    iterator insert(const value_type &v) { return __t.emplace(v).first; }
    size_type count(const K &k) const { return __t.count(k); }
    iterator find(const K &k) { return __t.find(k); }
    size_type erase(const K &k) { return __t.erase(k); }
    void clear() { __t.clear(); }
    bool __check() const { return __t.__check(); }
};

}  // namespace std

#endif
