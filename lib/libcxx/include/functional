template <class R, class... A>
function(R (*)(A...)) -> function<R(A...)>;

/* ---- bind ---------------------------------------------------------------
 *
 * Fix some arguments now, supply the rest later. A lambda does this
 * better in nearly every case -- it is clearer, it does not need
 * placeholders, and it compiles to less -- so this exists for the code
 * that already uses it and for member pointers, where `bind(&T::f, obj)`
 * is still shorter than the lambda.
 *
 * The placeholders are the one part that has to be a library trick: `_1`
 * is an object whose TYPE encodes its index, so the substitution happens
 * at compile time and costs nothing at run time.
 */
namespace placeholders {
template <int N> struct __ph {};
inline constexpr __ph<1> _1{};
inline constexpr __ph<2> _2{};
inline constexpr __ph<3> _3{};
inline constexpr __ph<4> _4{};
inline constexpr __ph<5> _5{};
inline constexpr __ph<6> _6{};
}

template <class T> struct is_placeholder : integral_constant<int, 0> {};
template <int N>
struct is_placeholder<placeholders::__ph<N>> : integral_constant<int, N> {};
/* The cv-qualified forms too: the placeholders are `inline constexpr`
 * objects, so `decltype(_1)` is `const __ph<1>` and a program that asks
 * the obvious question would otherwise get 0. */
template <int N>
struct is_placeholder<const placeholders::__ph<N>>
    : integral_constant<int, N> {};
template <int N>
struct is_placeholder<volatile placeholders::__ph<N>>
    : integral_constant<int, N> {};
template <int N>
struct is_placeholder<const volatile placeholders::__ph<N>>
    : integral_constant<int, N> {};
template <class T>
inline constexpr int is_placeholder_v = is_placeholder<T>::value;

template <class T> struct is_bind_expression : false_type {};
template <class T>
inline constexpr bool is_bind_expression_v = is_bind_expression<T>::value;

namespace __detail {

/* One bound argument, resolved against the call's arguments: a
 * placeholder picks one out, a reference_wrapper unwraps, and anything
 * else is itself. */
template <class Bound, class Tup>
constexpr decltype(auto) __bind_arg(Bound &b, Tup &&t)
{
    constexpr int n = is_placeholder_v<remove_cvref_t<Bound>>;
    if constexpr (n != 0)
        return get<n - 1>(static_cast<Tup &&>(t));
    else
        return (b);
}

template <class F, class Bounds, size_t... I, class Tup>
constexpr decltype(auto) __bind_call(F &f, Bounds &bs, index_sequence<I...>,
                                     Tup &&t)
{
    return invoke(f, __bind_arg(get<I>(bs), static_cast<Tup &&>(t))...);
}

template <class F, class... B>
class __binder {
public:
    /* Constrained, or this greedy constructor beats the COPY
     * constructor whenever a binder is copied from a non-const
     * binder: the template is an exact match and the copy constructor
     * needs a qualification conversion. Storing a binder in a
     * std::function copies it, which is how this was found. */
    template <class G, class... C,
              class = enable_if_t<!is_same_v<decay_t<G>, __binder>>>
    explicit constexpr __binder(G &&g, C &&...c)
        : __f(forward<G>(g)), __b(forward<C>(c)...) {}

    __binder(const __binder &) = default;
    __binder(__binder &&) = default;
    __binder &operator=(const __binder &) = default;
    __binder &operator=(__binder &&) = default;

    template <class... A>
    constexpr decltype(auto) operator()(A &&...a)
    {
        return __bind_call(__f, __b, make_index_sequence<sizeof...(B)>{},
                           tuple<A &&...>(forward<A>(a)...));
    }

    template <class... A>
    constexpr decltype(auto) operator()(A &&...a) const
    {
        return __bind_call(__f, __b, make_index_sequence<sizeof...(B)>{},
                           tuple<A &&...>(forward<A>(a)...));
    }

private:
    mutable F __f;
    mutable tuple<B...> __b;
};

}  // namespace __detail

template <class F, class... B>
struct is_bind_expression<__detail::__binder<F, B...>> : true_type {};

template <class F, class... B>
constexpr __detail::__binder<decay_t<F>, decay_t<B>...> bind(F &&f, B &&...b)
{
    return __detail::__binder<decay_t<F>, decay_t<B>...>(forward<F>(f),
                                                         forward<B>(b)...);
}

}  // namespace std

