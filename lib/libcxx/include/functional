/* ---- the function objects ----------------------------------------------
 * Each has a `void` specialisation -- the TRANSPARENT form -- which
 * deduces its arguments instead of fixing them. `less<>` can compare a
 * std::string with a const char* without building a string; `less<string>`
 * cannot, and that conversion is the cost people forget. */
/* Written out one by one rather than macro-generated: a macro cannot take
 * an operator as a parameter and paste it into both a body and a trailing
 * return type, and a macro that almost works is worse than a table. */
template <class T = void> struct plus
{ constexpr T operator()(const T &a, const T &b) const { return a + b; } };
template <> struct plus<void> {
    using is_transparent = void;
    template <class A, class B>
    constexpr auto operator()(A &&a, B &&b) const
        -> decltype(forward<A>(a) + forward<B>(b))
    { return forward<A>(a) + forward<B>(b); }
};

