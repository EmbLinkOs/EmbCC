namespace std {

/* invoke is INVOKE spelled as a function: it calls anything the standard
 * calls callable, including a pointer to member through an object, a
 * reference to one, or a pointer to one. Generic code calls this instead
 * of writing f(a...) so that a member pointer works too. */
template <class F, class... A>
constexpr invoke_result_t<F, A...> invoke(F &&f, A &&...a)
{
    if constexpr (is_member_pointer_v<remove_cvref_t<F>>) {
        static_assert(sizeof...(A) >= 1,
                      "a pointer to member needs an object to apply it to");
        return __detail::__invoke_mem(forward<F>(f), forward<A>(a)...);
    } else {
        return forward<F>(f)(forward<A>(a)...);
    }
}

namespace __detail {
template <class F, class O, class... A>
constexpr decltype(auto) __invoke_mem(F &&f, O &&o, A &&...a)
{
    using C = typename __memptr_class<remove_cvref_t<F>>::type;
    if constexpr (is_member_function_pointer_v<remove_cvref_t<F>>) {
        if constexpr (is_base_of_v<C, decay_t<O>>)
            return (forward<O>(o).*f)(forward<A>(a)...);
        else
            return ((*forward<O>(o)).*f)(forward<A>(a)...);
    } else {
        static_assert(sizeof...(A) == 0,
                      "a pointer to data member takes no arguments");
        if constexpr (is_base_of_v<C, decay_t<O>>)
            return forward<O>(o).*f;
        else
            return (*forward<O>(o)).*f;
    }
}
}

template <class R, class F, class... A>
constexpr R invoke_r(F &&f, A &&...a)
{
    if constexpr (is_void_v<R>)
        (void)invoke(forward<F>(f), forward<A>(a)...);
    else
        return invoke(forward<F>(f), forward<A>(a)...);
}

/* ---- reference_wrapper --------------------------------------------------
 * A reference that can be copied, assigned and stored in a container --
 * which a real reference cannot. It holds a POINTER; the constructor
 * takes an lvalue and the rvalue overload is deleted, because binding it
 * to a temporary would leave it dangling the moment the full expression
 * ends. */
template <class T>
class reference_wrapper {
public:
    using type = T;

    constexpr reference_wrapper(T &t) noexcept : __p(addressof(t)) {}
    reference_wrapper(T &&) = delete;
    constexpr reference_wrapper(const reference_wrapper &) noexcept = default;
    constexpr reference_wrapper &
    operator=(const reference_wrapper &) noexcept = default;

    constexpr operator T &() const noexcept { return *__p; }
    constexpr T &get() const noexcept { return *__p; }

    template <class... A>
    constexpr invoke_result_t<T &, A...> operator()(A &&...a) const
    { return invoke(get(), forward<A>(a)...); }

private:
    T *__p;
};

template <class T> reference_wrapper(T &) -> reference_wrapper<T>;

template <class T>
constexpr reference_wrapper<T> ref(T &t) noexcept
{ return reference_wrapper<T>(t); }
template <class T>
constexpr reference_wrapper<T> ref(reference_wrapper<T> t) noexcept
{ return t; }
template <class T> void ref(const T &&) = delete;

template <class T>
constexpr reference_wrapper<const T> cref(const T &t) noexcept
{ return reference_wrapper<const T>(t); }
template <class T>
constexpr reference_wrapper<const T> cref(reference_wrapper<T> t) noexcept
{ return reference_wrapper<const T>(t.get()); }
template <class T> void cref(const T &&) = delete;

