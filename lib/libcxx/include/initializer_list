/* <initializer_list> — C++ [support.initlist].
 *
 * This header is not optional and cannot be replaced: `{1, 2, 3}` in a
 * function call is a CORE LANGUAGE construct whose type is
 * std::initializer_list, so the compiler requires this exact class, in
 * this exact namespace, with these two members in this order. It builds
 * the object itself from an array it laid out.
 */
#ifndef _LIBCXX_INITIALIZER_LIST
#define _LIBCXX_INITIALIZER_LIST

#include <cstddef>

namespace std {

template <class E>
class initializer_list {
public:
    using value_type = E;
    using reference = const E &;
    using const_reference = const E &;
    using size_type = size_t;
    using iterator = const E *;
    using const_iterator = const E *;

    constexpr initializer_list() noexcept : __data(nullptr), __len(0) {}

    constexpr size_t size() const noexcept { return __len; }
    constexpr const E *begin() const noexcept { return __data; }
    constexpr const E *end() const noexcept { return __data + __len; }

private:
    /* The compiler constructs these two, in this order. */
    const E *__data;
    size_t __len;

    constexpr initializer_list(const E *p, size_t n) noexcept
        : __data(p), __len(n) {}
};

template <class E>
constexpr const E *begin(initializer_list<E> l) noexcept { return l.begin(); }
template <class E>
constexpr const E *end(initializer_list<E> l) noexcept { return l.end(); }

}  // namespace std

#endif
