#ifndef _LIBCXX_CSTDDEF
#define _LIBCXX_CSTDDEF
#include <stddef.h>
namespace std {
using ::size_t;
using ::ptrdiff_t;
using ::max_align_t;
using nullptr_t = decltype(nullptr);
/* byte is a scoped enum, not a typedef: the point is that it does NOT
