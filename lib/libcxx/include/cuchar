/* <cuchar> — the C header's names, in namespace std as well as at
 * global scope.
 *
 * `char16_t` and `char32_t` are KEYWORDS in C++, not typedefs, so
 * there is nothing to import for them -- which is the whole reason
 * this header is shorter than <uchar.h>. */
#ifndef _LIBCXX_CUCHAR
#define _LIBCXX_CUCHAR
#include <uchar.h>

namespace std {
using ::mbstate_t;
using ::size_t;
using ::mbrtoc16;
using ::c16rtomb;
using ::mbrtoc32;
using ::c32rtomb;
}

#endif
