/* The red-black tree behind <map>, <set>, <multimap> and <multiset>.
 *
 * Not a standard header: it is the one implementation those four share,
 * which is why it exists at all. A map is this tree keyed on a pair's
 * first member; a set is this tree where the key IS the value.
 *
 * Why red-black rather than something simpler: the containers promise
 * O(log n) for every operation and, more demandingly, that an iterator
 * stays valid until its own element is erased. A tree that rebalances by
 * rebuilding, or a sorted vector, cannot keep that second promise -- and
 * it is the promise people actually rely on, because it is what lets a
 * loop erase while iterating.
 *
 * The invariant, in full, because every rotation below is justified by it:
 *
 *   1. every node is red or black;
 *   2. the root is black;
 *   3. a red node's children are black (no two reds in a row);
 *   4. every path from a node to a leaf passes the same number of black
 *      nodes.
 *
 * (3) and (4) together bound the longest path at twice the shortest, which
 * is where O(log n) comes from. Insert can only break (3); erase can only
 * break (4). That is why the two fixups look nothing alike.
 */
#ifndef _LIBCXX_TREE
#define _LIBCXX_TREE

#include <cstddef>
#include <type_traits>
#include <utility>
#include <iterator>
#include <memory>
#include <functional>

namespace std {
namespace __detail {

enum __rb_color { __rb_red, __rb_black };

template <class V>
struct __rb_node {
    __rb_node *left, *right, *parent;
    __rb_color color;
    V value;

    template <class... A>
    explicit __rb_node(A &&...a)
        : left(nullptr), right(nullptr), parent(nullptr),
          color(__rb_red), value(forward<A>(a)...) {}
};

/* In-order successor and predecessor. These are why the nodes carry a
 * parent pointer: without one, ++ would need a stack in the iterator and
 * an iterator would no longer be the size of a pointer. */
template <class N>
N *__rb_next(N *x)
{
    if (x->right) {
        x = x->right;
        while (x->left) x = x->left;
        return x;
    }
    N *p = x->parent;
    while (p && x == p->right) { x = p; p = p->parent; }
    return p;
}

template <class N>
N *__rb_prev(N *x)
{
    if (x->left) {
        x = x->left;
        while (x->right) x = x->right;
        return x;
    }
    N *p = x->parent;
    while (p && x == p->left) { x = p; p = p->parent; }
    return p;
}

/* A tree over V, with KeyOf extracting the key from a value and Cmp
 * ordering keys. `Multi` decides whether an equal key is rejected or
 * appended after its equals. */
template <class V, class Key, class KeyOf, class Cmp, bool Multi>
class __rb_tree {
public:
    using node = __rb_node<V>;

    class iterator;
    class const_iterator;

    class iterator {
    public:
        using iterator_category = bidirectional_iterator_tag;
        using value_type = V;
        using difference_type = ptrdiff_t;
        using pointer = V *;
        using reference = V &;

        iterator() : __n(nullptr) {}
        explicit iterator(node *n) : __n(n) {}

        V &operator*() const { return __n->value; }
        V *operator->() const { return addressof(__n->value); }
        iterator &operator++() { __n = __rb_next(__n); return *this; }
        iterator operator++(int) { iterator t = *this; ++*this; return t; }
        iterator &operator--() { __n = __rb_prev(__n); return *this; }
        iterator operator--(int) { iterator t = *this; --*this; return t; }
        bool operator==(const iterator &o) const { return __n == o.__n; }
        bool operator!=(const iterator &o) const { return __n != o.__n; }

        node *__node() const { return __n; }

    private:
        node *__n;
    };

    /* A const_iterator is the same walk over a const view. It converts
     * from iterator and not back, which is the whole of its job. */
    class const_iterator {
    public:
        using iterator_category = bidirectional_iterator_tag;
        using value_type = V;
        using difference_type = ptrdiff_t;
        using pointer = const V *;
        using reference = const V &;

        const_iterator() : __n(nullptr) {}
        explicit const_iterator(node *n) : __n(n) {}
        const_iterator(const iterator &i) : __n(i.__node()) {}

        const V &operator*() const { return __n->value; }
        const V *operator->() const { return addressof(__n->value); }
        const_iterator &operator++() { __n = __rb_next(__n); return *this; }
        const_iterator operator++(int)
        { const_iterator t = *this; ++*this; return t; }
        const_iterator &operator--() { __n = __rb_prev(__n); return *this; }
        const_iterator operator--(int)
        { const_iterator t = *this; --*this; return t; }
        bool operator==(const const_iterator &o) const { return __n == o.__n; }
        bool operator!=(const const_iterator &o) const { return __n != o.__n; }

        node *__node() const { return __n; }

    private:
        node *__n;
    };

    __rb_tree() : __root(nullptr), __n(0), __cmp() {}
    explicit __rb_tree(const Cmp &c) : __root(nullptr), __n(0), __cmp(c) {}

    __rb_tree(const __rb_tree &o) : __root(nullptr), __n(0), __cmp(o.__cmp)
    { for (auto it = o.begin(); it != o.end(); ++it) __insert(*it); }

    __rb_tree(__rb_tree &&o) noexcept
        : __root(o.__root), __n(o.__n), __cmp(std::move(o.__cmp))
    { o.__root = nullptr; o.__n = 0; }

    ~__rb_tree() { __destroy(__root); }

    __rb_tree &operator=(const __rb_tree &o)
    {
        if (this != addressof(o)) {
            clear();
            __cmp = o.__cmp;
            for (auto it = o.begin(); it != o.end(); ++it) __insert(*it);
        }
        return *this;
    }

    __rb_tree &operator=(__rb_tree &&o) noexcept
    {
        if (this != addressof(o)) {
            clear();
            __root = o.__root; __n = o.__n; __cmp = std::move(o.__cmp);
            o.__root = nullptr; o.__n = 0;
        }
        return *this;
    }

    /* end() is a null node, so ++ on the last element lands on it and
     * -- from it has to be special-cased. That is the price of not
     * allocating a sentinel node for an empty tree. */
    iterator begin() { return iterator(__leftmost()); }
    const_iterator begin() const { return const_iterator(__leftmost()); }
    iterator end() { return iterator(nullptr); }
    const_iterator end() const { return const_iterator(nullptr); }

    bool empty() const noexcept { return __n == 0; }
    size_t size() const noexcept { return __n; }

    void clear() { __destroy(__root); __root = nullptr; __n = 0; }

    template <class... A>
    pair<iterator, bool> emplace(A &&...a)
    {
        node *nn = new node(forward<A>(a)...);
        pair<iterator, bool> r = __attach(nn);
        if (!r.second)
            delete nn;
        return r;
    }

    pair<iterator, bool> insert(const V &v) { return emplace(v); }
    pair<iterator, bool> insert(V &&v) { return emplace(std::move(v)); }

    iterator find(const Key &k)
    {
        node *x = __root;
        while (x) {
            if (__cmp(k, KeyOf()(x->value))) x = x->left;
            else if (__cmp(KeyOf()(x->value), k)) x = x->right;
            else return iterator(x);
        }
        return end();
    }
    const_iterator find(const Key &k) const
    {
        node *x = __root;
        while (x) {
            if (__cmp(k, KeyOf()(x->value))) x = x->left;
            else if (__cmp(KeyOf()(x->value), k)) x = x->right;
            else return const_iterator(x);
        }
        return end();
    }

    size_t count(const Key &k) const
    {
        size_t c = 0;
        for (auto it = lower_bound(k); it != end() &&
             !__cmp(k, KeyOf()(*it)); ++it)
            c++;
        return c;
    }

    iterator lower_bound(const Key &k)
    {
        node *x = __root, *best = nullptr;
        while (x) {
            if (!__cmp(KeyOf()(x->value), k)) { best = x; x = x->left; }
            else x = x->right;
        }
        return iterator(best);
    }
    const_iterator lower_bound(const Key &k) const
    {
        node *x = __root, *best = nullptr;
        while (x) {
            if (!__cmp(KeyOf()(x->value), k)) { best = x; x = x->left; }
            else x = x->right;
        }
        return const_iterator(best);
    }

    iterator upper_bound(const Key &k)
    {
        node *x = __root, *best = nullptr;
        while (x) {
            if (__cmp(k, KeyOf()(x->value))) { best = x; x = x->left; }
            else x = x->right;
        }
        return iterator(best);
    }
    const_iterator upper_bound(const Key &k) const
    {
        node *x = __root, *best = nullptr;
        while (x) {
            if (__cmp(k, KeyOf()(x->value))) { best = x; x = x->left; }
            else x = x->right;
        }
        return const_iterator(best);
    }

    pair<iterator, iterator> equal_range(const Key &k)
    { return {lower_bound(k), upper_bound(k)}; }

    size_t erase(const Key &k)
    {
        size_t c = 0;
        for (;;) {
            iterator it = find(k);
            if (it == end()) break;
            erase(it);
            c++;
            if (!Multi) break;
        }
        return c;
    }

    iterator erase(iterator pos)
    {
        node *z = pos.__node();
        iterator nx(__rb_next(z));
        __detach(z);
        delete z;
        --__n;
        return nx;
    }

    void swap(__rb_tree &o) noexcept
    {
        using std::swap;
        swap(__root, o.__root);
        swap(__n, o.__n);
        swap(__cmp, o.__cmp);
    }

    Cmp __comparator() const { return __cmp; }

    /* For the tests: every invariant, checked. A tree that is merely
     * "sorted and works" can be arbitrarily unbalanced and still pass
     * every functional test, so the properties are asserted directly. */
    bool __check() const
    {
        if (__root && __root->color != __rb_black)
            return false;                           /* (2) */
        int bh = -1;
        return __check_node(__root, 0, bh);
    }

private:
    node *__root;
    size_t __n;
    Cmp __cmp;

    node *__leftmost() const
    {
        node *x = __root;
        if (!x) return nullptr;
        while (x->left) x = x->left;
        return x;
    }

    void __destroy(node *x)
    {
        while (x) {
            __destroy(x->left);
            node *r = x->right;
            delete x;
            x = r;
        }
    }

    bool __check_node(node *x, int black, int &bh) const
    {
        if (!x) {
            if (bh < 0) bh = black;
            return bh == black;                     /* (4) */
        }
        if (x->color == __rb_red) {
            if ((x->left && x->left->color == __rb_red) ||
                (x->right && x->right->color == __rb_red))
                return false;                       /* (3) */
        } else {
            black++;
        }
        if (x->left && x->left->parent != x) return false;
        if (x->right && x->right->parent != x) return false;
        return __check_node(x->left, black, bh) &&
               __check_node(x->right, black, bh);
    }

    void __rotate_left(node *x)
    {
        node *y = x->right;
        x->right = y->left;
        if (y->left) y->left->parent = x;
        y->parent = x->parent;
        if (!x->parent) __root = y;
        else if (x == x->parent->left) x->parent->left = y;
        else x->parent->right = y;
        y->left = x;
        x->parent = y;
    }

    void __rotate_right(node *x)
    {
        node *y = x->left;
        x->left = y->right;
        if (y->right) y->right->parent = x;
        y->parent = x->parent;
        if (!x->parent) __root = y;
        else if (x == x->parent->right) x->parent->right = y;
        else x->parent->left = y;
        y->right = x;
        x->parent = y;
    }

    pair<iterator, bool> __attach(node *z)
    {
        node *y = nullptr, *x = __root;
        const Key &k = KeyOf()(z->value);
        while (x) {
            y = x;
            if (__cmp(k, KeyOf()(x->value))) x = x->left;
            else if (Multi) x = x->right;
            else if (__cmp(KeyOf()(x->value), k)) x = x->right;
            else return {iterator(x), false};        /* already present */
        }
        z->parent = y;
        if (!y) __root = z;
        else if (__cmp(k, KeyOf()(y->value))) y->left = z;
        else y->right = z;
        z->color = __rb_red;                         /* always, then fix */
        __insert_fix(z);
        ++__n;
        return {iterator(z), true};
    }

    /* A new node is RED, so only rule (3) can be broken -- never (4),
     * which is why nothing here counts black heights. The three cases are
     * on the UNCLE: red means recolour and carry the problem up two
     * levels; black means one or two rotations end it for good. */
    void __insert_fix(node *z)
    {
        while (z->parent && z->parent->color == __rb_red) {
            node *p = z->parent, *g = p->parent;
            if (!g) break;
            if (p == g->left) {
                node *u = g->right;
                if (u && u->color == __rb_red) {
                    p->color = __rb_black; u->color = __rb_black;
                    g->color = __rb_red;
                    z = g;                            /* carry upward */
                } else {
                    if (z == p->right) { z = p; __rotate_left(z); p = z->parent; }
                    p->color = __rb_black;
                    g->color = __rb_red;
                    __rotate_right(g);
                    break;
                }
            } else {
                node *u = g->left;
                if (u && u->color == __rb_red) {
                    p->color = __rb_black; u->color = __rb_black;
                    g->color = __rb_red;
                    z = g;
                } else {
                    if (z == p->left) { z = p; __rotate_right(z); p = z->parent; }
                    p->color = __rb_black;
                    g->color = __rb_red;
                    __rotate_left(g);
                    break;
                }
            }
        }
        __root->color = __rb_black;                   /* (2), always safe */
    }

    void __transplant(node *u, node *v)
    {
        if (!u->parent) __root = v;
        else if (u == u->parent->left) u->parent->left = v;
        else u->parent->right = v;
        if (v) v->parent = u->parent;
    }

    /* Removing a BLACK node takes one black off every path through it,
     * breaking (4) -- so the fixup's job is to put one back, and it is the
     * harder of the two. The "doubly black" node is carried up until a
     * red can be recoloured black or the root is reached. */
    void __detach(node *z)
    {
        node *y = z, *x = nullptr, *xp = nullptr;
        __rb_color ycolor = y->color;
        if (!z->left) {
            x = z->right; xp = z->parent;
            __transplant(z, z->right);
        } else if (!z->right) {
            x = z->left; xp = z->parent;
            __transplant(z, z->left);
        } else {
            /* Two children: the successor takes z's place. Its VALUE is
             * not copied -- the nodes are relinked -- because an iterator
             * to the successor must stay valid, which copying would
             * silently break. */
            y = z->right;
            while (y->left) y = y->left;
            ycolor = y->color;
            x = y->right;
            if (y->parent == z) {
                xp = y;
                if (x) x->parent = y;
            } else {
                xp = y->parent;
                __transplant(y, y->right);
                y->right = z->right;
                y->right->parent = y;
            }
            __transplant(z, y);
            y->left = z->left;
            y->left->parent = y;
            y->color = z->color;
        }
        if (ycolor == __rb_black)
            __erase_fix(x, xp);
    }

    void __erase_fix(node *x, node *xp)
    {
        while (x != __root && (!x || x->color == __rb_black)) {
            if (!xp) break;
            if (x == xp->left) {
                node *w = xp->right;
                if (w && w->color == __rb_red) {
                    w->color = __rb_black; xp->color = __rb_red;
                    __rotate_left(xp);
                    w = xp->right;
                }
                if (!w) { x = xp; xp = xp->parent; continue; }
                if ((!w->left || w->left->color == __rb_black) &&
                    (!w->right || w->right->color == __rb_black)) {
                    w->color = __rb_red;
                    x = xp; xp = xp->parent;          /* carry upward */
                } else {
                    if (!w->right || w->right->color == __rb_black) {
                        if (w->left) w->left->color = __rb_black;
                        w->color = __rb_red;
                        __rotate_right(w);
                        w = xp->right;
                    }
                    w->color = xp->color;
                    xp->color = __rb_black;
                    if (w->right) w->right->color = __rb_black;
                    __rotate_left(xp);
                    x = __root; xp = nullptr;
                }
            } else {
                node *w = xp->left;
                if (w && w->color == __rb_red) {
                    w->color = __rb_black; xp->color = __rb_red;
                    __rotate_right(xp);
                    w = xp->left;
                }
                if (!w) { x = xp; xp = xp->parent; continue; }
                if ((!w->left || w->left->color == __rb_black) &&
                    (!w->right || w->right->color == __rb_black)) {
                    w->color = __rb_red;
                    x = xp; xp = xp->parent;
                } else {
                    if (!w->left || w->left->color == __rb_black) {
                        if (w->right) w->right->color = __rb_black;
                        w->color = __rb_red;
                        __rotate_left(w);
                        w = xp->left;
                    }
                    w->color = xp->color;
                    xp->color = __rb_black;
                    if (w->left) w->left->color = __rb_black;
                    __rotate_right(xp);
                    x = __root; xp = nullptr;
                }
            }
        }
        if (x) x->color = __rb_black;
    }

    pair<iterator, bool> __insert(const V &v) { return emplace(v); }
};

}  // namespace __detail
}  // namespace std

#endif
