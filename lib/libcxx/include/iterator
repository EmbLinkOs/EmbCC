/* <iterator> — C++ [iterators].
 *
 * The vocabulary that lets one algorithm work on a pointer, a list node
 * and an input stream. Almost none of it generates code: the tags are
 * empty types whose only job is to be overloaded on, which is how
 * `advance` costs one addition on a vector and a loop on a list without
 * either caller knowing.
 */
#ifndef _LIBCXX_ITERATOR
#define _LIBCXX_ITERATOR

#include <cstddef>
#include <type_traits>

namespace std {

/* The tags form a hierarchy by INHERITANCE, not by a number, so that
 * overload resolution picks the most refined applicable one and a new
 * category can be added without renumbering anything. */
struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : input_iterator_tag {};
struct bidirectional_iterator_tag : forward_iterator_tag {};
struct random_access_iterator_tag : bidirectional_iterator_tag {};
struct contiguous_iterator_tag : random_access_iterator_tag {};

/* iterator_traits is SFINAE-friendly: applied to a type that is not an
 * iterator it must be EMPTY, not an error, because generic code asks
 * about types that may not be iterators and then chooses another
 * overload. A version that names the members unconditionally turns that
 * question into a hard error in a place the caller cannot see. */
namespace __detail {
template <class T, class = void> struct __iter_traits {};
template <class T>
struct __iter_traits<T, void_t<typename T::iterator_category,
                               typename T::value_type,
                               typename T::difference_type,
                               typename T::pointer,
                               typename T::reference>> {
    using iterator_category = typename T::iterator_category;
    using value_type = typename T::value_type;
    using difference_type = typename T::difference_type;
    using pointer = typename T::pointer;
    using reference = typename T::reference;
};
}

template <class T> struct iterator_traits : __detail::__iter_traits<T> {};

/* A pointer is an iterator, and is where the contiguous tag comes from. */
template <class T>
struct iterator_traits<T *> {
    using iterator_category = random_access_iterator_tag;
    using iterator_concept = contiguous_iterator_tag;
    using value_type = remove_cv_t<T>;
    using difference_type = ptrdiff_t;
    using pointer = T *;
    using reference = T &;
};

template <class I>
using iter_value_t = typename iterator_traits<I>::value_type;
template <class I>
using iter_difference_t = typename iterator_traits<I>::difference_type;
template <class I>
using iter_reference_t = typename iterator_traits<I>::reference;
template <class I>
using iter_category_t = typename iterator_traits<I>::iterator_category;

namespace __detail {
template <class I, class Tag, class = void>
struct __is_cat : false_type {};
template <class I, class Tag>
struct __is_cat<I, Tag, void_t<iter_category_t<I>>>
    : bool_constant<__is_base_of(Tag, iter_category_t<I>)> {};
}

/* ---- advance / distance / next / prev ---------------------------------
 * The dispatch is the point. A random-access iterator moves in one
 * addition; anything else has to step. Writing the loop unconditionally
 * turns `advance(it, 1000000)` on a vector into a million increments,
 * and writing the addition unconditionally does not compile for a list.
 */
template <class I, class D>
constexpr void advance(I &i, D n)
{
    if constexpr (__detail::__is_cat<I, random_access_iterator_tag>::value) {
        i += static_cast<iter_difference_t<I>>(n);
    } else {
        auto k = static_cast<iter_difference_t<I>>(n);
        for (; k > 0; --k)
            ++i;
        if constexpr (__detail::__is_cat<I, bidirectional_iterator_tag>::value)
            for (; k < 0; ++k)
                --i;
    }
}

template <class I>
constexpr iter_difference_t<I> distance(I first, I last)
{
    if constexpr (__detail::__is_cat<I, random_access_iterator_tag>::value) {
        return last - first;
    } else {
        iter_difference_t<I> n = 0;
        for (; first != last; ++first)
            ++n;
        return n;
    }
}

template <class I>
constexpr I next(I i, iter_difference_t<I> n = 1)
{ advance(i, n); return i; }

template <class I>
constexpr I prev(I i, iter_difference_t<I> n = 1)
{ advance(i, -n); return i; }

/* ---- reverse_iterator --------------------------------------------------
 * The off-by-one here is deliberate and is the whole design: a reverse
 * iterator holds the base iterator one PAST the element it refers to, so
 * that `rend()` can be `begin()` -- an iterator that would otherwise have
 * to point before the first element, which is not a thing a pointer may
 * do. Every member pays for it once, in the copy-and-decrement below.
 */
template <class I>
class reverse_iterator {
public:
    using iterator_type = I;
    using iterator_category = iter_category_t<I>;
    using value_type = iter_value_t<I>;
    using difference_type = iter_difference_t<I>;
    using pointer = typename iterator_traits<I>::pointer;
    using reference = iter_reference_t<I>;

    constexpr reverse_iterator() : __cur() {}
    constexpr explicit reverse_iterator(I i) : __cur(i) {}
    template <class U>
    constexpr reverse_iterator(const reverse_iterator<U> &o)
        : __cur(o.base()) {}

    constexpr I base() const { return __cur; }

    constexpr reference operator*() const { I t = __cur; return *--t; }
    constexpr pointer operator->() const { I t = __cur; --t; return &*t; }

    constexpr reverse_iterator &operator++() { --__cur; return *this; }
    constexpr reverse_iterator operator++(int)
    { reverse_iterator t = *this; --__cur; return t; }
    constexpr reverse_iterator &operator--() { ++__cur; return *this; }
    constexpr reverse_iterator operator--(int)
    { reverse_iterator t = *this; ++__cur; return t; }

    constexpr reverse_iterator operator+(difference_type n) const
    { return reverse_iterator(__cur - n); }
    constexpr reverse_iterator &operator+=(difference_type n)
    { __cur -= n; return *this; }
    constexpr reverse_iterator operator-(difference_type n) const
    { return reverse_iterator(__cur + n); }
    constexpr reverse_iterator &operator-=(difference_type n)
    { __cur += n; return *this; }
    constexpr reference operator[](difference_type n) const
    { return *(*this + n); }

protected:
    I __cur;
};

/* The comparisons invert, because the bases run the other way. */
template <class A, class B>
constexpr bool operator==(const reverse_iterator<A> &x,
                          const reverse_iterator<B> &y)
{ return x.base() == y.base(); }
template <class A, class B>
constexpr bool operator!=(const reverse_iterator<A> &x,
                          const reverse_iterator<B> &y)
{ return x.base() != y.base(); }
template <class A, class B>
constexpr bool operator<(const reverse_iterator<A> &x,
                         const reverse_iterator<B> &y)
{ return x.base() > y.base(); }
template <class A, class B>
constexpr bool operator>(const reverse_iterator<A> &x,
                         const reverse_iterator<B> &y)
{ return x.base() < y.base(); }
template <class A, class B>
constexpr bool operator<=(const reverse_iterator<A> &x,
                          const reverse_iterator<B> &y)
{ return x.base() >= y.base(); }
template <class A, class B>
constexpr bool operator>=(const reverse_iterator<A> &x,
                          const reverse_iterator<B> &y)
{ return x.base() <= y.base(); }
template <class A, class B>
constexpr auto operator-(const reverse_iterator<A> &x,
                         const reverse_iterator<B> &y)
    -> decltype(y.base() - x.base())
{ return y.base() - x.base(); }
template <class I>
constexpr reverse_iterator<I>
operator+(typename reverse_iterator<I>::difference_type n,
          const reverse_iterator<I> &x)
{ return x + n; }

template <class I>
constexpr reverse_iterator<I> make_reverse_iterator(I i)
{ return reverse_iterator<I>(i); }

/* ---- move_iterator ------------------------------------------------------
 * Dereferences to an rvalue, so an algorithm written with = moves instead
 * of copying without the algorithm knowing anything about it. */
template <class I>
class move_iterator {
public:
    using iterator_type = I;
    using iterator_category = iter_category_t<I>;
    using value_type = iter_value_t<I>;
    using difference_type = iter_difference_t<I>;
    using pointer = I;
    using reference = value_type &&;

    constexpr move_iterator() : __cur() {}
    constexpr explicit move_iterator(I i) : __cur(i) {}
    constexpr I base() const { return __cur; }
    constexpr reference operator*() const
    { return static_cast<reference>(*__cur); }
    constexpr move_iterator &operator++() { ++__cur; return *this; }
    constexpr move_iterator operator++(int)
    { move_iterator t = *this; ++__cur; return t; }
    constexpr move_iterator &operator--() { --__cur; return *this; }
    constexpr move_iterator operator+(difference_type n) const
    { return move_iterator(__cur + n); }
    constexpr move_iterator operator-(difference_type n) const
    { return move_iterator(__cur - n); }

private:
    I __cur;
};

template <class A, class B>
constexpr bool operator==(const move_iterator<A> &x, const move_iterator<B> &y)
{ return x.base() == y.base(); }
template <class A, class B>
constexpr bool operator!=(const move_iterator<A> &x, const move_iterator<B> &y)
{ return x.base() != y.base(); }
template <class A, class B>
constexpr auto operator-(const move_iterator<A> &x, const move_iterator<B> &y)
    -> decltype(x.base() - y.base())
{ return x.base() - y.base(); }

template <class I>
constexpr move_iterator<I> make_move_iterator(I i)
{ return move_iterator<I>(i); }

/* ---- the insert iterators -----------------------------------------------
 *
 * An OUTPUT iterator that grows its container instead of overwriting
 * it, and the trick is the same in all three: `*it = v` does the work.
 * `operator*` returns the iterator itself, `operator=` calls
 * push_back/push_front/insert, and `++` does nothing at all.
 *
 * That is what lets `copy(a.begin(), a.end(), back_inserter(b))` work.
 * Without it the destination has to be sized first -- and `copy` into
 * an empty vector is the single most common way to write out of
 * bounds, because nothing in `copy`'s signature says the destination
 * must already be big enough.
 *
 * Note which operation each uses: a vector has push_back and no
 * push_front, a forward_list the reverse, and a set neither. The three
 * classes exist because the three containers do different things, not
 * as a convenience.
 */
template <class C>
class back_insert_iterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type = void;
    using difference_type = ptrdiff_t;
    using pointer = void;
    using reference = void;
    using container_type = C;

    explicit back_insert_iterator(C &c) : __c(&c) {}

    back_insert_iterator &operator=(const typename C::value_type &v)
    { __c->push_back(v); return *this; }
    back_insert_iterator &operator=(typename C::value_type &&v)
    { __c->push_back(static_cast<typename C::value_type &&>(v)); return *this; }

    /* The three no-ops. `*it` is the iterator so that `*it = v` lands
     * on operator= above; `++` has nothing to advance past, because
     * the insertion already moved the end. */
    back_insert_iterator &operator*() { return *this; }
    back_insert_iterator &operator++() { return *this; }
    back_insert_iterator operator++(int) { return *this; }

protected:
    C *__c;
};

template <class C>
back_insert_iterator<C> back_inserter(C &c)
{ return back_insert_iterator<C>(c); }

template <class C>
class front_insert_iterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type = void;
    using difference_type = ptrdiff_t;
    using pointer = void;
    using reference = void;
    using container_type = C;

    explicit front_insert_iterator(C &c) : __c(&c) {}

    /* Each insertion goes in front of the last, so a sequence copied
     * through this arrives REVERSED. That is not a flaw to work around
     * -- it is occasionally the reason to use it. */
    front_insert_iterator &operator=(const typename C::value_type &v)
    { __c->push_front(v); return *this; }
    front_insert_iterator &operator=(typename C::value_type &&v)
    { __c->push_front(static_cast<typename C::value_type &&>(v)); return *this; }

    front_insert_iterator &operator*() { return *this; }
    front_insert_iterator &operator++() { return *this; }
    front_insert_iterator operator++(int) { return *this; }

protected:
    C *__c;
};

template <class C>
front_insert_iterator<C> front_inserter(C &c)
{ return front_insert_iterator<C>(c); }

template <class C>
class insert_iterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type = void;
    using difference_type = ptrdiff_t;
    using pointer = void;
    using reference = void;
    using container_type = C;

    insert_iterator(C &c, typename C::iterator i) : __c(&c), __i(i) {}

    /* The stored position is ADVANCED past each insertion, so a
     * sequence arrives in its own order. Keeping the original position
     * would insert each element before the last and reverse them --
     * and would also dangle, since insert can invalidate it. */
    insert_iterator &operator=(const typename C::value_type &v)
    { __i = __c->insert(__i, v); ++__i; return *this; }
    insert_iterator &operator=(typename C::value_type &&v)
    {
        __i = __c->insert(__i, static_cast<typename C::value_type &&>(v));
        ++__i;
        return *this;
    }

    insert_iterator &operator*() { return *this; }
    insert_iterator &operator++() { return *this; }
    insert_iterator &operator++(int) { return *this; }

protected:
    C *__c;
    typename C::iterator __i;
};

template <class C, class I>
insert_iterator<C> inserter(C &c, I i)
{ return insert_iterator<C>(c, i); }

/* ---- the range access functions -----------------------------------------
 * Free functions rather than members so that a C ARRAY is a range too --
 * which is what lets `for (auto &x : arr)` work on one. */
template <class C> constexpr auto begin(C &c) -> decltype(c.begin())
{ return c.begin(); }
template <class C> constexpr auto begin(const C &c) -> decltype(c.begin())
{ return c.begin(); }
template <class C> constexpr auto end(C &c) -> decltype(c.end())
{ return c.end(); }
template <class C> constexpr auto end(const C &c) -> decltype(c.end())
{ return c.end(); }
template <class T, size_t N> constexpr T *begin(T (&a)[N]) noexcept
{ return a; }
template <class T, size_t N> constexpr T *end(T (&a)[N]) noexcept
{ return a + N; }

template <class C> constexpr auto cbegin(const C &c) -> decltype(begin(c))
{ return begin(c); }
template <class C> constexpr auto cend(const C &c) -> decltype(end(c))
{ return end(c); }

template <class C> constexpr auto rbegin(C &c) -> decltype(c.rbegin())
{ return c.rbegin(); }
template <class C> constexpr auto rend(C &c) -> decltype(c.rend())
{ return c.rend(); }
template <class T, size_t N>
constexpr reverse_iterator<T *> rbegin(T (&a)[N])
{ return reverse_iterator<T *>(a + N); }
template <class T, size_t N>
constexpr reverse_iterator<T *> rend(T (&a)[N])
{ return reverse_iterator<T *>(a); }

template <class C> constexpr auto size(const C &c) -> decltype(c.size())
{ return c.size(); }
template <class T, size_t N> constexpr size_t size(const T (&)[N]) noexcept
{ return N; }
/* Signed, because it exists to be compared with a difference_type and the
 * whole point is not to convert one of them. */
template <class C>
constexpr auto ssize(const C &c)
    -> common_type_t<ptrdiff_t, make_signed_t<decltype(c.size())>>
{
    using R = common_type_t<ptrdiff_t, make_signed_t<decltype(c.size())>>;
    return static_cast<R>(c.size());
}
template <class T, ptrdiff_t N>
constexpr ptrdiff_t ssize(const T (&)[N]) noexcept { return N; }

template <class C> constexpr auto empty(const C &c) -> decltype(c.empty())
{ return c.empty(); }
template <class T, size_t N> constexpr bool empty(const T (&)[N]) noexcept
{ return false; }

template <class C> constexpr auto data(C &c) -> decltype(c.data())
{ return c.data(); }
template <class C> constexpr auto data(const C &c) -> decltype(c.data())
{ return c.data(); }
template <class T, size_t N> constexpr T *data(T (&a)[N]) noexcept
{ return a; }

}  // namespace std

#endif
