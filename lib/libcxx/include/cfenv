/* <cfenv> — the C header's names, in namespace std as well as at
 * global scope.
 *
 * The caution from <fenv.h> applies here too, and more sharply: a
 * program that changes the rounding direction without
 * `#pragma STDC FENV_ACCESS ON` has undefined behaviour, because the
 * compiler may have folded an expression at compile time in the
 * default direction. C++ inherits the rule and adds no way around it. */
#ifndef _LIBCXX_CFENV
#define _LIBCXX_CFENV
#include <fenv.h>

namespace std {
using ::fenv_t;
using ::fexcept_t;
using ::feclearexcept;
using ::fetestexcept;
using ::feraiseexcept;
using ::fegetexceptflag;
using ::fesetexceptflag;
using ::fegetround;
using ::fesetround;
using ::fegetenv;
using ::fesetenv;
using ::feholdexcept;
using ::feupdateenv;
}

#endif
