/* <cctype> — the C header's names, in namespace std as well as at
 * global scope. C++ requires the std:: spellings; every real
 * implementation also leaves the global ones, and code depends on it. */
#ifndef _LIBCXX_CCTYPE
#define _LIBCXX_CCTYPE
#include <ctype.h>

namespace std {
using ::isalnum;
using ::isalpha;
using ::isblank;
using ::iscntrl;
using ::isdigit;
using ::isgraph;
using ::islower;
using ::isprint;
using ::ispunct;
using ::isspace;
using ::isupper;
using ::isxdigit;
using ::tolower;
using ::toupper;
}

#endif
