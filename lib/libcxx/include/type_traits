/* unwrap_reference / unwrap_ref_decay live here rather than beside
 * reference_wrapper, because [meta.trans.other] puts them here and
 * because <tuple> needs them without wanting <functional>. The class
 * itself is only forward-declared: these traits need its NAME, not its
 * definition. */
template <class T> class reference_wrapper;

template <class T> struct unwrap_reference { using type = T; };
template <class T> struct unwrap_reference<reference_wrapper<T>>
{ using type = T &; };
template <class T> using unwrap_reference_t = typename unwrap_reference<T>::type;

/* ---- transformations --------------------------------------------------- */

template <class T> struct underlying_type { using type = __underlying_type(T); };
template <class T> using underlying_type_t = __underlying_type(T);

/* decay: what a by-value parameter does to its argument's type. An array
 * becomes a pointer to its first element, a function becomes a function
 * pointer, and everything else loses its references and cv-qualifiers.
 * The order matters -- strip the reference first, then decide. */
template <class T>
struct decay {
private:
    using U = __remove_reference(T);
public:
    using type = conditional_t<__is_array(U), remove_extent_t<U> *,
                 conditional_t<__is_function(U), add_pointer_t<U>,
                               __remove_cv(U)>>;
};
template <class T> using decay_t = typename decay<T>::type;

template <class T>
struct unwrap_ref_decay : unwrap_reference<decay_t<T>> {};
template <class T>
using unwrap_ref_decay_t = typename unwrap_ref_decay<T>::type;

/* common_type: the type a conditional expression over the arguments would
 * have. The two-argument case is the one that does the work, and the
 * variadic case folds it. */
template <class...> struct common_type {};
template <class T> struct common_type<T> : common_type<T, T> {};
template <class T, class U>
struct common_type<T, U> {
    using type = decay_t<decltype(true ? declval<decay_t<T>>()
                                       : declval<decay_t<U>>())>;
};
template <class T, class U, class... R>
struct common_type<T, U, R...>
    : common_type<typename common_type<T, U>::type, R...> {};
template <class... T> using common_type_t = typename common_type<T...>::type;

/* ---- common_reference --------------------------------------------------
 *
 * common_type with the references KEPT, and the distinction matters far
 * more than the name suggests. `common_type_t<const T &, const T &>` is
 * `T` -- it decays, which is a COPY -- so a trait built on it says a
 * non-copyable type has no common type with itself, and every concept
 * resting on that (assignable_from, movable) silently rejects it.
 * `common_reference_t<const T &, const T &>` is `const T &`: nothing is
 * copied and the question is answerable for any type at all.
 *
 * The rule doing the work is the standard's COND-RES: the type of a
 * conditional expression over two expressions of the given value
 * categories. Calling a reference-to-function returning T is the
 * standard trick for producing an expression of exactly type T with
 * exactly T's value category -- a prvalue for T, an lvalue for T &, an
 * xvalue for T && -- which `declval<T>()` cannot do, since it is always
 * an xvalue.
 *
 * This implements the reference-preserving cases and falls back to
 * common_type for the rest. The full [meta.trans.other] algorithm also
 * consults basic_common_reference, a customization point nothing here
 * specializes; it is left out rather than half-written.
 */
namespace __detail {
template <class T, class U>
using __cond_res =
    decltype(false ? declval<T (&)()>()() : declval<U (&)()>()());

template <class T, class U, class = void>
struct __common_ref2 : common_type<T, U> {};
template <class T, class U>
struct __common_ref2<T, U, void_t<__cond_res<T, U>>> {
    using type = __cond_res<T, U>;
};
}

template <class...> struct common_reference {};
template <> struct common_reference<> {};
template <class T> struct common_reference<T> { using type = T; };
template <class T, class U>
struct common_reference<T, U> : __detail::__common_ref2<T, U> {};
template <class T, class U, class... R>
struct common_reference<T, U, R...>
    : common_reference<typename common_reference<T, U>::type, R...> {};
template <class... T>
using common_reference_t = typename common_reference<T...>::type;

/* make_signed / make_unsigned map within the integer types of the same
 * size, and carry the cv-qualifiers across. bool is excluded by the
 * standard: it has no signed counterpart. */
namespace __detail {
template <class T> struct __mk_unsigned { using type = T; };
template <> struct __mk_unsigned<char> { using type = unsigned char; };
template <> struct __mk_unsigned<signed char> { using type = unsigned char; };
template <> struct __mk_unsigned<short> { using type = unsigned short; };
template <> struct __mk_unsigned<int> { using type = unsigned int; };
template <> struct __mk_unsigned<long> { using type = unsigned long; };
template <> struct __mk_unsigned<long long> { using type = unsigned long long; };
template <> struct __mk_unsigned<__int128_t> { using type = __uint128_t; };

template <class T> struct __mk_signed { using type = T; };
template <> struct __mk_signed<char> { using type = signed char; };
template <> struct __mk_signed<unsigned char> { using type = signed char; };
template <> struct __mk_signed<unsigned short> { using type = short; };
template <> struct __mk_signed<unsigned int> { using type = int; };
template <> struct __mk_signed<unsigned long> { using type = long; };
template <> struct __mk_signed<unsigned long long> { using type = long long; };
template <> struct __mk_signed<__uint128_t> { using type = __int128_t; };

/* The cv-qualifiers have to be put back on: make_unsigned_t<const int> is
 * `const unsigned int`, not `unsigned int`. */
template <class T, class R> struct __requal { using type = R; };
template <class T, class R> struct __requal<const T, R> { using type = const R; };
template <class T, class R> struct __requal<volatile T, R> { using type = volatile R; };
template <class T, class R> struct __requal<const volatile T, R>
{ using type = const volatile R; };
}

template <class T>
struct make_unsigned {
    using type = typename __detail::__requal<T,
        typename __detail::__mk_unsigned<__remove_cv(T)>::type>::type;
};
template <class T> using make_unsigned_t = typename make_unsigned<T>::type;
template <class T>
struct make_signed {
    using type = typename __detail::__requal<T,
        typename __detail::__mk_signed<__remove_cv(T)>::type>::type;
};
template <class T> using make_signed_t = typename make_signed<T>::type;

/* ---- array extents ----------------------------------------------------- */

template <class T> struct rank : integral_constant<size_t, 0> {};
template <class T> struct rank<T[]> : integral_constant<size_t, rank<T>::value + 1> {};
template <class T, size_t N>
struct rank<T[N]> : integral_constant<size_t, rank<T>::value + 1> {};
template <class T> inline constexpr size_t rank_v = rank<T>::value;

template <class T, unsigned I = 0> struct extent : integral_constant<size_t, 0> {};
template <class T> struct extent<T[], 0> : integral_constant<size_t, 0> {};
template <class T, unsigned I>
struct extent<T[], I> : extent<T, I - 1> {};
template <class T, size_t N>
struct extent<T[N], 0> : integral_constant<size_t, N> {};
template <class T, size_t N, unsigned I>
struct extent<T[N], I> : extent<T, I - 1> {};
template <class T, unsigned I = 0>
inline constexpr size_t extent_v = extent<T, I>::value;

/* ---- logical operations on traits --------------------------------------
 * conjunction and disjunction SHORT-CIRCUIT, and that is their whole
 * purpose: `conjunction_v<is_class<T>, is_base_of<B, T>>` must not
 * instantiate the second trait when T is not a class. A plain `&&` of two
 * ::value expressions instantiates both. */
template <class...> struct conjunction : true_type {};
template <class B> struct conjunction<B> : B {};
template <class B, class... R>
struct conjunction<B, R...>
    : conditional_t<bool(B::value), conjunction<R...>, B> {};
template <class... B> inline constexpr bool conjunction_v = conjunction<B...>::value;

template <class...> struct disjunction : false_type {};
template <class B> struct disjunction<B> : B {};
template <class B, class... R>
struct disjunction<B, R...>
    : conditional_t<bool(B::value), B, disjunction<R...>> {};
template <class... B> inline constexpr bool disjunction_v = disjunction<B...>::value;

template <class B> struct negation : bool_constant<!bool(B::value)> {};
template <class B> inline constexpr bool negation_v = negation<B>::value;

/* ---- alignment and storage ---------------------------------------------- */

template <class T> struct alignment_of : integral_constant<size_t, alignof(T)> {};
template <class T> inline constexpr size_t alignment_of_v = alignof(T);

template <size_t Len, size_t Align = alignof(max_align_t)>
struct aligned_storage {
    struct type { alignas(Align) unsigned char __data[Len]; };
};
template <size_t Len, size_t Align = alignof(max_align_t)>
using aligned_storage_t = typename aligned_storage<Len, Align>::type;

/* ---- invocability -------------------------------------------------------
 * The heart of it is INVOKE ([func.require]), and a callable is not only a
 * function: a pointer to member called on an object, on a reference to
 * one, or through a pointer to one are three different EXPRESSIONS that
 * all mean "call it", and generic code must not have to know which.
 *
 * Each form is detected with its own expression, rather than all of them
 * through one helper function. That is not the shortest way to write it --
 * libstdc++ detects `__invoke(...)` once -- but detecting through a
 * function template whose own return type is deduced asks the compiler to
 * do SFINAE two levels deep during partial-specialisation matching, and
 * EmbCC does not do that yet (docs/developer/todo.md). Written this way it
 * asks only for what plainly works, and each form's requirement is visible
 * instead of hidden inside an overload set.
 */
namespace __detail {

/* declval, but plainly. std::declval is SFINAE-friendly for void, which it
 * gets by going through decltype of a function call -- and the detections
 * below must not ask the compiler to see through that as well as through
 * their own. None of them is ever applied to void. */
template <class T> T &&__dv() noexcept;

/* The class a pointer-to-member points into. */
template <class T> struct __memptr_class {};
template <class R, class C> struct __memptr_class<R C::*> { using type = C; };

/* f(a...) */
template <class V, class F, class... A> struct __ir_call {};
template <class F, class... A>
struct __ir_call<void_t<decltype(__dv<F>()(__dv<A>()...))>, F, A...> {
    using type = decltype(__dv<F>()(__dv<A>()...));
};

/* (o.*f)(a...) -- o is the object, or a reference to it */
template <class V, class F, class O, class... A> struct __ir_mf_obj {};
template <class F, class O, class... A>
struct __ir_mf_obj<void_t<decltype((__dv<O>().*__dv<F>())(
                                       __dv<A>()...))>, F, O, A...> {
    using type = decltype((__dv<O>().*__dv<F>())(__dv<A>()...));
};

/* ((*o).*f)(a...) -- o is a pointer, or anything that dereferences */
template <class V, class F, class O, class... A> struct __ir_mf_ptr {};
template <class F, class O, class... A>
struct __ir_mf_ptr<void_t<decltype(((*__dv<O>()).*__dv<F>())(
                                       __dv<A>()...))>, F, O, A...> {
    using type = decltype(((*__dv<O>()).*__dv<F>())(__dv<A>()...));
};

/* o.*f and (*o).*f -- a data member takes no arguments */
template <class V, class F, class O> struct __ir_mo_obj {};
template <class F, class O>
struct __ir_mo_obj<void_t<decltype(__dv<O>().*__dv<F>())>, F, O> {
    using type = decltype(__dv<O>().*__dv<F>());
};
template <class V, class F, class O> struct __ir_mo_ptr {};
template <class F, class O>
struct __ir_mo_ptr<void_t<decltype((*__dv<O>()).*__dv<F>())>, F, O> {
    using type = decltype((*__dv<O>()).*__dv<F>());
};

/* Which form applies. conditional_t NAMES one of the two without
 * instantiating either; inheriting from the answer instantiates only the
 * one chosen, so the form that does not apply is never even formed. */
template <class F, class... A> struct __ir_sel : __ir_call<void, F, A...> {};

template <class F, class O, class... A>
struct __ir_sel_mem
    : conditional_t<__is_base_of(typename __memptr_class<__remove_cvref(F)>::type,
                                 decay_t<O>),
                    __ir_mf_obj<void, F, O, A...>,
                    __ir_mf_ptr<void, F, O, A...>> {};

template <class F, class O>
struct __ir_sel_mem_obj
    : conditional_t<__is_base_of(typename __memptr_class<__remove_cvref(F)>::type,
                                 decay_t<O>),
                    __ir_mo_obj<void, F, O>,
                    __ir_mo_ptr<void, F, O>> {};

template <bool IsMemPtr, class F, class... A> struct __ir_pick;
template <class F, class... A>
struct __ir_pick<false, F, A...> : __ir_call<void, F, A...> {};
template <class F, class O, class... A>
struct __ir_pick<true, F, O, A...>
    : conditional_t<__is_member_function_pointer(__remove_cvref(F)),
                    __ir_sel_mem<F, O, A...>,
                    __ir_sel_mem_obj<F, O>> {};
/* A member pointer with no object to apply it to is not invocable. */
template <class F> struct __ir_pick<true, F> {};

}  // namespace __detail

template <class F, class... A>
struct invoke_result
    : __detail::__ir_pick<__is_member_pointer(__remove_cvref(F)), F, A...> {};
template <class F, class... A>
using invoke_result_t = typename invoke_result<F, A...>::type;

namespace __detail {
template <class V, class F, class... A> struct __is_invocable : false_type {};
template <class F, class... A>
struct __is_invocable<void_t<typename invoke_result<F, A...>::type>, F, A...>
    : true_type {};
}
template <class F, class... A>
struct is_invocable : __detail::__is_invocable<void, F, A...> {};
template <class F, class... A>
inline constexpr bool is_invocable_v = is_invocable<F, A...>::value;

template <class R, class F, class... A>
struct is_invocable_r
    : bool_constant<is_invocable_v<F, A...> &&
                    (is_void_v<R> ||
                     __is_convertible(invoke_result_t<F, A...>, R))> {};
template <class R, class F, class... A>
inline constexpr bool is_invocable_r_v = is_invocable_r<R, F, A...>::value;

}  // namespace std

#endif
