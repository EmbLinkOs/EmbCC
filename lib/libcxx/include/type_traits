/* <type_traits> — C++ [meta].
 *
 * The foundation: nearly every other header in this library is written in
 * terms of it, so it comes first and carries no dependencies of its own.
 *
 * Where EmbCC has an intrinsic, this uses it. That is not an optimisation
 * -- most of these traits CANNOT be written in the language. There is no
 * expression that tells you whether a class is polymorphic, whether a
 * constructor is trivial, or whether a destructor can throw; only the
 * compiler knows, and `__is_polymorphic` is how it says so. The traits
 * written out in C++ below are the ones that genuinely are expressible:
 * the type-list membership tests, and the transformations that are just
 * partial specialisation.
 */
#ifndef _LIBCXX_TYPE_TRAITS
#define _LIBCXX_TYPE_TRAITS

#include <cstddef>

namespace std {

/* ---- integral_constant and the two everybody uses --------------------- */

template <class T, T v>
struct integral_constant {
    static constexpr T value = v;
    using value_type = T;
    using type = integral_constant;
    constexpr operator value_type() const noexcept { return value; }
    constexpr value_type operator()() const noexcept { return value; }
};

template <bool B> using bool_constant = integral_constant<bool, B>;
using true_type = bool_constant<true>;
using false_type = bool_constant<false>;

/* ---- cv and reference surgery ----------------------------------------- */

template <class T> struct remove_const { using type = T; };
template <class T> struct remove_const<const T> { using type = T; };
template <class T> using remove_const_t = typename remove_const<T>::type;

template <class T> struct remove_volatile { using type = T; };
template <class T> struct remove_volatile<volatile T> { using type = T; };
template <class T> using remove_volatile_t = typename remove_volatile<T>::type;

template <class T> struct remove_cv { using type = __remove_cv(T); };
template <class T> using remove_cv_t = __remove_cv(T);

template <class T> struct add_const { using type = const T; };
template <class T> using add_const_t = const T;
template <class T> struct add_volatile { using type = volatile T; };
template <class T> using add_volatile_t = volatile T;
template <class T> struct add_cv { using type = const volatile T; };
template <class T> using add_cv_t = const volatile T;

template <class T> struct remove_reference { using type = __remove_reference(T); };
template <class T> using remove_reference_t = __remove_reference(T);

template <class T> struct remove_cvref { using type = __remove_cvref(T); };
template <class T> using remove_cvref_t = __remove_cvref(T);

template <class T> struct remove_pointer { using type = __remove_pointer(T); };
template <class T> using remove_pointer_t = __remove_pointer(T);

template <class T> struct remove_extent { using type = __remove_extent(T); };
template <class T> using remove_extent_t = __remove_extent(T);
template <class T> struct remove_all_extents { using type = __remove_all_extents(T); };
template <class T> using remove_all_extents_t = __remove_all_extents(T);

/* add_lvalue_reference and friends have to be SFINAE-friendly: applied to
 * void, which cannot have a reference, they must yield void rather than
 * being an error. That is what the partial specialisation on a
 * substitution failure buys, and why these are not one-liners. */
namespace __detail {
template <class T> struct __add_lref { using type = T; };
template <class T> struct __add_lref<T &> { using type = T &; };
template <class T> auto __try_add_lref(int) -> __add_lref<T &>;
template <class T> auto __try_add_lref(...) -> __add_lref<T>;
template <class T> auto __try_add_rref(int) -> __add_lref<T &&>;
template <class T> auto __try_add_rref(...) -> __add_lref<T>;
template <class T> auto __try_add_ptr(int) -> __add_lref<__remove_reference(T) *>;
template <class T> auto __try_add_ptr(...) -> __add_lref<T>;
}

template <class T>
struct add_lvalue_reference : decltype(__detail::__try_add_lref<T>(0)) {};
template <class T>
using add_lvalue_reference_t = typename add_lvalue_reference<T>::type;
template <class T>
struct add_rvalue_reference : decltype(__detail::__try_add_rref<T>(0)) {};
template <class T>
using add_rvalue_reference_t = typename add_rvalue_reference<T>::type;
template <class T>
struct add_pointer : decltype(__detail::__try_add_ptr<T>(0)) {};
template <class T> using add_pointer_t = typename add_pointer<T>::type;

/* ---- conditional, enable_if, void_t ----------------------------------- */

template <bool B, class T, class F> struct conditional { using type = T; };
template <class T, class F> struct conditional<false, T, F> { using type = F; };
template <bool B, class T, class F>
using conditional_t = typename conditional<B, T, F>::type;

template <bool B, class T = void> struct enable_if {};
template <class T> struct enable_if<true, T> { using type = T; };
template <bool B, class T = void>
using enable_if_t = typename enable_if<B, T>::type;

template <class...> using void_t = void;

template <class T> struct type_identity { using type = T; };
template <class T> using type_identity_t = T;

/* ---- declval ----------------------------------------------------------
 * "A value of type T, for the purposes of an unevaluated expression." It
 * has no definition on purpose: calling it is the one thing that must
 * never happen, and leaving it undefined turns a mistake into a link
 * error instead of a run-time one. */
template <class T>
add_rvalue_reference_t<T> declval() noexcept;

/* ---- the primary categories ------------------------------------------
 * These are the list-membership traits: the ones that genuinely ARE
 * expressible, by naming the finite set of types in each category. */

template <class T> struct is_void : bool_constant<__is_same(__remove_cv(T), void)> {};
template <class T> inline constexpr bool is_void_v = is_void<T>::value;

template <class T>
struct is_null_pointer : bool_constant<__is_same(__remove_cv(T), decltype(nullptr))> {};
template <class T>
inline constexpr bool is_null_pointer_v = is_null_pointer<T>::value;

