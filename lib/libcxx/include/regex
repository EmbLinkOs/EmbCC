                  regex_constants::match_flag_type =
                      regex_constants::match_default) = delete;

/* ---- regex_replace ------------------------------------------------------ */

template <class Out, class BI, class C>
Out regex_replace(Out out, BI b, BI e, const basic_regex<C> &re,
                  const basic_string<C> &fmt,
                  regex_constants::match_flag_type f =
                      regex_constants::match_default)
{
    /* The loop runs while a match is FOUND, including one at the very
     * end of the subject: `x*` matches empty at every position, the
     * last one included, so "abc" becomes "-a-b-c-" with four
     * replacements and not three. A loop conditioned on `pos != e`
     * stops one short. */
    BI pos = b;
    for (;;) {
        match_results<BI> m;
        if (!regex_search(pos, e, m, re, f))
            break;
        if (!(f & regex_constants::format_no_copy))
            for (BI q = pos; q != m[0].first; ++q)
                *out++ = *q;
        out = m.format(out, fmt.data(), fmt.data() + fmt.size(), f);
        BI next = m[0].second;
        /* An empty match must still advance, or the loop never ends:
         * copy one character and step past it. */
        if (next == m[0].first) {
            if (next == e) {
                pos = next;
                break;
            }
            if (!(f & regex_constants::format_no_copy))
                *out++ = *next;
            ++next;
        }
        pos = next;
        if (f & regex_constants::format_first_only)
            break;
    }
    if (!(f & regex_constants::format_no_copy))
        for (BI q = pos; q != e; ++q)
            *out++ = *q;
    return out;
}

template <class C>
basic_string<C> regex_replace(const basic_string<C> &s,
                              const basic_regex<C> &re,
                              const basic_string<C> &fmt,
                              regex_constants::match_flag_type f =
                                  regex_constants::match_default)
{
    basic_string<C> r;
    regex_replace(back_inserter(r), s.begin(), s.end(), re, fmt, f);
    return r;
}

template <class C>
basic_string<C> regex_replace(const basic_string<C> &s,
                              const basic_regex<C> &re, const C *fmt,
                              regex_constants::match_flag_type f =
                                  regex_constants::match_default)
{ return regex_replace(s, re, basic_string<C>(fmt), f); }

template <class C>
basic_string<C> regex_replace(const C *s, const basic_regex<C> &re,
                              const C *fmt,
                              regex_constants::match_flag_type f =
                                  regex_constants::match_default)
{ return regex_replace(basic_string<C>(s), re, basic_string<C>(fmt), f); }

/* ---- regex_iterator -----------------------------------------------------
 *
 * Every match in turn. The end iterator is the DEFAULT-CONSTRUCTED one,
 * which is how every C++ range of an unknown length is spelled.
 */
template <class BI, class C = char>
class regex_iterator {
public:
    using value_type = match_results<BI>;
    using difference_type = ptrdiff_t;
    using pointer = const value_type *;
    using reference = const value_type &;
    using iterator_category = forward_iterator_tag;

    regex_iterator() : __re(nullptr), __end_reached(true) {}
    regex_iterator(BI b, BI e, const basic_regex<C> &r,
                   regex_constants::match_flag_type f =
                       regex_constants::match_default)
        : __b(b), __e(e), __pos(b), __re(&r), __f(f), __end_reached(false)
    { __next(); }

    bool operator==(const regex_iterator &o) const
    {
        if (__end_reached || o.__end_reached)
            return __end_reached == o.__end_reached;
        return __pos == o.__pos;
    }
    bool operator!=(const regex_iterator &o) const { return !(*this == o); }

    reference operator*() const { return __m; }
    pointer operator->() const { return &__m; }

    regex_iterator &operator++() { __next(); return *this; }
    regex_iterator operator++(int)
    { regex_iterator t = *this; __next(); return t; }

private:
    void __next()
    {
        if (__end_reached)
            return;
        if (!regex_search(__pos, __e, __m, *__re, __f)) {
            __end_reached = true;
            return;
        }
        BI n = __m[0].second;
        /* An empty match advances by one, or the iterator would return
         * the same match forever. */
        if (n == __m[0].first) {
            if (n == __e) {
                __pos = __e;
                return;
            }
            ++n;
        }
        __pos = n;
    }

    BI __b{}, __e{}, __pos{};
    const basic_regex<C> *__re;
    regex_constants::match_flag_type __f = regex_constants::match_default;
    match_results<BI> __m;
    bool __end_reached;
};

using cregex_iterator = regex_iterator<const char *>;
using sregex_iterator = regex_iterator<string::const_iterator>;

/* ---- regex_token_iterator ------------------------------------------------
 *
 * The same walk, yielding a chosen sub-match of each match rather than
 * the match. Index -1 means the text BETWEEN matches, which is what
 * makes this a splitter: `regex_token_iterator(s.begin(), s.end(), re,
 * -1)` is "split on re" and is the reason the class exists.
 */
template <class BI, class C = char>
class regex_token_iterator {
public:
    using value_type = sub_match<BI>;
    using difference_type = ptrdiff_t;
    using pointer = const value_type *;
    using reference = const value_type &;
    using iterator_category = forward_iterator_tag;

    regex_token_iterator() : __done(true) {}
    regex_token_iterator(BI b, BI e, const basic_regex<C> &r, int sub = 0,
                         regex_constants::match_flag_type f =
                             regex_constants::match_default)
        : __it(b, e, r, f), __sub(sub), __last(b), __end(e), __done(false)
    { __next(); }

    bool operator==(const regex_token_iterator &o) const
    { return __done == o.__done && (__done || __cur.first == o.__cur.first); }
    bool operator!=(const regex_token_iterator &o) const
    { return !(*this == o); }

    reference operator*() const { return __cur; }
    pointer operator->() const { return &__cur; }

    regex_token_iterator &operator++() { __next(); return *this; }
    regex_token_iterator operator++(int)
    { regex_token_iterator t = *this; __next(); return t; }

private:
    void __next()
    {
        if (__done)
            return;
        regex_iterator<BI, C> stop;
        if (__it == stop) {
            /* One trailing field after the last match, for -1: the text
             * after the final separator, which "a,b," must still
             * produce. */
            if (__sub == -1 && !__tail_done) {
                __tail_done = true;
                __cur.first = __last;
                __cur.second = __end;
                __cur.matched = true;
                return;
            }
            __done = true;
            return;
        }
        if (__sub == -1) {
            __cur.first = __last;
            __cur.second = (*__it)[0].first;
            __cur.matched = true;
            __last = (*__it)[0].second;
        } else {
            __cur = (*__it)[(size_t)__sub];
        }
        ++__it;
    }

    regex_iterator<BI, C> __it;
    int __sub = 0;
    BI __last{}, __end{};
    value_type __cur{};
    bool __done;
    bool __tail_done = false;
};

using cregex_token_iterator = regex_token_iterator<const char *>;
