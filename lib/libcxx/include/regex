bool regex_match(const basic_string<C> &s, const basic_regex<C> &re,
                 regex_constants::match_flag_type f =
                     regex_constants::match_default)
{ return regex_match(s.begin(), s.end(), re, f); }

/* A match_results holds ITERATORS into the subject, so a match against a
 * temporary string would refer to freed characters the moment the call
 * returns. The standard deletes this overload rather than leaving the
 * dangling to be discovered. */
template <class C>
bool regex_match(const basic_string<C> &&,
                 match_results<typename basic_string<C>::const_iterator> &,
                 const basic_regex<C> &,
                 regex_constants::match_flag_type =
                     regex_constants::match_default) = delete;

/* ---- regex_search -------------------------------------------------------
 *
 * The leftmost match, and among those starting at the same place the one
 * the pattern's own greediness picks. Tried position by position from
 * the left, which is why "leftmost" is a property of the search and
 * "longest" is not.
 */
template <class BI, class C>
bool regex_search(BI b, BI e, match_results<BI> &m, const basic_regex<C> &re,
                  regex_constants::match_flag_type f =
                      regex_constants::match_default)
{
    m.__ready = false;
    if (!re.__tree())
        return false;
    __re::matcher<BI> mt = __re::setup(re, b, e, f);
    for (BI i = b;; ++i) {
        BI end;
        if (mt.match_at(re.__tree(), i, &end)) {
            if (!(f & regex_constants::match_not_null) || end != i) {
                __re::fill(m, mt, i, end, b, e);
                return true;
            }
        }
        /* match_continuous asks for a match at the start or none. */
        if (f & regex_constants::match_continuous)
            return false;
        if (i == e)
            return false;
    }
}

template <class BI, class C>
bool regex_search(BI b, BI e, const basic_regex<C> &re,
                  regex_constants::match_flag_type f =
                      regex_constants::match_default)
{
    match_results<BI> m;
    return regex_search(b, e, m, re, f);
}

template <class C>
bool regex_search(const C *s, match_results<const C *> &m,
                  const basic_regex<C> &re,
                  regex_constants::match_flag_type f =
