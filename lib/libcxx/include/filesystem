/* <filesystem> — C++ [filesystems].
 *
 * Two halves that are worth keeping apart in your head.
 *
 * `path` is PURE STRING MANIPULATION. It touches no filesystem, asks
 * the OS nothing, and answers every question about a path's SHAPE --
 * its stem, its extension, its parent, whether it is absolute. All of
 * it works on a target with no filesystem at all, because none of it
 * is about files.
 *
 * The operations -- exists, create_directory, directory_iterator and
 * the rest -- go through lib/libc/os/backend.h's second optional
 * group. A target that implements none of it gets `ENOSYS` reported as
 * a `filesystem_error` carrying `errc::function_not_supported`, and a
 * target that does (EmbLinkOS) gets the real thing without a line here
 * changing.
 *
 * ---- every operation comes in two forms ---------------------------------
 *
 * One throws, one takes an `error_code &`. That is not a convenience:
 * on a filesystem, failure is ORDINARY. A file disappearing between
 * the `exists` and the `open` is not exceptional, it is Tuesday, and
 * an interface that can only report it by throwing forces a try/catch
 * around ordinary control flow. The `error_code` forms are also
 * `noexcept`, which is what lets them be used where an exception
 * cannot escape.
 *
 * ---- what is NOT here ----------------------------------------------------
 *
 * `path::format` distinctions between native and generic form: this
 * target has one separator, `/`, so the two forms are the same string
 * and pretending otherwise would be ceremony. `u8path` and the wide
 * constructors are absent for the same reason the rest of this library
 * is byte-oriented (see <wchar.h>). Hard links are reported but
 * `hard_link_count` needs a stat field this target may not have, and
 * says so.
 */
#ifndef _LIBCXX_FILESYSTEM
#define _LIBCXX_FILESYSTEM

#include <chrono>
#include <cstddef>
#include <cstring>
#include <iterator>
#include <memory>
#include <string>
#include <string_view>
#include <system_error>
#include <utility>
#include <vector>

