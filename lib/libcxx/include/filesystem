inline void permissions(const path &p, perms pr,
                        perm_options opts = perm_options::replace)
{
    unsigned m = (unsigned)pr & 07777u;
    if (opts != perm_options::replace) {
        file_status s = status(p);
        unsigned cur = (unsigned)s.permissions() & 07777u;
        if (opts == perm_options::add)
            m = cur | m;
        else if (opts == perm_options::remove)
            m = cur & ~m;
    }
    if (__os_chmod(p.c_str(), m) != 0)
        throw filesystem_error("permissions", p, __detail::__last());
}

inline void permissions(const path &p, perms pr, error_code &ec) noexcept
{
    if (__os_chmod(p.c_str(), (unsigned)pr & 07777u) != 0)
        ec = __detail::__last();
    else
        ec.clear();
}

