inline bool remove(const path &p, error_code *ec)
{
    __os_fileinfo fi;
    if (__os_lstat(p.c_str(), &fi) != 0) {
        error_code e = __detail::__last();
        /* Removing what is not there is FALSE, not an error: the
         * postcondition -- it is gone -- already holds. */
        if (e == errc::no_such_file_or_directory) {
            __detail::__ok(ec);
            return false;
        }
        __detail::__fail(ec, e, "remove", p);
        return false;
    }
    int r = fi.type == __OS_FT_DIRECTORY ? __os_rmdir(p.c_str())
                                         : __os_unlink(p.c_str());
    if (r != 0) {
        __detail::__fail(ec, __detail::__last(), "remove", p);
        return false;
    }
    __detail::__ok(ec);
    return true;
}

