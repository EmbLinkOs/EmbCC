/* canonical asks the FILESYSTEM, which is what separates it from
 * lexically_normal: resolving ".." by deleting the previous component
 * is wrong when that component is a symlink. It therefore requires the
 * path to exist. */
inline path canonical(const path &p, error_code *ec)
{
    path a = absolute(p, ec);
    if (ec && *ec)
        return path();
    __os_fileinfo fi;
    if (__os_stat(a.c_str(), &fi) != 0) {
        __detail::__fail(ec, __detail::__last(), "canonical", p);
        return path();
    }
    __detail::__ok(ec);
    return a.lexically_normal();
}

