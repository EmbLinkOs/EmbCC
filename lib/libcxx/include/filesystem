/* Two paths name the same file when the OS says so -- comparing the
 * strings cannot answer it, because two different paths may be one
 * file through a link. */
inline bool equivalent(const path &a, const path &b, error_code *ec)
{
    __os_fileinfo fa, fb;
    if (__os_stat(a.c_str(), &fa) != 0 || __os_stat(b.c_str(), &fb) != 0) {
        __detail::__fail2(ec, __detail::__last(), "equivalent", a, b);
        return false;
    }
    __detail::__ok(ec);
    /* On a target with no device or inode numbers, the resolved paths
     * are the best answer available -- and it is the right one for a
     * single filesystem with no hard links. */
    if (fa.dev == 0 && fa.ino == 0 && fb.dev == 0 && fb.ino == 0)
        return a.lexically_normal() == b.lexically_normal();
    return fa.dev == fb.dev && fa.ino == fb.ino;
}

inline bool equivalent(const path &a, const path &b)
{ return equivalent(a, b, nullptr); }
inline bool equivalent(const path &a, const path &b, error_code &ec) noexcept
{
    try {
        return equivalent(a, b, &ec);
    } catch (...) {
        ec = make_error_code(errc::io_error);
        return false;
    }
}

