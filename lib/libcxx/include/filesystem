namespace std {
namespace filesystem {

/* ---- path ---------------------------------------------------------------- */

class path {
public:
    using value_type = char;
    using string_type = string;
    static constexpr char preferred_separator = '/';

    path() = default;
    path(const path &) = default;
    path(path &&) noexcept = default;
    path(string_type s) : __s(static_cast<string_type &&>(s)) {}
    path(const char *s) : __s(s) {}
    path(string_view s) : __s(s) {}
    template <class I>
    path(I first, I last) : __s(first, last) {}

    path &operator=(const path &) = default;
    path &operator=(path &&) noexcept = default;
    path &operator=(string_type s)
    { __s = static_cast<string_type &&>(s); return *this; }

    /* ---- appending ------------------------------------------------- */

    /* `/` APPENDS A COMPONENT, and an absolute right-hand side REPLACES
     * rather than appending: `path("/a") / "/b"` is "/b". That surprises
     * everyone once and is the only sane rule -- an absolute path is
     * absolute, and quietly making it relative to something else would
     * turn a bug into a silently wrong file. */
    path &operator/=(const path &p)
    {
        if (p.is_absolute()) {
            __s = p.__s;
            return *this;
        }
        if (p.__s.empty()) {
            /* A trailing separator is added, which is what makes
             * `dir / ""` mean "the directory itself" and round-trip
             * through iteration. */
            if (!__s.empty() && __s.back() != '/')
                __s += '/';
            return *this;
        }
        if (!__s.empty() && __s.back() != '/')
            __s += '/';
        __s += p.__s;
        return *this;
    }

    /* `+=` CONCATENATES without a separator -- which is how an
     * extension or a suffix is added. Two operators because they are
     * two different things and one of them is nearly always wrong. */
    path &operator+=(const path &p) { __s += p.__s; return *this; }
    path &operator+=(const string_type &s) { __s += s; return *this; }
    path &operator+=(const char *s) { __s += s; return *this; }
    path &operator+=(char c) { __s += c; return *this; }

    path &append(const path &p) { return *this /= p; }
    path &concat(const path &p) { return *this += p; }

    void clear() { __s.clear(); }

    path &remove_filename()
    {
        size_t i = __last_sep();
        if (i == string_type::npos)
            __s.clear();
        else
            __s.erase(i + 1);
        return *this;
    }

    path &replace_filename(const path &p)
    {
        remove_filename();
        return *this /= p;
    }

    path &replace_extension(const path &p = path())
    {
        string_type e = extension().__s;
        if (!e.empty())
            __s.erase(__s.size() - e.size());
        if (!p.__s.empty()) {
            if (p.__s[0] != '.')
                __s += '.';
            __s += p.__s;
        }
        return *this;
    }

    void swap(path &o) noexcept { __s.swap(o.__s); }

    /* ---- observers -------------------------------------------------- */

    const string_type &native() const noexcept { return __s; }
    const char *c_str() const noexcept { return __s.c_str(); }
    operator string_type() const { return __s; }
    string_type string() const { return __s; }
    /* One separator on this target, so the generic form IS the native
     * form -- see the note at the top. */
    string_type generic_string() const { return __s; }

    int compare(const path &o) const noexcept { return __s.compare(o.__s); }
    int compare(const string_type &s) const { return __s.compare(s); }
    int compare(const char *s) const { return __s.compare(s); }

    /* ---- decomposition ----------------------------------------------- */

    /* No drive letters here, so the root NAME is always empty and the
     * root DIRECTORY is "/" when the path starts with one. */
    path root_name() const { return path(); }
    path root_directory() const
    { return __abs() ? path("/") : path(); }
    path root_path() const { return root_directory(); }

    path relative_path() const
    {
        if (!__abs())
            return *this;
        size_t i = 0;
        while (i < __s.size() && __s[i] == '/')
            i++;
        return path(__s.substr(i));
    }

    path parent_path() const
    {
        size_t i = __last_sep();
        if (i == string_type::npos)
            return path();
        if (i == 0)
            return path("/");     /* the parent of "/a" is "/" */
        return path(__s.substr(0, i));
    }

    path filename() const
    {
        size_t i = __last_sep();
        return path(i == string_type::npos ? __s : __s.substr(i + 1));
    }

    /* The stem and the extension split at the LAST dot, and three cases
     * are not extensions however much they look like one: a leading dot
     * (".bashrc" is all stem), "." and "..". Getting those wrong turns
     * a dotfile into an extension with an empty name. */
    path stem() const
    {
        string_type f = filename().__s;
        if (f == "." || f == "..")
            return path(f);
        size_t d = f.rfind('.');
        if (d == string_type::npos || d == 0)
            return path(f);
        return path(f.substr(0, d));
    }

    path extension() const
    {
        string_type f = filename().__s;
        if (f == "." || f == "..")
            return path();
        size_t d = f.rfind('.');
        if (d == string_type::npos || d == 0)
            return path();
        return path(f.substr(d));
    }

    bool empty() const noexcept { return __s.empty(); }
    bool has_root_path() const { return __abs(); }
    bool has_root_name() const { return false; }
    bool has_root_directory() const { return __abs(); }
    bool has_relative_path() const { return !relative_path().empty(); }
    bool has_parent_path() const { return !parent_path().empty(); }
    bool has_filename() const { return !filename().empty(); }
    bool has_stem() const { return !stem().empty(); }
    bool has_extension() const { return !extension().empty(); }
    bool is_absolute() const { return __abs(); }
    bool is_relative() const { return !__abs(); }

    /* ---- lexical operations ------------------------------------------
     *
     * "Lexical" means WITHOUT ASKING THE FILESYSTEM, and the
     * distinction matters: `lexically_normal` resolves ".." by deleting
     * the previous component, which is wrong if that component is a
     * symlink -- "a/b/.." is not "a" when b points elsewhere. That is
     * why `canonical` exists and needs a filesystem, and why this one
     * says "lexically" in its name.
     */
    path lexically_normal() const
    {
        vector<string_type> parts;
        bool abs = __abs();
        size_t i = 0;
        bool trailing = false;
        while (i < __s.size()) {
            while (i < __s.size() && __s[i] == '/')
                i++;
            size_t j = i;
            while (j < __s.size() && __s[j] != '/')
                j++;
            if (j > i) {
                string_type c = __s.substr(i, j - i);
                if (c == ".") {
                    trailing = true;
                } else if (c == "..") {
                    if (!parts.empty() && parts.back() != "..") {
                        parts.pop_back();
                        trailing = true;
                    } else if (!abs) {
                        /* A leading ".." in a RELATIVE path is kept:
                         * there is nothing above it to cancel. In an
                         * absolute one it is dropped, because the root
                         * has no parent. */
                        parts.push_back(c);
                        trailing = false;
                    } else {
                        trailing = true;
                    }
                } else {
                    parts.push_back(c);
                    trailing = false;
                }
            }
            i = j;
        }
        string_type r;
        if (abs)
            r += '/';
        for (size_t k = 0; k < parts.size(); k++) {
            if (k)
                r += '/';
            r += parts[k];
        }
        if (r.empty())
            r = abs ? "/" : ".";
        else if (trailing && r != "/" && !parts.empty())
            r += '/';
        return path(r);
    }

    /* The path that leads from `base` to this one, or empty when there
     * is none -- which happens when one is absolute and the other is
     * not, because no sequence of ".." crosses that. */
    path lexically_relative(const path &base) const
    {
        if (is_absolute() != base.is_absolute())
            return path();
        vector<string_type> a = __split(lexically_normal().__s);
        vector<string_type> b = __split(base.lexically_normal().__s);
        size_t i = 0;
        while (i < a.size() && i < b.size() && a[i] == b[i])
            i++;
        /* A ".." in what remains of base cannot be undone without
         * knowing what it pointed at, so there is no relative path. */
        for (size_t k = i; k < b.size(); k++)
            if (b[k] == "..")
                return path();
        if (i == a.size() && i == b.size())
            return path(".");
        string_type r;
        for (size_t k = i; k < b.size(); k++) {
            if (!r.empty())
                r += '/';
            r += "..";
        }
        for (size_t k = i; k < a.size(); k++) {
            if (!r.empty())
                r += '/';
            r += a[k];
        }
        return path(r.empty() ? "." : r);
    }

    path lexically_proximate(const path &base) const
    {
        path r = lexically_relative(base);
        return r.empty() ? *this : r;
    }

    /* ---- iteration ---------------------------------------------------
     *
     * A path iterates over its COMPONENTS, with the root directory as a
     * component of its own: "/a/b" is "/", "a", "b". That is what makes
     * an absolute path distinguishable from a relative one by iteration
     * alone.
     */
    /* Declared here and DEFINED after the class: an iterator holds the
     * component it is on, as a path, and a path is not complete until
     * its own definition closes. */
    class iterator;
    using const_iterator = iterator;

    iterator begin() const;
    iterator end() const;



private:
    bool __abs() const { return !__s.empty() && __s[0] == '/'; }

    size_t __last_sep() const
    {
        size_t i = __s.rfind('/');
        return i;
    }

    static vector<string_type> __split(const string_type &s)
    {
        vector<string_type> r;
        size_t i = 0;
        while (i < s.size()) {
            while (i < s.size() && s[i] == '/')
                i++;
            size_t j = i;
            while (j < s.size() && s[j] != '/')
                j++;
            if (j > i)
                r.push_back(s.substr(i, j - i));
            i = j;
        }
        return r;
    }

    string_type __s;
};

class path::iterator {
public:
    using value_type = path;
    using difference_type = ptrdiff_t;
    using reference = const path &;
    using pointer = const path *;
    using iterator_category = bidirectional_iterator_tag;

    iterator() : __p(nullptr), __pos(0), __end(0) {}
    iterator(const path *p, size_t pos) : __p(p), __pos(pos), __end(pos)
    { __load(); }

    reference operator*() const { return __cur; }
    pointer operator->() const { return &__cur; }

    iterator &operator++()
    {
        __pos = __end;
        __load();
        return *this;
    }
    iterator operator++(int) { iterator t = *this; ++*this; return t; }

    friend bool operator==(const iterator &a, const iterator &b)
    { return a.__p == b.__p && a.__pos == b.__pos; }
    friend bool operator!=(const iterator &a, const iterator &b)
    { return !(a == b); }

private:
    void __load()
    {
        const string_type &s = __p->__s;
        if (__pos >= s.size()) {
            __cur = path();
            __end = __pos;
            return;
        }
        if (__pos == 0 && s[0] == '/') {
            /* The root directory is one component, however many
             * slashes were written. */
            size_t j = 0;
            while (j < s.size() && s[j] == '/')
                j++;
            __cur = path("/");
            __end = j;
            return;
        }
        size_t i = __pos;
        while (i < s.size() && s[i] == '/')
            i++;
        size_t j = i;
        while (j < s.size() && s[j] != '/')
            j++;
        if (j == i) {
            __cur = path();
            __end = s.size();
            return;
        }
        __cur = path(s.substr(i, j - i));
        __end = j;
    }

    const path *__p;
    size_t __pos, __end;
    path __cur;
};

inline path::iterator path::begin() const { return iterator(this, 0); }
inline path::iterator path::end() const { return iterator(this, __s.size()); }

inline path operator/(const path &a, const path &b)
{ path r = a; r /= b; return r; }

inline bool operator==(const path &a, const path &b) noexcept
{ return a.compare(b) == 0; }
inline bool operator!=(const path &a, const path &b) noexcept
{ return a.compare(b) != 0; }
inline bool operator<(const path &a, const path &b) noexcept
{ return a.compare(b) < 0; }
inline bool operator>(const path &a, const path &b) noexcept
{ return a.compare(b) > 0; }
inline bool operator<=(const path &a, const path &b) noexcept
{ return a.compare(b) <= 0; }
inline bool operator>=(const path &a, const path &b) noexcept
{ return a.compare(b) >= 0; }

inline void swap(path &a, path &b) noexcept { a.swap(b); }

/* ---- file types and permissions ----------------------------------------- */

enum class file_type {
    none = 0,
    not_found = -1,
    regular = 1,
    directory = 2,
    symlink = 3,
    block = 4,
    character = 5,
    fifo = 6,
    socket = 7,
    unknown = 8
};

enum class perms : unsigned {
    none = 0,
    owner_read = 0400, owner_write = 0200, owner_exec = 0100, owner_all = 0700,
    group_read = 040,  group_write = 020,  group_exec = 010,  group_all = 070,
    others_read = 04,  others_write = 02,  others_exec = 01,  others_all = 07,
    all = 0777,
    set_uid = 04000, set_gid = 02000, sticky_bit = 01000,
    mask = 07777,
    unknown = 0xFFFF
};

constexpr perms operator|(perms a, perms b)
{ return (perms)((unsigned)a | (unsigned)b); }
constexpr perms operator&(perms a, perms b)
{ return (perms)((unsigned)a & (unsigned)b); }
constexpr perms operator^(perms a, perms b)
{ return (perms)((unsigned)a ^ (unsigned)b); }
constexpr perms operator~(perms a)
{ return (perms)(~(unsigned)a & 07777u); }
inline perms &operator|=(perms &a, perms b) { a = a | b; return a; }
inline perms &operator&=(perms &a, perms b) { a = a & b; return a; }

enum class perm_options { replace = 1, add = 2, remove = 4, nofollow = 8 };

enum class copy_options {
    none = 0,
    skip_existing = 1, overwrite_existing = 2, update_existing = 4,
    recursive = 8,
    copy_symlinks = 16, skip_symlinks = 32, directories_only = 64,
    create_symlinks = 128, create_hard_links = 256
};

constexpr copy_options operator|(copy_options a, copy_options b)
{ return (copy_options)((int)a | (int)b); }
constexpr copy_options operator&(copy_options a, copy_options b)
{ return (copy_options)((int)a & (int)b); }

enum class directory_options { none = 0, follow_directory_symlink = 1,
                               skip_permission_denied = 2 };

constexpr directory_options operator|(directory_options a, directory_options b)
{ return (directory_options)((int)a | (int)b); }
constexpr directory_options operator&(directory_options a, directory_options b)
{ return (directory_options)((int)a & (int)b); }

class file_status {
public:
    file_status() noexcept : __t(file_type::none), __p(perms::unknown) {}
    explicit file_status(file_type t, perms p = perms::unknown) noexcept
        : __t(t), __p(p) {}

    file_type type() const noexcept { return __t; }
    perms permissions() const noexcept { return __p; }
    void type(file_type t) noexcept { __t = t; }
    void permissions(perms p) noexcept { __p = p; }

    friend bool operator==(const file_status &a, const file_status &b) noexcept
    { return a.__t == b.__t && a.__p == b.__p; }

private:
    file_type __t;
    perms __p;
};

using file_time_type = chrono::time_point<chrono::system_clock>;

struct space_info {
    uintmax_t capacity;
    uintmax_t free;
    uintmax_t available;
};

/* ---- filesystem_error ----------------------------------------------------
 *
 * Carries the PATHS as well as the code, and that is the difference
 * from a plain system_error: "No such file or directory" is not a
 * diagnosis, and reconstructing which path failed from a call stack is
 * exactly the work this saves.
 */
class filesystem_error : public system_error {
public:
    filesystem_error(const string &what, error_code ec)
        : system_error(ec, what), __p1(), __p2() {}
    filesystem_error(const string &what, const path &p1, error_code ec)
        : system_error(ec, what + " [" + p1.string() + "]"), __p1(p1), __p2() {}
    filesystem_error(const string &what, const path &p1, const path &p2,
                     error_code ec)
        : system_error(ec, what + " [" + p1.string() + "] [" + p2.string() + "]"),
          __p1(p1), __p2(p2) {}

    const path &path1() const noexcept { return __p1; }
    const path &path2() const noexcept { return __p2; }

private:
    path __p1, __p2;
};

namespace __detail {

inline error_code __last() noexcept
{ return error_code(errno, system_category()); }

/* Either report through the code or throw, from one place: every
 * operation below comes in both forms, and writing the choice twice per
 * operation is how the two drift apart. */
inline void __fail(error_code *ec, error_code e, const char *what,
                   const path &p)
{
    if (ec) {
        *ec = e;
        return;
    }
    throw filesystem_error(what, p, e);
}

inline void __fail2(error_code *ec, error_code e, const char *what,
                    const path &a, const path &b)
{
    if (ec) {
        *ec = e;
        return;
    }
    throw filesystem_error(what, a, b, e);
}

inline void __ok(error_code *ec) { if (ec) ec->clear(); }

inline file_type __type_of(int t)
{
    switch (t) {
    case __OS_FT_REGULAR:   return file_type::regular;
    case __OS_FT_DIRECTORY: return file_type::directory;
    case __OS_FT_SYMLINK:   return file_type::symlink;
    case __OS_FT_CHARDEV:   return file_type::character;
    case __OS_FT_BLOCKDEV:  return file_type::block;
    case __OS_FT_FIFO:      return file_type::fifo;
    case __OS_FT_SOCKET:    return file_type::socket;
    case __OS_FT_NOT_FOUND: return file_type::not_found;
    default:                return file_type::unknown;
    }
}

inline file_status __status(const path &p, bool follow, error_code *ec)
{
    __os_fileinfo fi;
    int r = follow ? __os_stat(p.c_str(), &fi) : __os_lstat(p.c_str(), &fi);
    if (r != 0) {
        error_code e = __last();
        /* A path that is NOT THERE is not an error for status(): it is
         * the answer, `file_type::not_found`. Every other failure --
         * no permission, no filesystem at all -- is an error, and
         * conflating them is how a program decides a file is missing
         * when the disk is unreadable. */
        if (e == errc::no_such_file_or_directory ||
            e == errc::not_a_directory) {
            __ok(ec);
            return file_status(file_type::not_found, perms::none);
        }
        if (ec) {
            *ec = e;
            return file_status(file_type::none, perms::unknown);
        }
        throw filesystem_error("status", p, e);
    }
    __ok(ec);
    return file_status(__type_of(fi.type), (perms)(fi.mode & 07777u));
}

}  // namespace __detail

/* ---- status --------------------------------------------------------------- */

inline file_status status(const path &p)
{ return __detail::__status(p, true, nullptr); }
inline file_status status(const path &p, error_code &ec) noexcept
{
    try {
        return __detail::__status(p, true, &ec);
    } catch (...) {
        ec = make_error_code(errc::io_error);
        return file_status();
    }
}

/* WITHOUT following a symlink, which is the whole distinction: a
 * recursive walk that confuses the two follows a loop forever. */
inline file_status symlink_status(const path &p)
{ return __detail::__status(p, false, nullptr); }
inline file_status symlink_status(const path &p, error_code &ec) noexcept
{
    try {
        return __detail::__status(p, false, &ec);
    } catch (...) {
        ec = make_error_code(errc::io_error);
        return file_status();
    }
}

inline bool status_known(file_status s) noexcept
{ return s.type() != file_type::none; }
inline bool exists(file_status s) noexcept
{ return status_known(s) && s.type() != file_type::not_found; }
inline bool is_regular_file(file_status s) noexcept
{ return s.type() == file_type::regular; }
inline bool is_directory(file_status s) noexcept
{ return s.type() == file_type::directory; }
