inline bool create_directory(const path &p, error_code *ec)
{
    if (__os_mkdir(p.c_str(), 0777) == 0) {
        __detail::__ok(ec);
        return true;
    }
    error_code e = __detail::__last();
    /* Already there is NOT an error -- it is "false, and nothing was
     * created", which is what lets create_directory be called
     * unconditionally. */
    if (e == errc::file_exists) {
        __detail::__ok(ec);
        return false;
    }
    __detail::__fail(ec, e, "create_directory", p);
    return false;
}

