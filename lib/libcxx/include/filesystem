/* ---- directory_entry ------------------------------------------------------
 *
 * Holds the path AND a cached status, because a directory listing
 * usually already knows the type from the entry itself -- so asking
 * `is_directory` costs nothing where a bare path would cost a syscall
 * per entry. `refresh()` is how a caller says the cache is stale.
 */
class directory_entry {
public:
    directory_entry() = default;
    explicit directory_entry(const class path &p) : __p(p) { __refresh_quiet(); }
    directory_entry(const class path &p, file_type t)
        : __p(p), __st(t, perms::unknown), __have(t != file_type::none) {}

    void assign(const class path &p) { __p = p; __have = false; __refresh_quiet(); }
    void replace_filename(const class path &p)
    { __p.replace_filename(p); __have = false; __refresh_quiet(); }
    void refresh() { __have = false; __refresh_quiet(); }
    void refresh(error_code &ec) noexcept
    {
        __st = filesystem::symlink_status(__p, ec);
        __have = !ec;
    }

    const class path &path() const noexcept { return __p; }
    operator const class path &() const noexcept { return __p; }

    bool exists() const { return filesystem::exists(__status()); }
    bool is_regular_file() const
    { return filesystem::is_regular_file(__status()); }
    bool is_directory() const { return filesystem::is_directory(__status()); }
    bool is_symlink() const { return filesystem::is_symlink(__status()); }
    bool is_other() const { return filesystem::is_other(__status()); }
    bool is_block_file() const { return filesystem::is_block_file(__status()); }
    bool is_character_file() const
    { return filesystem::is_character_file(__status()); }
    bool is_fifo() const { return filesystem::is_fifo(__status()); }
    bool is_socket() const { return filesystem::is_socket(__status()); }

    uintmax_t file_size() const { return filesystem::file_size(__p); }
    uintmax_t hard_link_count() const
    { return filesystem::hard_link_count(__p); }
    file_time_type last_write_time() const
    { return filesystem::last_write_time(__p); }

    file_status status() const { return filesystem::status(__p); }
    file_status symlink_status() const
    { return filesystem::symlink_status(__p); }

    friend bool operator==(const directory_entry &a, const directory_entry &b)
    { return a.__p == b.__p; }
    friend bool operator!=(const directory_entry &a, const directory_entry &b)
    { return a.__p != b.__p; }
    friend bool operator<(const directory_entry &a, const directory_entry &b)
    { return a.__p < b.__p; }

private:
    void __refresh_quiet()
    {
        error_code ec;
        __st = filesystem::symlink_status(__p, ec);
        __have = !ec;
    }

    file_status __status() const
    {
        if (__have)
            return __st;
        return filesystem::symlink_status(__p);
    }

    class path __p;
    file_status __st;
    bool __have = false;
};

/* ---- directory_iterator ---------------------------------------------------
 *
 * An input iterator over a directory's entries, and the END is the
 * DEFAULT-CONSTRUCTED one -- the same shape every range of unknown
 * length takes. The handle is shared between copies, because the
 * standard makes copies refer to the same position: two copies advanced
 * independently would read one directory twice.
 */
class directory_iterator {
public:
    using value_type = directory_entry;
    using difference_type = ptrdiff_t;
    using pointer = const directory_entry *;
    using reference = const directory_entry &;
    using iterator_category = input_iterator_tag;

    directory_iterator() noexcept = default;

    explicit directory_iterator(const path &p,
                                directory_options opts = directory_options::none)
        : __opts(opts)
    {
        __open(p, nullptr);
    }

    directory_iterator(const path &p, error_code &ec) noexcept
        : __opts(directory_options::none)
    {
        __open(p, &ec);
    }

    directory_iterator(const path &p, directory_options opts,
                       error_code &ec) noexcept : __opts(opts)
    {
        __open(p, &ec);
    }

    directory_iterator(const directory_iterator &) = default;
    directory_iterator(directory_iterator &&) noexcept = default;
    directory_iterator &operator=(const directory_iterator &) = default;
    directory_iterator &operator=(directory_iterator &&) noexcept = default;

    reference operator*() const { return __cur; }
    pointer operator->() const { return &__cur; }

    directory_iterator &operator++() { __advance(nullptr); return *this; }
    directory_iterator &increment(error_code &ec) noexcept
    { __advance(&ec); return *this; }

    friend bool operator==(const directory_iterator &a,
                           const directory_iterator &b) noexcept
    { return a.__d == b.__d; }
    friend bool operator!=(const directory_iterator &a,
                           const directory_iterator &b) noexcept
    { return !(a == b); }

private:
    struct __dir {
        void *h;
        ~__dir() { if (h) __os_closedir(h); }
    };

    void __open(const path &p, error_code *ec)
    {
        void *h = __os_opendir(p.c_str());
        if (!h) {
            error_code e = __detail::__last();
            if ((int)(__opts & directory_options::skip_permission_denied) &&
                e == errc::permission_denied) {
                /* Asked to skip it: the iterator is simply empty, which
                 * is what lets a walk continue past a directory it may
                 * not read. */
                __detail::__ok(ec);
                return;
            }
            __detail::__fail(ec, e, "directory_iterator", p);
            return;
        }
        __base = p;
        __d = shared_ptr<__dir>(new __dir{h});
        __advance(ec);
    }

    void __advance(error_code *ec)
    {
        if (!__d)
            return;
        char name[512];
        int type = __OS_FT_UNKNOWN;
        int r = __os_readdir(__d->h, name, sizeof name, &type);
        if (r < 0) {
            __detail::__fail(ec, __detail::__last(), "directory_iterator",
                             __base);
            __d.reset();
            return;
        }
        if (r == 0) {
            /* The end. Dropping the handle is what makes this compare
             * equal to a default-constructed iterator. */
            __d.reset();
            __detail::__ok(ec);
            return;
        }
        __cur = directory_entry(__base / path(name), __detail::__type_of(type));
        __detail::__ok(ec);
    }

    path __base;
    shared_ptr<__dir> __d;
    directory_entry __cur;
    directory_options __opts = directory_options::none;
};

inline directory_iterator begin(directory_iterator i) noexcept { return i; }
inline directory_iterator end(directory_iterator) noexcept
{ return directory_iterator(); }

/* ---- recursive_directory_iterator -----------------------------------------
 *
 * The same walk, descending. It keeps a STACK of iterators rather than
 * recursing, so a deep tree costs heap rather than stack -- and
 * `disable_recursion_pending()` can prune a subtree before it is
 * entered, which recursion cannot express without unwinding.
 *
 * It does NOT follow symlinks by default, and that is not caution: a
 * symlink pointing at an ancestor makes the walk infinite.
 */
class recursive_directory_iterator {
public:
    using value_type = directory_entry;
    using difference_type = ptrdiff_t;
    using pointer = const directory_entry *;
    using reference = const directory_entry &;
    using iterator_category = input_iterator_tag;

    recursive_directory_iterator() noexcept = default;

    explicit recursive_directory_iterator(
        const path &p, directory_options opts = directory_options::none)
        : __opts(opts)
    {
        __stack.push_back(directory_iterator(p, opts));
        __settle(nullptr);
    }

    recursive_directory_iterator(const path &p, error_code &ec) noexcept
    {
        __stack.push_back(directory_iterator(p, ec));
        /* Settle even on failure. A directory that would not open
         * leaves an END directory_iterator on the stack, and __settle
         * is what pops it -- skipping it here left a one-deep stack
         * that was neither a real position nor the end, so a failed
         * construction compared unequal to the end iterator and a
         * range-for over it would dereference nothing. */
        __settle(&ec);
    }

    reference operator*() const { return *__stack.back(); }
    pointer operator->() const { return &*__stack.back(); }

    int depth() const { return (int)__stack.size() - 1; }
    directory_options options() const { return __opts; }

    bool recursion_pending() const { return __pending; }
    void disable_recursion_pending() { __pending = false; }

    /* Leave the current directory without finishing it -- which is how
     * a caller abandons a subtree it has seen enough of. */
    void pop()
    {
        if (__stack.empty())
            return;
        __stack.pop_back();
        if (!__stack.empty())
            ++__stack.back();
        __settle(nullptr);
    }

    recursive_directory_iterator &operator++()
    {
        __step(nullptr);
        return *this;
    }

    recursive_directory_iterator &increment(error_code &ec) noexcept
    {
        __step(&ec);
        return *this;
    }

    friend bool operator==(const recursive_directory_iterator &a,
                           const recursive_directory_iterator &b) noexcept
    { return a.__stack.empty() == b.__stack.empty(); }
    friend bool operator!=(const recursive_directory_iterator &a,
                           const recursive_directory_iterator &b) noexcept
    { return !(a == b); }

private:
    void __step(error_code *ec)
    {
        if (__stack.empty())
            return;
        const directory_entry &e = *__stack.back();
        bool descend = __pending && e.is_directory() &&
                       (!e.is_symlink() ||
                        (int)(__opts &
                              directory_options::follow_directory_symlink));
        __pending = true;
        if (descend) {
            /* A symlinked directory is not entered unless asked,
             * because one pointing at an ancestor makes this walk
             * infinite. */
            directory_iterator sub(e.path(), __opts);
            __stack.push_back(sub);
        } else {
            ++__stack.back();
        }
        __settle(ec);
    }

    /* Pop every finished level, so that `operator*` always names a real
     * entry and the end is an empty stack. */
    void __settle(error_code *ec)
    {
        (void)ec;
        while (!__stack.empty() && __stack.back() == directory_iterator()) {
            __stack.pop_back();
            if (!__stack.empty())
                ++__stack.back();
        }
    }

    vector<directory_iterator> __stack;
    directory_options __opts = directory_options::none;
    bool __pending = true;
};

inline recursive_directory_iterator
begin(recursive_directory_iterator i) noexcept { return i; }
inline recursive_directory_iterator
end(recursive_directory_iterator) noexcept
{ return recursive_directory_iterator(); }

/* ---- remove_all and is_empty, which need the iterators ------------------ */

inline uintmax_t remove_all(const path &p, error_code *ec)
{
    error_code sec;
    file_status st = symlink_status(p, sec);
    if (sec) {
        if (sec == errc::no_such_file_or_directory) {
            __detail::__ok(ec);
            return 0;
        }
        __detail::__fail(ec, sec, "remove_all", p);
        return (uintmax_t)-1;
    }
    if (!exists(st)) {
        __detail::__ok(ec);
        return 0;
    }
    uintmax_t n = 0;
    /* A DIRECTORY is emptied first, depth first, because a directory
     * cannot be removed while anything is in it. A symlink TO a
     * directory is removed as a link -- following it would delete
     * somebody else's tree. */
    if (st.type() == file_type::directory) {
        error_code iec;
        directory_iterator it(p, iec);
        if (iec) {
            __detail::__fail(ec, iec, "remove_all", p);
            return (uintmax_t)-1;
        }
        for (directory_iterator e; it != e;) {
            path child = it->path();
            uintmax_t sub = remove_all(child, ec);
            if (sub == (uintmax_t)-1)
                return sub;
            n += sub;
            it.increment(iec);
            if (iec) {
                __detail::__fail(ec, iec, "remove_all", p);
                return (uintmax_t)-1;
            }
        }
    }
    if (!remove(p, ec))
        return ec && *ec ? (uintmax_t)-1 : n;
    return n + 1;
}

inline uintmax_t remove_all(const path &p) { return remove_all(p, nullptr); }
inline uintmax_t remove_all(const path &p, error_code &ec) noexcept
{
    try {
        return remove_all(p, &ec);
    } catch (...) {
        ec = make_error_code(errc::io_error);
        return (uintmax_t)-1;
    }
}

inline bool is_empty(const path &p, error_code *ec)
{
    file_status st = __detail::__status(p, true, ec);
    if (ec && *ec)
        return false;
    if (st.type() == file_type::directory) {
        error_code iec;
        directory_iterator it(p, iec);
        if (iec) {
            __detail::__fail(ec, iec, "is_empty", p);
            return false;
        }
        __detail::__ok(ec);
        return it == directory_iterator();
    }
    return file_size(p, ec) == 0;
}

inline bool is_empty(const path &p) { return is_empty(p, nullptr); }
inline bool is_empty(const path &p, error_code &ec) noexcept
{
    try {
        return is_empty(p, &ec);
    } catch (...) {
        ec = make_error_code(errc::io_error);
        return false;
    }
}

