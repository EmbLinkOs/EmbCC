    }
}

inline bool create_directories(const path &p, error_code *ec)
{
    /* Every missing parent, in order. The loop builds the path up
     * component by component rather than recursing, so a very deep
     * path costs no stack. */
    path built;
    bool made = false;
    if (p.is_absolute())
        built = path("/");
    for (const path &c : p) {
        if (c == path("/"))
            continue;
        built /= c;
        if (__os_mkdir(built.c_str(), 0777) == 0) {
            made = true;
            continue;
        }
        error_code e = __detail::__last();
        if (e == errc::file_exists)
            continue;
        __detail::__fail(ec, e, "create_directories", built);
        return false;
    }
    __detail::__ok(ec);
    return made;
}

