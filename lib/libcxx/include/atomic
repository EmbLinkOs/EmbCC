/* ---- the free-function forms, for C compatibility ----------------------- */

template <class T>
inline void atomic_store(atomic<T> *a, T v) noexcept { a->store(v); }
template <class T>
inline void atomic_store_explicit(atomic<T> *a, T v, memory_order m) noexcept
{ a->store(v, m); }
template <class T>
inline T atomic_load(const atomic<T> *a) noexcept { return a->load(); }
template <class T>
inline T atomic_load_explicit(const atomic<T> *a, memory_order m) noexcept
{ return a->load(m); }
template <class T>
inline T atomic_exchange(atomic<T> *a, T v) noexcept { return a->exchange(v); }
template <class T>
inline T atomic_exchange_explicit(atomic<T> *a, T v, memory_order m) noexcept
{ return a->exchange(v, m); }
template <class T>
inline bool atomic_compare_exchange_weak(atomic<T> *a, T *e, T d) noexcept
{ return a->compare_exchange_weak(*e, d); }
template <class T>
inline bool atomic_compare_exchange_strong(atomic<T> *a, T *e, T d) noexcept
{ return a->compare_exchange_strong(*e, d); }
template <class T>
inline T atomic_fetch_add(atomic<T> *a, T v) noexcept { return a->fetch_add(v); }
template <class T>
inline T atomic_fetch_sub(atomic<T> *a, T v) noexcept { return a->fetch_sub(v); }

/* ---- atomic_ref ---------------------------------------------------------
 *
 * The same operations over an object someone else owns, which is the
 * case `atomic<T>` cannot cover: an array shared between threads, or a
 * field of a struct whose layout is fixed by an ABI. The object must be
 * touched ONLY through atomic_refs for as long as one exists -- a plain
 * access alongside is still a race.
 */
template <class T>
class atomic_ref {
public:
    static_assert(is_trivially_copyable_v<T>,
                  "std::atomic_ref<T> requires a trivially copyable T");
    using value_type = T;

    explicit atomic_ref(T &o) noexcept : __p(&o) {}
    atomic_ref(const atomic_ref &o) noexcept = default;

    static constexpr bool is_always_lock_free =
        sizeof(T) <= sizeof(void *) && (sizeof(T) & (sizeof(T) - 1)) == 0;
    bool is_lock_free() const noexcept { return is_always_lock_free; }

    void store(T v, memory_order m = memory_order_seq_cst) const noexcept
    { __atomic_store(__p, &v, (int)m); }
    T load(memory_order m = memory_order_seq_cst) const noexcept
    { T r; __atomic_load(__p, &r, (int)m); return r; }
    operator T() const noexcept { return load(); }
    T operator=(T v) const noexcept { store(v); return v; }

    T exchange(T v, memory_order m = memory_order_seq_cst) const noexcept
    { T r; __atomic_exchange(__p, &v, &r, (int)m); return r; }

    bool compare_exchange_weak(T &e, T d,
                               memory_order m = memory_order_seq_cst) const noexcept
    { return __atomic_compare_exchange(__p, &e, &d, true, (int)m,
                                       (int)__fail_order(m)); }
    bool compare_exchange_strong(T &e, T d,
                                 memory_order m = memory_order_seq_cst) const noexcept
    { return __atomic_compare_exchange(__p, &e, &d, false, (int)m,
                                       (int)__fail_order(m)); }

    template <class U = T>
    enable_if_t<is_integral_v<U>, U>
    fetch_add(U v, memory_order m = memory_order_seq_cst) const noexcept
    { return __atomic_fetch_add(__p, v, (int)m); }
    template <class U = T>
    enable_if_t<is_integral_v<U>, U>
    fetch_sub(U v, memory_order m = memory_order_seq_cst) const noexcept
    { return __atomic_fetch_sub(__p, v, (int)m); }

private:
    T *__p;
};

}  // namespace std

#endif
