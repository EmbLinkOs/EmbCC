/* <deque> — C++ [deque].
 *
 * A ring buffer over one contiguous block: a start index, a count, and a
 * capacity that is always a power of two so the wrap is a mask.
 *
 * Not the map-of-blocks a real implementation uses, and the difference
 * is visible: the standard says a reference to an element survives a
 * push at either END, which the map-of-blocks gives and this does not --
 * growing here moves everything. The test says so rather than claiming
 * otherwise. What this does give is the reason people reach for a deque
 * in the first place: O(1) at both ends and random access, where a
 * vector is O(n) at the front.
 */
#ifndef _LIBCXX_DEQUE
#define _LIBCXX_DEQUE

#include <cstddef>
#include <type_traits>
#include <utility>
#include <iterator>
#include <memory>
#include <initializer_list>
#include <stdexcept>

namespace std {

template <class T, class A = allocator<T>>
class deque {
public:
    using value_type = T;
    using size_type = size_t;
    using reference = T &;
    using const_reference = const T &;

    class iterator {
    public:
        using iterator_category = random_access_iterator_tag;
        using value_type = T;
        using difference_type = ptrdiff_t;
        using pointer = T *;
        using reference = T &;

        iterator() : __d(nullptr), __i(0) {}
        iterator(const deque *d, size_t i) : __d(d), __i(i) {}
        T &operator*() const { return const_cast<deque *>(__d)->operator[](__i); }
        T *operator->() const { return addressof(**this); }
        iterator &operator++() { ++__i; return *this; }
        iterator operator++(int) { iterator t = *this; ++__i; return t; }
        iterator &operator--() { --__i; return *this; }
        iterator operator--(int) { iterator t = *this; --__i; return t; }
        /* A random_access_iterator_tag is a PROMISE about what exists,
         * and std::advance dispatches on it -- so every one of these has
         * to be here or the promise is a lie that fails at the first
         * generic algorithm. */
        iterator operator+(ptrdiff_t n) const { return iterator(__d, __i + n); }
        iterator operator-(ptrdiff_t n) const { return iterator(__d, __i - n); }
        iterator &operator+=(ptrdiff_t n) { __i += n; return *this; }
        iterator &operator-=(ptrdiff_t n) { __i -= n; return *this; }
        ptrdiff_t operator-(const iterator &o) const
        { return (ptrdiff_t)__i - (ptrdiff_t)o.__i; }
        T &operator[](ptrdiff_t n) const { return *(*this + n); }
        bool operator==(const iterator &o) const { return __i == o.__i; }
        bool operator!=(const iterator &o) const { return __i != o.__i; }
        bool operator<(const iterator &o) const { return __i < o.__i; }
        bool operator>(const iterator &o) const { return __i > o.__i; }
        bool operator<=(const iterator &o) const { return __i <= o.__i; }
        bool operator>=(const iterator &o) const { return __i >= o.__i; }
    private:
        const deque *__d;
        size_t __i;
    };
    using const_iterator = iterator;

    deque() : __b(nullptr), __cap(0), __start(0), __n(0) {}
    deque(initializer_list<T> l) : deque() { for (auto &v : l) push_back(v); }
    deque(size_type n, const T &v) : deque()
    { for (size_type i = 0; i < n; i++) push_back(v); }

    deque(const deque &o) : deque()
    { for (size_type i = 0; i < o.__n; i++) push_back(o[i]); }

    deque(deque &&o) noexcept
        : __b(o.__b), __cap(o.__cap), __start(o.__start), __n(o.__n)
    { o.__b = nullptr; o.__cap = 0; o.__start = 0; o.__n = 0; }

    ~deque() { clear(); ::operator delete(__b); }

    deque &operator=(const deque &o)
    {
        if (this != addressof(o)) {
            clear();
            for (size_type i = 0; i < o.__n; i++) push_back(o[i]);
        }
        return *this;
    }
    deque &operator=(deque &&o) noexcept
    {
        if (this != addressof(o)) {
            clear();
            ::operator delete(__b);
            __b = o.__b; __cap = o.__cap; __start = o.__start; __n = o.__n;
            o.__b = nullptr; o.__cap = 0; o.__start = 0; o.__n = 0;
        }
        return *this;
    }

    bool empty() const noexcept { return __n == 0; }
    size_type size() const noexcept { return __n; }

    T &operator[](size_type i) { return __at(i); }
    const T &operator[](size_type i) const
    { return const_cast<deque *>(this)->__at(i); }
    T &at(size_type i)
    { if (i >= __n) __throw_deque_out_of_range(); return __at(i); }
    const T &at(size_type i) const
    { if (i >= __n) __throw_deque_out_of_range(); return __at(i); }

    T &front() { return __at(0); }
    const T &front() const { return const_cast<deque *>(this)->__at(0); }
    T &back() { return __at(__n - 1); }
    const T &back() const { return const_cast<deque *>(this)->__at(__n - 1); }

    iterator begin() const { return iterator(this, 0); }
    iterator end() const { return iterator(this, __n); }

    void clear()
    {
        for (size_type i = 0; i < __n; i++) destroy_at(addressof(__at(i)));
        __n = 0;
        __start = 0;
    }

    void push_back(const T &v) { __grow(); construct_at(&__slot(__n), v); ++__n; }
    void push_back(T &&v)
    { __grow(); construct_at(&__slot(__n), std::move(v)); ++__n; }

    /* The only reason to use a deque: O(1) at the front, where a
     * vector's insert(begin()) shifts every element. */
    void push_front(const T &v)
    {
        __grow();
        __start = (__start + __cap - 1) & (__cap - 1);
        construct_at(&__slot(0), v);
        ++__n;
    }

    template <class... Args>
    T &emplace_back(Args &&...args)
    { __grow(); construct_at(&__slot(__n), forward<Args>(args)...); return __at(__n++); }

    void pop_back() { destroy_at(addressof(__at(__n - 1))); --__n; }
    void pop_front()
    {
        destroy_at(addressof(__at(0)));
        __start = (__start + 1) & (__cap - 1);
        --__n;
    }

    void swap(deque &o) noexcept
    {
        using std::swap;
        swap(__b, o.__b); swap(__cap, o.__cap);
        swap(__start, o.__start); swap(__n, o.__n);
    }

private:
    T *__b;
    size_type __cap, __start, __n;

    T &__slot(size_type i) { return __b[(__start + i) & (__cap - 1)]; }
    T &__at(size_type i) { return __slot(i); }

    void __grow()
    {
        if (__n < __cap) return;
        size_type nc = __cap ? __cap * 2 : 8;
        T *nb = static_cast<T *>(::operator new(nc * sizeof(T)));
        /* Unrolled into a linear order, which is also what makes the new
         * block start at 0 -- and why a reference into the old block does
         * not survive. */
        for (size_type i = 0; i < __n; i++) {
            construct_at(nb + i, std::move(__at(i)));
            destroy_at(addressof(__at(i)));
        }
        ::operator delete(__b);
        __b = nb;
        __cap = nc;
        __start = 0;
    }

    [[noreturn]] static void __throw_deque_out_of_range();
};

template <class T, class A>
void deque<T, A>::__throw_deque_out_of_range()
{ throw out_of_range("deque::at: index out of range"); }

template <class T, class A>
bool operator==(const deque<T, A> &a, const deque<T, A> &b)
{
    if (a.size() != b.size()) return false;
    for (size_t i = 0; i < a.size(); i++) if (!(a[i] == b[i])) return false;
    return true;
}
template <class T, class A>
bool operator!=(const deque<T, A> &a, const deque<T, A> &b) { return !(a == b); }

}  // namespace std

#endif
