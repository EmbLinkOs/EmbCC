# Where EmbCC differs from GCC 16 on purpose, or has not got there yet.
#
# C++26's pack indexing (T...[N], args...[i]), which GCC 16 takes from
# C++11 on: not implemented yet; refused by name (cxx/tok.c).
cxx26-pack-index c++11 plain
cxx26-pack-index c++14 plain
cxx26-pack-index c++17 plain
cxx26-pack-index c++20 plain
cxx26-pack-index c++23 plain
cxx26-pack-index c++26 pedantic
cxx26-pack-index c++26 plain
cxx26-pack-index gnu++11 plain
cxx26-pack-index gnu++14 plain
cxx26-pack-index gnu++17 plain
cxx26-pack-index gnu++20 plain
cxx26-pack-index gnu++23 plain
cxx26-pack-index gnu++26 pedantic
cxx26-pack-index gnu++26 plain
