<?xml version="1.0" encoding="utf-8"?>
<!-- embsvd's feature test: every kind of cluster, array and derivedFrom
     that embsvd lays out. The addresses each one should land at are worked
     out by hand in layout.c, from this file and the CMSIS-SVD
     specification. -->
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>EmbLinkOs</vendor>
  <name>FEATURES</name>
  <version>1.0</version>
  <description>A device made of SVD features</description>
  <cpu>
    <name>CM4</name>
    <revision>r0p1</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>1</fpuPresent>
    <nvicPrioBits>3</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>

    <!-- DMA: register arrays of every kind, a cluster array padded to its
         increment, a read-only and a write-only register at one offset,
         and registers and fields derivedFrom others -->
    <peripheral>
      <name>DMA</name>
      <description>DMA controller</description>
      <groupName>DMA</groupName>
      <baseAddress>0x40001000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>DMA</name>
        <description>DMA channel done</description>
        <value>5</value>
      </interrupt>
      <registers>
        <register>
          <name>CTRL</name>
          <description>Control</description>
          <addressOffset>0x000</addressOffset>
          <resetValue>0x00000010</resetValue>
          <fields>
            <field>
              <name>EN</name>
              <description>Enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <name>ENV</name>
                <enumeratedValue>
                  <name>Disabled</name>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MODE</name>
              <description>Mode</description>
              <bitRange>[2:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <name>MODEV</name>
                <usage>read</usage>
                <enumeratedValue>
                  <name>Single</name>
                  <value>#00</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Burst</name>
                  <value>#1x</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Other</name>
                  <isDefault>true</isDefault>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PRI</name>
              <description>Priority</description>
              <lsb>4</lsb>
              <msb>6</msb>
              <enumeratedValues derivedFrom="ENV"/>
            </field>
            <field derivedFrom="EN">
              <name>EN2</name>
              <description>Second enable</description>
              <bitOffset>8</bitOffset>
            </field>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <name>CH%s_IE</name>
              <description>Channel interrupt enable</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <description>Status</description>
          <addressOffset>0x004</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>CLEAR</name>
          <description>Clear status</description>
          <addressOffset>0x004</addressOffset>
          <access>write-only</access>
        </register>
        <cluster>
          <dim>4</dim>
          <dimIncrement>0x20</dimIncrement>
          <name>CH[%s]</name>
          <description>Channel</description>
          <headerStructName>DMA_CH</headerStructName>
          <addressOffset>0x100</addressOffset>
          <register>
            <name>SRC</name>
            <description>Source</description>
            <addressOffset>0x0</addressOffset>
          </register>
          <register>
            <name>DST</name>
            <description>Destination</description>
            <addressOffset>0x4</addressOffset>
          </register>
          <register>
            <name>CNT</name>
            <description>Count</description>
            <addressOffset>0x8</addressOffset>
            <size>16</size>
          </register>
          <register>
            <name>CFG</name>
            <description>Configuration</description>
            <addressOffset>0xC</addressOffset>
          </register>
        </cluster>
        <register>
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <name>DATA[%s]</name>
          <description>Data, a C array</description>
          <addressOffset>0x200</addressOffset>
        </register>
        <register>
          <dim>3</dim>
          <dimIncrement>8</dimIncrement>
          <name>PRIO[%s]</name>
          <description>Priority, 8 bytes apart</description>
          <addressOffset>0x210</addressOffset>
        </register>
        <register>
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>A,B,C</dimIndex>
          <name>GPIO%s_CTRL</name>
          <description>Port control</description>
          <addressOffset>0x230</addressOffset>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>8-15</dimIndex>
          <name>IRQ%s</name>
          <description>Interrupt line</description>
          <addressOffset>0x240</addressOffset>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>2</dimIncrement>
          <dimIndex>A-D</dimIndex>
          <name>MODE%s</name>
          <description>Lane mode</description>
          <addressOffset>0x260</addressOffset>
          <size>16</size>
        </register>
        <register derivedFrom="CTRL">
          <name>CTRL2</name>
          <description>Control, again</description>
          <addressOffset>0x270</addressOffset>
        </register>
        <register derivedFrom="DATA">
          <name>DATAX</name>
          <description>One more data register</description>
          <addressOffset>0x280</addressOffset>
        </register>
      </registers>
    </peripheral>

    <!-- NET: clusters nested three deep, each an array, named by
         headerStructName or after their parents; a %s cluster array; a
         cluster derivedFrom another; two alternate clusters -->
    <peripheral>
      <name>NET</name>
      <description>Network interface</description>
      <groupName>NET</groupName>
      <baseAddress>0x40002000</baseAddress>
      <headerStructName>NETIF</headerStructName>
      <interrupt>
        <name>NET</name>
        <value>6</value>
      </interrupt>
      <registers>
        <register>
          <name>ID</name>
          <description>Identification</description>
          <addressOffset>0x0</addressOffset>
          <access>read-only</access>
          <resetValue>0x00004E01</resetValue>
          <fields>
            <field>
              <name>REV</name>
              <bitRange>[7:0]</bitRange>
            </field>
            <field derivedFrom="DMA.CTRL.MODE">
              <name>VENDOR</name>
              <description>Vendor</description>
              <bitOffset>8</bitOffset>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>2</dim>
          <dimIncrement>0x100</dimIncrement>
          <name>PORT[%s]</name>
          <description>Port</description>
          <addressOffset>0x100</addressOffset>
          <register>
            <name>CFG</name>
            <description>Port configuration</description>
            <addressOffset>0x0</addressOffset>
            <fields>
              <field>
                <name>SPEED</name>
                <bitOffset>0</bitOffset>
                <bitWidth>2</bitWidth>
              </field>
            </fields>
          </register>
          <cluster>
            <dim>4</dim>
            <dimIncrement>0x20</dimIncrement>
            <name>QUEUE[%s]</name>
            <description>Queue</description>
            <headerStructName>NET_QUEUE</headerStructName>
            <addressOffset>0x10</addressOffset>
            <register>
              <name>HEAD</name>
              <addressOffset>0x0</addressOffset>
            </register>
            <register>
              <name>TAIL</name>
              <addressOffset>0x4</addressOffset>
            </register>
            <cluster>
              <dim>2</dim>
              <dimIncrement>8</dimIncrement>
              <name>DESC[%s]</name>
              <description>Descriptor</description>
              <addressOffset>0x8</addressOffset>
              <register>
                <name>ADDR</name>
                <addressOffset>0x0</addressOffset>
              </register>
              <register>
                <name>LEN</name>
                <addressOffset>0x4</addressOffset>
                <size>16</size>
                <fields>
                  <field>
                    <name>N</name>
                    <bitOffset>0</bitOffset>
                    <bitWidth>12</bitWidth>
                  </field>
                </fields>
              </register>
              <register>
                <name>FLAGS</name>
                <addressOffset>0x6</addressOffset>
                <size>16</size>
              </register>
            </cluster>
          </cluster>
          <cluster>
            <name>STAT</name>
            <description>Counters</description>
            <addressOffset>0x90</addressOffset>
            <size>16</size>
            <access>read-only</access>
            <register>
              <name>RX</name>
              <addressOffset>0x0</addressOffset>
            </register>
            <register>
              <name>TX</name>
              <addressOffset>0x2</addressOffset>
            </register>
          </cluster>
        </cluster>
        <cluster>
          <dim>2</dim>
          <dimIncrement>0x10</dimIncrement>
          <dimIndex>L,R</dimIndex>
          <name>LANE%s</name>
          <description>Lane</description>
          <addressOffset>0x400</addressOffset>
          <register>
            <name>EN</name>
            <addressOffset>0x0</addressOffset>
          </register>
          <register>
            <name>LVL</name>
            <addressOffset>0x4</addressOffset>
          </register>
        </cluster>
        <cluster derivedFrom="LANE">
          <name>SPARE</name>
          <description>A spare lane</description>
          <addressOffset>0x500</addressOffset>
        </cluster>
        <cluster>
          <name>MODE_A</name>
          <description>The block in mode A</description>
          <addressOffset>0x600</addressOffset>
          <register>
            <name>REGA</name>
            <addressOffset>0x0</addressOffset>
          </register>
          <register>
            <name>REGB</name>
            <addressOffset>0x4</addressOffset>
          </register>
        </cluster>
        <cluster>
          <name>MODE_B</name>
          <description>The block in mode B</description>
          <alternateCluster>MODE_A</alternateCluster>
          <addressOffset>0x600</addressOffset>
          <register>
            <name>X</name>
            <addressOffset>0x0</addressOffset>
          </register>
          <register>
            <name>Y</name>
            <addressOffset>0x4</addressOffset>
          </register>
          <register>
            <name>Z</name>
            <addressOffset>0x8</addressOffset>
          </register>
        </cluster>
        <register>
          <name>AFTER</name>
          <addressOffset>0x610</addressOffset>
        </register>
      </registers>
    </peripheral>

    <peripheral derivedFrom="NET">
      <name>NET2</name>
      <baseAddress>0x40003000</baseAddress>
      <interrupt>
        <name>NET2</name>
        <value>7</value>
      </interrupt>
    </peripheral>

    <!-- TIMER0..TIMER2: an array of peripherals; a register and a cluster
         derivedFrom another peripheral's, by their full paths -->
    <peripheral>
      <dim>3</dim>
      <dimIncrement>0x400</dimIncrement>
      <name>TIMER%s</name>
      <description>Timer</description>
      <baseAddress>0x40004000</baseAddress>
      <registers>
        <register>
          <name>LOAD</name>
          <addressOffset>0x0</addressOffset>
        </register>
        <register>
          <name>VAL</name>
          <addressOffset>0x4</addressOffset>
          <access>read-only</access>
        </register>
        <cluster>
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <name>CC[%s]</name>
          <description>Capture/compare</description>
          <addressOffset>0x10</addressOffset>
          <register>
            <name>VALUE</name>
            <addressOffset>0x0</addressOffset>
          </register>
        </cluster>
        <register derivedFrom="NET.PORT.CFG">
          <name>COPY</name>
          <description>Like a port's CFG</description>
          <addressOffset>0x20</addressOffset>
        </register>
        <cluster derivedFrom="NET.LANE">
          <name>LANEX</name>
          <description>A lane of its own</description>
          <addressOffset>0x30</addressOffset>
        </cluster>
      </registers>
    </peripheral>

  </peripherals>
</device>
