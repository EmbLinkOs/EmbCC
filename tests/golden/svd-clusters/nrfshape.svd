<?xml version="1.0" encoding="utf-8"?>
<!-- A device in the shape of Nordic Semiconductor's nRF54L SVD files,
     written for embsvd's test (no Nordic text is copied): a
     headerDefinitionsPrefix, headerStructName on every peripheral and
     cluster, clusters nested three deep in arrays, a cluster that is
     another's alternate, secure and non-secure copies of peripherals
     derivedFrom each other, cpu booleans written 1 and 0, and access
     written read-writeonce. -->
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Nordic-shaped</vendor>
  <vendorID>Shape</vendorID>
  <name>nrfshape_application</name>
  <series>nrfshape</series>
  <version>1</version>
  <description>A 32-bit Arm Cortex-M33 system-on-chip, in outline</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <headerDefinitionsPrefix>NRF_</headerDefinitionsPrefix>
  <cpu>
    <name>CM33</name>
    <revision>r0p4</revision>
    <endian>little</endian>
    <mpuPresent>1</mpuPresent>
    <fpuPresent>1</fpuPresent>
    <nvicPrioBits>3</nvicPrioBits>
    <vendorSystickConfig>0</vendorSystickConfig>
    <deviceNumInterrupts>270</deviceNumInterrupts>
    <sauNumRegions>4</sauNumRegions>
  </cpu>
  <headerSystemFilename>system_nrfshape_application</headerSystemFilename>
  <peripherals>
    <peripheral>
      <name>ICACHEDATA_S</name>
      <description>CACHEDATA</description>
      <baseAddress>0x12F00000</baseAddress>
      <headerStructName>CACHEDATA</headerStructName>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>CACHEDATA</groupName>
      <size>0x20</size>
      <registers>
        <cluster>
          <dim>4</dim>
          <dimIncrement>0x040</dimIncrement>
          <name>SET[%s]</name>
          <description>Unspecified</description>
          <headerStructName>CACHEDATA_SET</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0</addressOffset>
          <cluster>
            <dim>2</dim>
            <dimIncrement>0x020</dimIncrement>
            <name>WAY[%s]</name>
            <description>Unspecified</description>
            <headerStructName>CACHEDATA_SET_WAY</headerStructName>
            <access>read-write</access>
            <addressOffset>0x0</addressOffset>
            <cluster>
              <dim>4</dim>
              <dimIncrement>0x008</dimIncrement>
              <name>DU[%s]</name>
              <description>Unspecified</description>
              <headerStructName>CACHEDATA_SET_WAY_DU</headerStructName>
              <access>read-write</access>
              <addressOffset>0x0</addressOffset>
              <register>
                <dim>0x2</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>DATA[%s]</name>
                <description>Description collection: Cache data bits for DATA[q] in DU[p] of SET[n], WAY[o].</description>
                <addressOffset>0x0</addressOffset>
                <access>read-write</access>
                <resetValue>0x00000000</resetValue>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>Data</name>
                    <description>Data</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
            </cluster>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>SPU00_S</name>
      <description>System protection unit 0</description>
      <baseAddress>0x50040000</baseAddress>
      <headerStructName>SPU</headerStructName>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SPU00</name>
        <value>64</value>
      </interrupt>
      <registers>
        <register>
          <name>EVENTS_PERIPHACCERR</name>
          <description>A security violation has been detected on one or several peripherals</description>
          <addressOffset>0x100</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>EVENTS_PERIPHACCERR</name>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotGenerated</name>
                  <description>Event not generated</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Generated</name>
                  <description>Event generated</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>64</dim>
          <dimIncrement>0x004</dimIncrement>
          <name>PERIPH[%s]</name>
          <description>Unspecified</description>
          <headerStructName>SPU_PERIPH</headerStructName>
          <addressOffset>0x500</addressOffset>
          <register>
            <name>PERM</name>
            <description>Description cluster: Get and set the applicable access permissions for the peripheral slave index n</description>
            <addressOffset>0x000</addressOffset>
            <access>read-writeonce</access>
            <resetValue>0x00000012</resetValue>
            <fields>
              <field>
                <name>SECUREMAPPING</name>
                <lsb>0</lsb>
                <msb>1</msb>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue><name>NonSecure</name><value>0x0</value></enumeratedValue>
                  <enumeratedValue><name>Secure</name><value>0x1</value></enumeratedValue>
                  <enumeratedValue><name>UserSelectable</name><value>0x2</value></enumeratedValue>
                  <enumeratedValue><name>Split</name><value>0x3</value></enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SECATTR</name>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>LOCK</name>
                <lsb>8</lsb>
                <msb>8</msb>
                <modifiedWriteValues>oneToSet</modifiedWriteValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>FEATURE</name>
          <description>Unspecified</description>
          <headerStructName>SPU_FEATURE</headerStructName>
          <addressOffset>0x600</addressOffset>
          <cluster>
            <name>DPPIC</name>
            <description>Unspecified</description>
            <headerStructName>SPU_FEATURE_DPPIC</headerStructName>
            <addressOffset>0x080</addressOffset>
            <register>
              <dim>24</dim>
              <dimIncrement>0x4</dimIncrement>
              <name>CH[%s]</name>
              <description>Description collection: Security configuration for channel n of DPPIC.</description>
              <addressOffset>0x000</addressOffset>
            </register>
            <register>
              <dim>8</dim>
              <dimIncrement>0x4</dimIncrement>
              <name>CHG[%s]</name>
              <description>Description collection: Security configuration for channel group n of DPPIC.</description>
              <addressOffset>0x060</addressOffset>
            </register>
          </cluster>
          <cluster>
            <dim>2</dim>
            <dimIncrement>0x080</dimIncrement>
            <name>GPIO[%s]</name>
            <description>Unspecified</description>
            <headerStructName>SPU_FEATURE_GPIO</headerStructName>
            <addressOffset>0x100</addressOffset>
            <register>
              <dim>32</dim>
              <dimIncrement>0x4</dimIncrement>
              <name>PIN[%s]</name>
              <description>Description collection: Security configuration for GPIO pin.</description>
              <addressOffset>0x000</addressOffset>
            </register>
          </cluster>
          <cluster>
            <name>CRACEN</name>
            <description>Unspecified</description>
            <headerStructName>CRACEN</headerStructName>
            <alternateCluster>GPIO[%s]</alternateCluster>
            <addressOffset>0x100</addressOffset>
            <register>
              <name>SEED</name>
              <description>Configuration for CRACEN SEED</description>
              <addressOffset>0x000</addressOffset>
            </register>
            <register>
              <name>CRACENCORE</name>
              <description>Configuration for CRACEN core</description>
              <addressOffset>0x004</addressOffset>
            </register>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>DPPIC00_NS</name>
      <description>Distributed programmable peripheral interconnect controller 0</description>
      <baseAddress>0x40042000</baseAddress>
      <headerStructName>DPPIC</headerStructName>
      <registers>
        <cluster>
          <dim>6</dim>
          <dimIncrement>0x008</dimIncrement>
          <name>TASKS_CHG[%s]</name>
          <description>Channel group tasks</description>
          <headerStructName>DPPIC_TASKS_CHG</headerStructName>
          <addressOffset>0x000</addressOffset>
          <register>
            <name>EN</name>
            <description>Description cluster: Enable channel group n</description>
            <addressOffset>0x000</addressOffset>
            <access>write-only</access>
          </register>
          <register>
            <name>DIS</name>
            <description>Description cluster: Disable channel group n</description>
            <addressOffset>0x004</addressOffset>
            <access>write-only</access>
          </register>
        </cluster>
        <cluster>
          <dim>6</dim>
          <dimIncrement>0x008</dimIncrement>
          <name>SUBSCRIBE_CHG[%s]</name>
          <description>Subscribe configuration for tasks</description>
          <addressOffset>0x080</addressOffset>
          <register>
            <name>EN</name>
            <addressOffset>0x000</addressOffset>
          </register>
          <register>
            <name>DIS</name>
            <addressOffset>0x004</addressOffset>
          </register>
        </cluster>
        <register>
          <name>CHEN</name>
          <description>Channel enable register</description>
          <addressOffset>0x500</addressOffset>
        </register>
        <register>
          <dim>6</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>CHG[%s]</name>
          <description>Description collection: Channel group n</description>
          <addressOffset>0x800</addressOffset>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="DPPIC00_NS">
      <name>DPPIC00_S</name>
      <description>Distributed programmable peripheral interconnect controller 1</description>
      <baseAddress>0x50042000</baseAddress>
    </peripheral>
    <peripheral>
      <name>GLOBAL_CRACEN_S</name>
      <description>CRACEN</description>
      <baseAddress>0x50048000</baseAddress>
      <headerStructName>CRACEN</headerStructName>
      <interrupt>
        <name>CRACEN</name>
        <value>72</value>
      </interrupt>
      <registers>
        <register>
          <name>ENABLE</name>
          <description>Enable CRACEN peripheral modules.</description>
          <addressOffset>0x400</addressOffset>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>UARTE00_NS</name>
      <description>UART with EasyDMA 0</description>
      <baseAddress>0x4004A000</baseAddress>
      <headerStructName>UARTE</headerStructName>
      <interrupt>
        <name>SERIAL00</name>
        <value>74</value>
      </interrupt>
      <registers>
        <register>
          <name>TASKS_STARTRX</name>
          <addressOffset>0x000</addressOffset>
          <access>write-only</access>
        </register>
        <register>
          <name>TASKS_STOPRX</name>
          <addressOffset>0x004</addressOffset>
          <access>write-only</access>
        </register>
        <register>
          <name>SUBSCRIBE_STARTRX</name>
          <addressOffset>0x080</addressOffset>
        </register>
        <register>
          <name>EVENTS_CTS</name>
          <addressOffset>0x100</addressOffset>
        </register>
        <cluster>
          <name>EVENTS_DMA</name>
          <description>Peripheral events.</description>
          <headerStructName>UARTE_EVENTS_DMA</headerStructName>
          <addressOffset>0x14C</addressOffset>
          <cluster>
            <name>RX</name>
            <description>Peripheral events.</description>
            <headerStructName>UARTE_EVENTS_DMA_RX</headerStructName>
            <addressOffset>0x000</addressOffset>
            <register>
              <name>END</name>
              <addressOffset>0x000</addressOffset>
            </register>
            <register>
              <name>READY</name>
              <addressOffset>0x004</addressOffset>
            </register>
            <register>
              <name>BUSERROR</name>
              <addressOffset>0x008</addressOffset>
            </register>
          </cluster>
          <cluster>
            <name>TX</name>
            <description>Peripheral events.</description>
            <headerStructName>UARTE_EVENTS_DMA_TX</headerStructName>
            <addressOffset>0x01C</addressOffset>
            <register>
              <name>END</name>
              <addressOffset>0x000</addressOffset>
            </register>
            <register>
              <name>READY</name>
              <addressOffset>0x004</addressOffset>
            </register>
          </cluster>
        </cluster>
        <register>
          <name>INTEN</name>
          <addressOffset>0x300</addressOffset>
        </register>
        <register>
          <name>ERRORSRC</name>
          <description>Error source</description>
          <addressOffset>0x480</addressOffset>
          <access>read-writeonce</access>
        </register>
        <register>
          <name>ENABLE</name>
          <description>Enable UART</description>
          <addressOffset>0x500</addressOffset>
          <fields>
            <field>
              <name>ENABLE</name>
              <lsb>0</lsb>
              <msb>3</msb>
              <enumeratedValues>
                <enumeratedValue><name>Disabled</name><value>0x0</value></enumeratedValue>
                <enumeratedValue><name>Enabled</name><value>0x8</value></enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>BAUDRATE</name>
          <addressOffset>0x524</addressOffset>
          <resetValue>0x04000000</resetValue>
        </register>
        <register>
          <name>CONFIG</name>
          <addressOffset>0x56C</addressOffset>
        </register>
        <cluster>
          <name>PSEL</name>
          <description>Unspecified</description>
          <headerStructName>UARTE_PSEL</headerStructName>
          <addressOffset>0x604</addressOffset>
          <register>
            <name>TXD</name>
            <addressOffset>0x000</addressOffset>
            <resetValue>0xFFFFFFFF</resetValue>
            <fields>
              <field>
                <name>PIN</name>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>PORT</name>
                <lsb>5</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>CONNECT</name>
                <lsb>31</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue><name>Connected</name><value>0x0</value></enumeratedValue>
                  <enumeratedValue><name>Disconnected</name><value>0x1</value></enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CTS</name>
            <addressOffset>0x004</addressOffset>
            <resetValue>0xFFFFFFFF</resetValue>
          </register>
          <register>
            <name>RXD</name>
            <addressOffset>0x008</addressOffset>
            <resetValue>0xFFFFFFFF</resetValue>
          </register>
          <register>
            <name>RTS</name>
            <addressOffset>0x00C</addressOffset>
            <resetValue>0xFFFFFFFF</resetValue>
          </register>
        </cluster>
        <cluster>
          <name>DMA</name>
          <description>Unspecified</description>
          <headerStructName>UARTE_DMA</headerStructName>
          <addressOffset>0x700</addressOffset>
          <cluster>
            <name>RX</name>
            <description>Unspecified</description>
            <headerStructName>UARTE_DMA_RX</headerStructName>
            <addressOffset>0x000</addressOffset>
            <register>
              <name>PTR</name>
              <addressOffset>0x004</addressOffset>
            </register>
            <register>
              <name>MAXCNT</name>
              <addressOffset>0x008</addressOffset>
            </register>
            <register>
              <name>AMOUNT</name>
              <addressOffset>0x00C</addressOffset>
              <access>read-only</access>
            </register>
          </cluster>
          <cluster>
            <name>TX</name>
            <description>Unspecified</description>
            <headerStructName>UARTE_DMA_TX</headerStructName>
            <addressOffset>0x038</addressOffset>
            <register>
              <name>PTR</name>
              <addressOffset>0x004</addressOffset>
            </register>
            <register>
              <name>MAXCNT</name>
              <addressOffset>0x008</addressOffset>
            </register>
            <register>
              <name>AMOUNT</name>
              <addressOffset>0x00C</addressOffset>
              <access>read-only</access>
            </register>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
    <peripheral derivedFrom="UARTE00_NS">
      <name>UARTE00_S</name>
      <description>UART with EasyDMA 1</description>
      <baseAddress>0x5004A000</baseAddress>
      <interrupt>
        <name>SERIAL00</name>
        <value>74</value>
      </interrupt>
    </peripheral>
    <peripheral>
      <name>P0_NS</name>
      <description>GPIO Port 0</description>
      <baseAddress>0x4010A000</baseAddress>
      <headerStructName>GPIO</headerStructName>
      <registers>
        <register>
          <name>OUT</name>
          <addressOffset>0x000</addressOffset>
        </register>
        <register>
          <name>OUTSET</name>
          <addressOffset>0x004</addressOffset>
        </register>
        <register>
          <name>IN</name>
          <addressOffset>0x010</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <dim>32</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PIN_CNF[%s]</name>
          <description>Description collection: Pin n configuration of GPIO pin</description>
          <addressOffset>0x080</addressOffset>
          <resetValue>0x00000002</resetValue>
          <fields>
            <field>
              <name>DIR</name>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue><name>Input</name><value>0x0</value></enumeratedValue>
                <enumeratedValue><name>Output</name><value>0x1</value></enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PULL</name>
              <lsb>2</lsb>
              <msb>3</msb>
              <enumeratedValues>
                <enumeratedValue><name>Disabled</name><value>0x0</value></enumeratedValue>
                <enumeratedValue><name>Pulldown</name><value>0x1</value></enumeratedValue>
                <enumeratedValue><name>Pullup</name><value>0x3</value></enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="P0_NS">
      <name>P1_NS</name>
      <description>GPIO Port 1</description>
      <baseAddress>0x400D8200</baseAddress>
    </peripheral>
    <peripheral derivedFrom="P1_NS">
      <name>P1_S</name>
      <description>GPIO Port 1, secure</description>
      <baseAddress>0x500D8200</baseAddress>
    </peripheral>
  </peripherals>
</device>
