<?xml version="1.0" encoding="utf-8"?>
<!-- EmbSim's register file, every behaviour an SVD can give a register:
     tests/golden/embsim-svd.sh runs regs.c over it on the mps2-an386, and
     regs.txt is what the CMSIS-SVD specification says each access gives. -->
<device schemaVersion="1.3">
  <name>EMBSIMTEST</name>
  <version>1.0</version>
  <description>EmbSim's register-file test device</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <!-- access types, reserved bits, narrow registers, a hole -->
    <peripheral>
      <name>ACC</name>
      <baseAddress>0x40010000</baseAddress>
      <addressBlock><offset>0</offset><size>0x100</size><usage>registers</usage></addressBlock>
      <interrupt><name>ACC_IRQ</name><value>3</value></interrupt>
      <registers>
        <register><name>RW</name><addressOffset>0x00</addressOffset><resetValue>0x12345678</resetValue></register>
        <register><name>RO</name><addressOffset>0x04</addressOffset><access>read-only</access><resetValue>0xA5A5A5A5</resetValue></register>
        <register><name>WO</name><addressOffset>0x08</addressOffset><access>write-only</access><resetValue>0x77</resetValue></register>
        <register><name>ONCE</name><addressOffset>0x0C</addressOffset><access>writeOnce</access></register>
        <register><name>RONCE</name><addressOffset>0x10</addressOffset><access>read-writeOnce</access><resetValue>0x11</resetValue></register>
        <register>
          <name>MIX</name>
          <addressOffset>0x14</addressOffset>
          <resetValue>0xFFFFFF0F</resetValue>
          <fields>
            <field><name>A</name><bitOffset>0</bitOffset><bitWidth>4</bitWidth></field>
            <field><name>B</name><bitOffset>4</bitOffset><bitWidth>4</bitWidth><access>read-only</access></field>
            <field><name>C</name><bitOffset>8</bitOffset><bitWidth>4</bitWidth><access>write-only</access></field>
            <field><name>D</name><bitRange>[15:12]</bitRange></field>
          </fields>
        </register>
        <register><name>B8</name><addressOffset>0x18</addressOffset><size>8</size><resetValue>0x5A</resetValue></register>
        <register><name>B8B</name><addressOffset>0x19</addressOffset><size>8</size></register>
        <register><name>H16</name><addressOffset>0x1A</addressOffset><size>16</size><resetValue>0xBEEF</resetValue></register>
        <register><name>LAST</name><addressOffset>0x20</addressOffset></register>
      </registers>
    </peripheral>
    <!-- modifiedWriteValues and readAction -->
    <peripheral>
      <name>MWV</name>
      <baseAddress>0x40011000</baseAddress>
      <registers>
        <register>
          <name>FLAGS</name>
          <addressOffset>0x0</addressOffset>
          <resetValue>0x5A5A5A5A</resetValue>
          <fields>
            <field><name>O2C</name><bitRange>[3:0]</bitRange><modifiedWriteValues>oneToClear</modifiedWriteValues></field>
            <field><name>O2S</name><bitRange>[7:4]</bitRange><modifiedWriteValues>oneToSet</modifiedWriteValues></field>
            <field><name>O2T</name><bitRange>[11:8]</bitRange><modifiedWriteValues>oneToToggle</modifiedWriteValues></field>
            <field><name>Z2C</name><bitRange>[15:12]</bitRange><modifiedWriteValues>zeroToClear</modifiedWriteValues></field>
            <field><name>Z2S</name><bitRange>[19:16]</bitRange><modifiedWriteValues>zeroToSet</modifiedWriteValues></field>
            <field><name>Z2T</name><bitRange>[23:20]</bitRange><modifiedWriteValues>zeroToToggle</modifiedWriteValues></field>
            <field><name>CLR</name><bitRange>[27:24]</bitRange><modifiedWriteValues>clear</modifiedWriteValues></field>
            <field><name>SET</name><bitRange>[31:28]</bitRange><modifiedWriteValues>set</modifiedWriteValues></field>
          </fields>
        </register>
        <register>
          <name>W1C</name>
          <addressOffset>0x4</addressOffset>
          <resetValue>0xFF</resetValue>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
        </register>
        <register>
          <name>EV</name>
          <addressOffset>0x8</addressOffset>
          <resetValue>0x5</resetValue>
          <fields>
            <field><name>E0</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><readAction>clear</readAction></field>
            <field><name>E1</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth><readAction>set</readAction></field>
            <field><name>E2</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth><readAction>modify</readAction></field>
          </fields>
        </register>
        <register>
          <name>RC</name>
          <addressOffset>0xC</addressOffset>
          <resetValue>0xCAFE</resetValue>
          <readAction>clear</readAction>
        </register>
        <register>
          <name>MODE</name>
          <addressOffset>0x10</addressOffset>
          <fields>
            <field>
              <name>SEL</name><bitOffset>0</bitOffset><bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue><name>Off</name><value>0</value></enumeratedValue>
                <enumeratedValue><name>Slow</name><value>1</value></enumeratedValue>
                <enumeratedValue><name>Fast</name><value>2</value></enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!-- clusters, arrays, derivedFrom -->
    <peripheral>
      <name>ARR</name>
      <baseAddress>0x40012000</baseAddress>
      <registers>
        <cluster>
          <dim>3</dim>
          <dimIncrement>0x10</dimIncrement>
          <name>CH[%s]</name>
          <addressOffset>0x0</addressOffset>
          <resetValue>0x100</resetValue>
          <register><name>CTRL</name><addressOffset>0x0</addressOffset></register>
          <register><name>DATA</name><addressOffset>0x4</addressOffset><resetValue>0x7</resetValue></register>
          <register><name>STAT</name><addressOffset>0x8</addressOffset><access>read-only</access><resetValue>0x2</resetValue></register>
        </cluster>
        <register>
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>A,B,C,D</dimIndex>
          <name>R%s</name>
          <addressOffset>0x40</addressOffset>
          <resetValue>0xAA</resetValue>
        </register>
        <register>
          <name>BASE</name>
          <addressOffset>0x50</addressOffset>
          <resetValue>0x1234</resetValue>
          <fields>
            <field><name>F</name><bitRange>[7:0]</bitRange><modifiedWriteValues>oneToClear</modifiedWriteValues></field>
            <field><name>G</name><bitRange>[15:8]</bitRange></field>
          </fields>
        </register>
        <register derivedFrom="BASE">
          <name>DER</name>
          <addressOffset>0x54</addressOffset>
        </register>
        <register>
          <name>FA</name>
          <addressOffset>0x58</addressOffset>
          <fields>
            <field><dim>4</dim><dimIncrement>2</dimIncrement><name>EN%s</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="ARR">
      <name>ARR2</name>
      <baseAddress>0x40013000</baseAddress>
    </peripheral>
  </peripherals>
</device>
