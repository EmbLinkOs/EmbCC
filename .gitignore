# build output
/build/
*.o
*.a
*.elf
# root-built tool binaries (anchored, so the sources — e.g. tools/embld/embld.c —
# stay tracked; a bare `embld` would ignore the whole tools/embld/ directory)
/embcc
/embread
/embld
/embdbg
/embas
/embls
/embcc-stage1
/embcc-stage2

# test scratch
/tests/**/out/
*.log
*.tmp

# editor / tooling
compile_commands.json
.cache/
*.swp
.DS_Store
ref/

# Debug bundles the macOS toolchain leaves beside each -g binary.
*.dSYM/
