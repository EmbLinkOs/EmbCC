# build output
/build/
*.o
*.a
*.elf
# root-built tool binaries (anchored, so the sources — e.g. tools/embld/embld.c —
# stay tracked; a bare `embld` would ignore the whole tools/embld/ directory)
/embcc
/embread
/embld
/embdbg
/embas
/embls
/embidx
/embcc-stage1
/embcc-stage2

# test scratch
/tests/**/out/
*.log

# Linux kernels for tests/harness/linux — ten megabytes of somebody else's
# build, fetched rather than committed. tests/harness/linux/run.sh says
# where to get one, and skips when there is none.
/tests/harness/linux/vmlinuz-*
*.tmp

# editor / tooling
compile_commands.json
.cache/
*.swp
.DS_Store
ref/

# Debug bundles the macOS toolchain leaves beside each -g binary.
*.dSYM/
